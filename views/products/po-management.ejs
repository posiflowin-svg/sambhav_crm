        // Add PO item (updated with price field)
        function addPOItem() {
            const container = document.getElementById('po-items-container');
            const firstItem = container.querySelector('.po-item');
            const newItem = firstItem.cloneNode(true);
            
            // Clear values
            const select = newItem.querySelector('.product-select');
            if (select) select.value = '';
            
            const quantity = newItem.querySelector('.quantity-input');
            if (quantity) quantity.value = '';
            
            const price = newItem.querySelector('.price-input');
            if (price) price.value = '';
            
            container.appendChild(newItem);
        }

        // Update price field when product is selected
        function updatePriceField(selectElement) {
            const selectedOption = selectElement.options[selectElement.selectedIndex];
            const defaultPrice = selectedOption.getAttribute('data-price') || 0;
            const priceInput = selectElement.closest('.po-item').querySelector('.price-input');
            if (priceInput && !priceInput.value) {
                priceInput.value = defaultPrice;
                updateSubtotal(priceInput);
            }
        }

        // Update subtotal and order total
        function updateSubtotal(element) {
            const poItem = element.closest('.po-item');
            const quantity = parseFloat(poItem.querySelector('.quantity-input').value) || 0;
            const price = parseFloat(poItem.querySelector('.price-input').value) || 0;
            const subtotal = quantity * price;
            
            const subtotalDisplay = poItem.querySelector('.subtotal-display');
            if (subtotalDisplay) {
                subtotalDisplay.textContent = subtotal.toFixed(2);
            }
            
            // Update overall order total
            updateOrderTotal();
        }

        // Update order total
        function updateOrderTotal() {
            const subtotals = document.querySelectorAll('.subtotal-display');
            let total = 0;
            subtotals.forEach(subtotal => {
                total += parseFloat(subtotal.textContent) || 0;
            });
            
            const orderTotalSpan = document.getElementById('order-total');
            if (orderTotalSpan) {
                orderTotalSpan.textContent = total.toFixed(2);
            }
        }

        // Remove PO item
        function removePOItem(button) {
            const container = document.getElementById('po-items-container');
            if (container.children.length > 1) {
                button.closest('.po-item').remove();
            } else {
                showError('At least one item is required');
            }
        }

        // Submit create PO (updated with price)
        async function submitCreatePO() {
            const items = [];
            const itemElements = document.querySelectorAll('.po-item');
            
            for (const element of itemElements) {
                const productId = element.querySelector('.product-select').value;
                const quantity = element.querySelector('.quantity-input').value;
                const pricePerUnit = element.querySelector('.price-input').value;
                
                if (!productId || !quantity || !pricePerUnit) {
                    showError('Please fill all item fields (product, quantity, and price per unit)');
                    return;
                }
                
                items.push({
                    product: productId,
                    quantity: parseInt(quantity),
                    pricePerUnit: parseFloat(pricePerUnit)
                });
            }

            const poData = {
                items,
                supplier: {
                    name: document.getElementById('supplier-name').value,
                    contact: document.getElementById('supplier-contact').value
                },
                expectedDelivery: document.getElementById('expected-delivery').value || null,
                notes: document.getElementById('po-notes').value
            };

            try {
                const response = await fetch(`${API_BASE}/pos`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(poData)
                });

                const data = await response.json();

                if (data.success) {
                    showSuccess('Purchase Order created successfully');
                    closeModal();
                    loadPOs(1);
                    loadDashboardStats();
                } else {
                    showError(data.message || 'Failed to create PO');
                }
            } catch (error) {
                showError('Error creating PO: ' + error.message);
            }
        }

