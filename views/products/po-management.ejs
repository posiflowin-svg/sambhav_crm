<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StockMaster</title>
    <!-- Production CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        .nav-link {
            color: #4a5568;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link:hover {
            background-color: #f7fafc;
            color: #2d3748;
            transform: translateY(-1px);
        }

        .nav-link.logout:hover {
            background-color: #fff5f5;
            color: #c53030;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-pending { background-color: #fef3c7; color: #92400e; }
        .status-ordered { background-color: #dbeafe; color: #1e40af; }
        .status-shipped { background-color: #c7d2fe; color: #3730a3; }
        .status-delivered { background-color: #d1fae5; color: #065f46; }
        .status-cancelled { background-color: #fee2e2; color: #991b1b; }
        .status-partially_delivered { background-color: #fff3cd; color: #856404; }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <i class="fas fa-boxes text-blue-600 text-2xl mr-2"></i>
                        <span class="text-xl font-bold text-gray-800">StockMaster</span>
                    </div>
                    <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                        <a href="/products" class="nav-link">Products</a>
                        <a href="/products/transactions" class="nav-link">Transactions</a>
                        <a href="/api/po" class="nav-link border-blue-500">Purchase Orders</a>
        <a href="/dashboard/stock_manager/import-receiving" class="nav-link">Import Receiving</a>
        <a href="/dashboard/stock_manager/product-mapping" class="nav-link">Product Mapping</a>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <% if (user && user.role === 'admin') { %>
                    <a href="/admin/reports" class="nav-link logout">
                        <i class="fas fa-chart-bar"></i>
                        Back To Admin
                    </a>
                    <% } %>
                    
                    <% if (user) { %>
                    <a href="/auth/logout" class="nav-link logout">
                        <i class="fas fa-sign-out-alt"></i>
                        Logout
                    </a>
                    <% } else { %>
                    <a href="/auth/login" class="nav-link login">
                        <i class="fas fa-sign-in-alt"></i>
                        Login
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Dashboard Stats -->
        <div id="dashboard-stats" class="mb-8">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                <div class="bg-white overflow-hidden shadow rounded-lg">
                    <div class="p-5">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-shopping-cart text-blue-500 text-2xl"></i>
                            </div>
                            <div class="ml-5 w-0 flex-1">
                                <dl>
                                    <dt class="text-sm font-medium text-gray-500 truncate">Loading...</dt>
                                    <dd class="text-lg font-medium text-gray-900">--</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters and Actions -->
        <div class="bg-white shadow rounded-lg p-6 mb-6">
            <div class="flex flex-col space-y-4">
                <!-- First Row: Search and Actions -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div class="flex-1">
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-search text-gray-400"></i>
                            </div>
                            <input type="text" id="search-input" placeholder="Search by PO number or supplier..."
                                class="pl-10 pr-4 py-2 border border-gray-300 rounded-md w-full focus:ring-blue-500 focus:border-blue-500">
                        </div>
                    </div>
                    <div class="flex space-x-3">
                        <button onclick="openCreatePOModal()" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">
                            <i class="fas fa-plus mr-2"></i>New Purchase Invoice
                        </button>
                        <!-- <button onclick="openCreateProductPOModal()" class="bg-purple-600 text-white px-4 py-2 rounded-md hover:bg-purple-700">
                            <i class="fas fa-box mr-2"></i>Create Product + PO
                        </button> -->
                    </div>
                </div>

                <!-- Second Row: Date Filters and Status -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">From Date</label>
                            <input type="date" id="start-date" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">To Date</label>
                            <input type="date" id="end-date" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                        </div>
                    </div>
                    <div class="sm:w-64">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select id="status-filter" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                            <option value="all">All Status</option>
                            <option value="pending">Pending</option>
                            <option value="ordered">Ordered</option>
                            <option value="shipped">Shipped</option>
                            <option value="partially_delivered">Partially Delivered</option>
                            <option value="delivered">Delivered</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="flex items-end space-x-2">
                        <button onclick="loadPOs(1)" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
                            <i class="fas fa-filter mr-2"></i>Apply Filters
                        </button>
                        <button onclick="exportToExcel()" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">
                            <i class="fas fa-file-excel mr-2"></i>Export Excel
                        </button>
                        <button onclick="resetFilters()" class="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600">
                            <i class="fas fa-undo mr-2"></i>Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div id="content-area">
            <!-- PO List will be loaded here -->
            <div class="text-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
                <p class="mt-4 text-gray-600">Loading purchase orders...</p>
            </div>
        </div>
    </div>

    <!-- Modals Container -->
    <div id="modals-container"></div>

    <!-- JavaScript -->
    <script>
        const API_BASE = '/api/po/api';
        let currentPage = 1;

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadDashboardStats();
            loadPOs();
        });

        // Load dashboard statistics
        async function loadDashboardStats() {
            try {
                const response = await fetch(`${API_BASE}/pos?limit=1`);
                const data = await response.json();
                
                if (data.success) {
                    const stats = data.stats;
                    const statsHtml = `
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-shopping-cart text-blue-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Total Orders</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.totalOrders || 0}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-clock text-yellow-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Pending</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.pendingOrders || 0}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-truck text-orange-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Partial</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.partialOrders || 0}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-check-circle text-green-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Delivered</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.deliveredOrders || 0}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    document.querySelector('#dashboard-stats .grid').innerHTML = statsHtml;
                }
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        }

        // Load POs
        async function loadPOs(page = 1) {
            currentPage = page;
            
            const search = document.getElementById('search-input').value;
            const startDate = document.getElementById('start-date').value;
            const endDate = document.getElementById('end-date').value;
            const status = document.getElementById('status-filter').value;
            
            const queryParams = new URLSearchParams({
                page: currentPage,
                limit: 10,
                ...(search && { search }),
                ...(startDate && { startDate }),
                ...(endDate && { endDate }),
                ...(status && status !== 'all' && { status })
            });
            
            try {
                const response = await fetch(`${API_BASE}/pos?${queryParams}`);
                const data = await response.json();
                
                if (data.success) {
                    renderPOs(data.data, data.pagination);
                } else {
                    showError(data.message || 'Failed to load POs');
                }
            } catch (error) {
                console.error('Error loading POs:', error);
                showError('Failed to load POs');
            }
        }

        // Render POs
        function renderPOs(pos, pagination) {
            let html = `
                <div class="bg-white shadow-md rounded-lg overflow-hidden">
                    <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
                        <h2 class="text-xl font-semibold text-gray-800">Purchase Orders</h2>
                        <div class="text-sm text-gray-600">
                            Showing ${pos.length} of ${pagination.total} orders
                        </div>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">PO Number</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order Date</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Supplier</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Items</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expected</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
            `;
            
            if (pos.length === 0) {
                html += `
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-file-invoice text-3xl mb-3 text-gray-300"></i>
                            <p>No purchase orders found</p>
                        </td>
                    </tr>
                `;
            } else {
                pos.forEach(po => {
                    const totalItems = po.items.length;
                    const receivedItems = po.items.filter(i => i.receivedQuantity > 0).length;
                    
                    html += `
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">${po.orderNumber}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">${new Date(po.orderDate).toLocaleDateString()}</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900">${po.supplier?.name || 'N/A'}</div>
                                ${po.supplier?.contact ? `<div class="text-xs text-gray-500">${po.supplier.contact}</div>` : ''}
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900">${totalItems} item(s)</div>
                                ${po.status === 'partially_delivered' ? 
                                    `<div class="text-xs text-gray-500">${receivedItems} received</div>` : ''}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="status-badge status-${po.status}">
                                    ${po.status.replace('_', ' ')}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">
                                    ${po.expectedDelivery ? new Date(po.expectedDelivery).toLocaleDateString() : 'N/A'}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button onclick="viewPO('${po._id}')" class="text-blue-600 hover:text-blue-900 mr-3" title="View">
                                    <i class="fas fa-eye"></i>
                                </button>
                                ${['pending', 'ordered', 'shipped', 'partially_delivered'].includes(po.status) ? `
                                    <button onclick="editPO('${po._id}')" class="text-yellow-600 hover:text-yellow-900 mr-3" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button onclick="openReceiveModal('${po._id}')" class="text-green-600 hover:text-green-900 mr-3" title="Receive Items">
                                        <i class="fas fa-truck-loading"></i>
                                    </button>
                                ` : ''}
                            </td>
                        </tr>
                    `;
                });
            }
            
            html += `
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Pagination -->
                    ${renderPagination(pagination)}
                </div>
            `;
            
            document.getElementById('content-area').innerHTML = html;
        }

        // Render pagination
        function renderPagination(pagination) {
            if (pagination.pages <= 1) return '';
            
            let html = `
                <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                    <div class="flex-1 flex justify-between sm:hidden">
                        ${pagination.page > 1 ? `
                            <button onclick="loadPOs(${pagination.page - 1})" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                Previous
                            </button>
                        ` : ''}
                        ${pagination.page < pagination.pages ? `
                            <button onclick="loadPOs(${pagination.page + 1})" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                Next
                            </button>
                        ` : ''}
                    </div>
                    <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                        <div>
                            <p class="text-sm text-gray-700">
                                Showing <span class="font-medium">${(pagination.page - 1) * pagination.limit + 1}</span>
                                to <span class="font-medium">${Math.min(pagination.page * pagination.limit, pagination.total)}</span>
                                of <span class="font-medium">${pagination.total}</span> results
                            </p>
                        </div>
                        <div>
                            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
            `;
            
            for (let i = 1; i <= pagination.pages; i++) {
                if (i === pagination.page) {
                    html += `
                        <span class="z-10 bg-blue-50 border-blue-500 text-blue-600 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            ${i}
                        </span>
                    `;
                } else {
                    html += `
                        <button onclick="loadPOs(${i})" class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            ${i}
                        </button>
                    `;
                }
            }
            
            html += `
                            </nav>
                        </div>
                    </div>
                </div>
            `;
            
            return html;
        }

        // Reset filters
        function resetFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('start-date').value = '';
            document.getElementById('end-date').value = '';
            document.getElementById('status-filter').value = 'all';
            loadPOs(1);
        }

        // View PO
        async function viewPO(id) {
            try {
                const response = await fetch(`${API_BASE}/pos/${id}`);
                const data = await response.json();
                
                if (data.success) {
                    showPODetails(data.data);
                }
            } catch (error) {
                showError('Failed to load PO details');
            }
        }

        // Open Create PO Modal
        async function openCreatePOModal() {
            try {
                const response = await fetch(`${API_BASE}/products`);
                const data = await response.json();
                
                if (data.success) {
                    showCreatePOModal(data.data);
                }
            } catch (error) {
                showError('Failed to load products');
            }
        }

        // Show Create PO Modal (updated with price field)
        function showCreatePOModal(products) {
            let productsOptions = '<option value="">Select Product</option>';
            products.forEach(product => {
                productsOptions += `<option value="${product._id}" data-unit="${product.unit}" data-price="${product.unitPrice || 0}">${product.itemName} (${product.stockQuantity} ${product.unit})</option>`;
            });

            const modalHtml = `
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity z-50"></div>
                <div class="fixed inset-0 z-50 overflow-y-auto">
                    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-5xl">
                            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <div class="flex justify-between items-start mb-4">
                                    <h3 class="text-lg font-medium leading-6 text-gray-900">Create New Purchase Order</h3>
                                    <button onclick="closeModal()" class="text-gray-400 hover:text-gray-500">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <form id="create-po-form">
                                    <div class="space-y-4">
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700">Supplier Name *</label>
                                                <input type="text" id="supplier-name" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700">Supplier Contact</label>
                                                <input type="text" id="supplier-contact" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                            </div>
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Expected Delivery</label>
                                            <input type="date" id="expected-delivery" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Notes</label>
                                            <textarea id="po-notes" rows="2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"></textarea>
                                        </div>

                                        <div>
                                            <div class="flex justify-between items-center mb-2">
                                                <label class="block text-sm font-medium text-gray-700">
                                                    Items *
                                                </label>

                                                <button 
                                                    type="button"
                                                    onclick="addPOItem()"
                                                    class="text-sm bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700"
                                                >
                                                    <i class="fas fa-plus mr-1"></i>
                                                    Add Item
                                                </button>
                                            </div>

                                            <!-- Scroll Wrapper -->
                                            <div class="overflow-x-auto">
                                                
                                                <!-- Container -->
                                                <div id="po-items-container" class="space-y-2 min-w-[900px]">

                                                    <!-- Item Row -->
                                                    <div class="po-item flex gap-2 items-start border rounded-lg p-2 bg-gray-50">

                                                        <!-- Product -->
                                                        <div class="flex-1 min-w-[280px]">
                                                            <select
                                                                class="product-select w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"
                                                                required
                                                                onchange="updatePriceField(this)"
                                                            >
                                                                ${productsOptions}
                                                            </select>
                                                        </div>

                                                        <!-- Quantity -->
                                                        <div class="w-24 flex-shrink-0">
                                                            <input
                                                                type="number"
                                                                class="quantity-input w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"
                                                                placeholder="Qty"
                                                                min="1"
                                                                required
                                                                onchange="updateSubtotal(this)"
                                                            >
                                                        </div>

                                                        <!-- Price -->
                                                        <div class="w-32 flex-shrink-0">
                                                            <input
                                                                type="number"
