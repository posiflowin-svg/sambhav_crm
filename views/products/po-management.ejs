        // Submit Create Product + PO
        async function submitCreateProductPO() {
            const productData = {
                itemCode: document.getElementById('new-item-code').value,
                itemName: document.getElementById('new-item-name').value,
                description: document.getElementById('new-description').value,
                category: document.getElementById('new-category').value,
                location: document.getElementById('new-location').value,
                unit: document.getElementById('new-unit').value,
                minimumStock: parseInt(document.getElementById('new-min-stock').value) || 0,
                maximumStock: document.getElementById('new-max-stock').value ? parseInt(document.getElementById('new-max-stock').value) : null
            };

            const poData = {
                quantity: parseInt(document.getElementById('po-quantity').value),
                supplier: {
                    name: document.getElementById('po-supplier-name').value,
                    contact: document.getElementById('po-supplier-contact').value
                },
                expectedDelivery: document.getElementById('po-expected-delivery').value || null,
                notes: document.getElementById('po-notes').value
            };

            // Validate
            for (let [key, value] of Object.entries(productData)) {
                if (['itemCode', 'itemName', 'category', 'location', 'unit'].includes(key) && !value) {
                    showError(`Please fill ${key} field`);
                    return;
                }
            }

            if (!poData.quantity) {
                showError('Please enter order quantity');
                return;
            }

            if (!poData.supplier.name) {
                showError('Please enter supplier name');
                return;
            }

            try {
                const response = await fetch(`${API_BASE}/product-and-po`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        product: productData,
                        po: poData
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showSuccess('Product and PO created successfully');
                    closeModal();
                    loadPOs(1);
                    loadDashboardStats();
                } else {
                    showError(data.message || 'Failed to create product and PO');
                }
            } catch (error) {
                showError('Error: ' + error.message);
            }
        }

