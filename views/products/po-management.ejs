        // Submit Receive
        async function submitReceive(poId) {
            const items = [];
            const itemElements = document.querySelectorAll('.receive-item');
            
            for (const element of itemElements) {
                const itemId = element.querySelector('.item-id').value;
                const quantity = element.querySelector('.receive-quantity').value;
                const notes = element.querySelector('.receive-notes').value;
                
                if (quantity) {
                    items.push({
                        itemId,
                        quantity: parseInt(quantity),
                        notes
                    });
                }
            }

            if (items.length === 0) {
                showError('Please enter at least one quantity to receive');
                return;
            }

            try {
                const response = await fetch(`${API_BASE}/pos/${poId}/receive`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ items })
                });

                const data = await response.json();

                if (data.success) {
                    showSuccess('Items received successfully');
                    closeModal();
                    loadPOs(currentPage);
                    loadDashboardStats();
                } else {
                    showError(data.message || 'Failed to receive items');
                }
            } catch (error) {
                showError('Error receiving items: ' + error.message);
            }
        }

