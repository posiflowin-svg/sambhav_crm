                            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <div class="flex justify-between items-start mb-4">
                                    <h3 class="text-lg font-medium leading-6 text-gray-900">Edit Purchase Order - ${po.orderNumber}</h3>
                                    <button onclick="closeModal()" class="text-gray-400 hover:text-gray-500">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <form id="edit-po-form">
                                    <div class="space-y-4">
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700">Supplier Name *</label>
                                                <input type="text" id="edit-supplier-name" value="${po.supplier?.name || ''}" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700">Supplier Contact</label>
                                                <input type="text" id="edit-supplier-contact" value="${po.supplier?.contact || ''}" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                            </div>
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Expected Delivery</label>
                                            <input type="date" id="edit-expected-delivery" value="${po.expectedDelivery ? new Date(po.expectedDelivery).toISOString().split('T')[0] : ''}" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Status</label>
                                            <select id="edit-status" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                                <option value="pending" ${po.status === 'pending' ? 'selected' : ''}>Pending</option>
                                                <option value="ordered" ${po.status === 'ordered' ? 'selected' : ''}>Ordered</option>
                                                <option value="shipped" ${po.status === 'shipped' ? 'selected' : ''}>Shipped</option>
                                                <option value="cancelled" ${po.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
                                            </select>
                                            <p class="text-xs text-gray-500 mt-1">Note: Delivered status cannot be changed here</p>
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Notes</label>
                                            <textarea id="edit-notes" rows="2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">${po.notes || ''}</textarea>
                                        </div>

                                        <div>
                                            <div class="flex justify-between items-center mb-2">
                                                <label class="block text-sm font-medium text-gray-700">Items *</label>
                                                <button type="button" onclick="addPOItem()" class="text-sm bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700">
                                                    <i class="fas fa-plus mr-1"></i>Add Item
                                                </button>
                                            </div>
                                            <div id="po-items-container" class="space-y-2">
                                                ${itemsHtml}
                                            </div>
                                            <p class="text-xs text-gray-500 mt-1">Note: Received quantities cannot be edited here</p>
                                        </div>
                                        
                                        <div class="bg-gray-50 p-4 rounded-lg">
                                            <div class="flex justify-between items-center">
                                                <span class="font-medium text-gray-700">Order Total:</span>
                                                <span id="order-total" class="text-xl font-bold text-blue-600">${calculateOrderTotal(po.items).toFixed(2)}</span>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                                <button type="button" onclick="submitEditPO('${po._id}')" class="inline-flex w-full justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-base font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm">
                                    Update PO
                                </button>
                                <button type="button" onclick="closeModal()" class="mt-3 inline-flex w-full justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('modals-container').innerHTML = modalHtml;
            
            // Attach event listeners for subtotal calculations after modal is rendered
            attachSubtotalListeners();
        }

        // Calculate order total from items
        function calculateOrderTotal(items) {
            return items.reduce((total, item) => {
                const pricePerUnit = item.pricePerUnit || 0;
                return total + (pricePerUnit * item.quantity);
            }, 0);
        }

        // Attach listeners for subtotal calculation
        function attachSubtotalListeners() {
            const quantityInputs = document.querySelectorAll('.quantity-input');
            const priceInputs = document.querySelectorAll('.price-input');
            
            quantityInputs.forEach(input => {
                input.addEventListener('change', () => updateSubtotal(input));
            });
            
            priceInputs.forEach(input => {
                input.addEventListener('change', () => updateSubtotal(input));
            });
        }

        // Submit Edit PO (updated with price)
        async function submitEditPO(poId) {
            const items = [];
            const itemElements = document.querySelectorAll('.po-item');
            
            for (const element of itemElements) {
                const productId = element.querySelector('.product-select').value;
                const quantity = element.querySelector('.quantity-input').value;
                const pricePerUnit = element.querySelector('.price-input').value;
                
                if (!productId || !quantity || !pricePerUnit) {
                    showError('Please fill all item fields (product, quantity, and price per unit)');
                    return;
                }
                
                items.push({
                    product: productId,
                    quantity: parseInt(quantity),
                    pricePerUnit: parseFloat(pricePerUnit)
                });
            }

            const poData = {
                items,
                supplier: {
                    name: document.getElementById('edit-supplier-name').value,
                    contact: document.getElementById('edit-supplier-contact').value
                },
                expectedDelivery: document.getElementById('edit-expected-delivery').value || null,
                status: document.getElementById('edit-status').value,
                notes: document.getElementById('edit-notes').value
            };

            try {
                const response = await fetch(`${API_BASE}/pos/${poId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(poData)
                });

                const data = await response.json();

                if (data.success) {
                    showSuccess('Purchase Order updated successfully');
                    closeModal();
                    loadPOs(currentPage);
                } else {
                    showError(data.message || 'Failed to update PO');
                }
            } catch (error) {
                showError('Error updating PO: ' + error.message);
            }
        }

        function showPODetails(po) {
            let itemsHtml = '';
            po.items.forEach(item => {
                const product = item.product;
                const pricePerUnit = item.pricePerUnit || 0;
                const subtotal = pricePerUnit * item.quantity;
                const receivedValue = pricePerUnit * (item.receivedQuantity || 0);
                
                itemsHtml += `
                    <tr>
                        <td class="px-4 py-2">${product?.itemCode || 'N/A'}</td>
                        <td class="px-4 py-2">${product?.itemName || 'N/A'}</td>
                        <td class="px-4 py-2 text-right">${item.quantity}</td>
                        <td class="px-4 py-2 text-right">${item.receivedQuantity}</td>
                        <td class="px-4 py-2 text-right">${item.quantity - item.receivedQuantity}</td>
                        <td class="px-4 py-2 text-right">${pricePerUnit.toFixed(2)}</td>
                        <td class="px-4 py-2 text-right">${subtotal.toFixed(2)}</td>
                        <td class="px-4 py-2">${item.unit}</td>
                    </tr>
                `;
            });

            const totalCost = calculateOrderTotal(po.items);
            const receivedValue = po.items.reduce((total, item) => {
                return total + ((item.pricePerUnit || 0) * (item.receivedQuantity || 0));
            }, 0);
            
            const modalHtml = `
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity z-50"></div>
                <div class="fixed inset-0 z-50 overflow-y-auto">
                    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-5xl">
                            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <div class="flex justify-between items-start mb-4">
                                    <h3 class="text-lg font-medium leading-6 text-gray-900">Purchase Order Details</h3>
                                    <button onclick="closeModal()" class="text-gray-400 hover:text-gray-500">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <div class="grid grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <p class="text-sm text-gray-500">PO Number</p>
                                        <p class="font-medium">${po.orderNumber}</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Status</p>
                                        <span class="status-badge status-${po.status}">${po.status.replace('_', ' ')}</span>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Order Date</p>
                                        <p>${new Date(po.orderDate).toLocaleDateString()}</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Expected Delivery</p>
                                        <p>${po.expectedDelivery ? new Date(po.expectedDelivery).toLocaleDateString() : 'N/A'}</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Supplier</p>
                                        <p class="font-medium">${po.supplier?.name || 'N/A'}</p>
                                        ${po.supplier?.contact ? `<p class="text-sm">${po.supplier.contact}</p>` : ''}
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Created By</p>
                                        <p>${po.createdBy?.username || 'N/A'}</p>
                                    </div>
                                </div>

                                <div class="grid grid-cols-3 gap-4 mb-4 bg-gray-50 p-3 rounded">
                                    <div>
                                        <p class="text-sm text-gray-500">Total Order Value</p>
                                        <p class="font-bold text-blue-600">${totalCost.toFixed(2)}</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Received Value</p>
                                        <p class="font-bold text-green-600">${receivedValue.toFixed(2)}</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">Pending Value</p>
                                        <p class="font-bold text-orange-600">${(totalCost - receivedValue).toFixed(2)}</p>
                                    </div>
                                </div>

                                ${po.notes ? `
                                <div class="mb-4">
                                    <p class="text-sm text-gray-500">Notes</p>
                                    <p class="bg-gray-50 p-2 rounded">${po.notes}</p>
                                </div>
                                ` : ''}

                                <h4 class="font-medium mb-2">Items</h4>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Item Code</th>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Item Name</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Ordered</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Received</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Remaining</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Price/Unit</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Subtotal</th>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Unit</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-gray-200">
                                            ${itemsHtml}
                                        </tbody>
                                    </table>
                                </div>

                                ${po.items.some(i => i.receivedHistory.length > 0) ? `
                                <h4 class="font-medium mt-4 mb-2">Receiving History</h4>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Date</th>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Item</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Quantity</th>
                                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Value</th>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-gray-200">
                                            ${po.items.flatMap(item => 
                                                item.receivedHistory.map(history => `
                                                    <tr>
                                                        <td class="px-4 py-2">${new Date(history.receivedDate).toLocaleString()}</td>
                                                        <td class="px-4 py-2">${item.product?.itemCode || 'N/A'}</td>
                                                        <td class="px-4 py-2 text-right">${history.quantity}</td>
                                                        <td class="px-4 py-2 text-right">${((item.pricePerUnit || 0) * history.quantity).toFixed(2)}</td>
                                                        <td class="px-4 py-2">${history.notes || ''}</td>
                                                    </tr>
                                                `)
                                            ).join('')}
                                        </tbody>
                                    </table>
                                </div>
                                ` : ''}
                            </div>
                            <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                                <button type="button" onclick="closeModal()" class="mt-3 inline-flex w-full justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('modals-container').innerHTML = modalHtml;
        }
    </script>
</body>
</html>