<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StockMaster</title>
        <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <i class="fas fa-boxes text-blue-600 text-2xl mr-2"></i>
                        <span class="text-xl font-bold text-gray-800">StockMaster</span>
                    </div>
                    <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                        <a href="/products" class="nav-link border-transparent text-gray-500 hover:border-gray-300">Products</a>
                        <a href="/products/transactions" class="nav-link border-transparent text-gray-500 hover:border-gray-300">Transactions</a>
                    </div>
                </div>
                <div class="flex items-center">
                    <span class="text-gray-700 mr-4"><%= user.name || 'Admin' %></span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="bg-white shadow rounded-lg p-6">
            <!-- Header -->
            <div class="mb-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">Stock Adjustment</h2>
                        <div class="flex items-center mt-2">
                            <span class="text-gray-600 mr-4">Item:</span>
                            <span class="font-medium text-gray-900"><%= product.itemCode %> - <%= product.itemName %></span>
                        </div>
                        <div class="flex items-center mt-1">
                            <span class="text-gray-600 mr-4">Current Stock:</span>
                            <span class="font-bold text-blue-600">
                                <%= product.stockQuantity.toLocaleString() %> <%= product.unit %>
                            </span>
                        </div>
                    </div>
                    <a href="/products/view/<%= product._id %>" 
                       class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                        <i class="fas fa-arrow-left mr-2"></i>Back to Product
                    </a>
                </div>
            </div>

            <!-- Current Stock Status -->
            <div class="mb-8 p-4 bg-gray-50 rounded-lg">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="text-center">
                        <div class="text-sm text-gray-600">Current Stock</div>
                        <div class="text-2xl font-bold text-blue-600 mt-1">
                            <%= product.stockQuantity.toLocaleString() %>
                        </div>
                        <div class="text-sm text-gray-500"><%= product.unit %></div>
                    </div>
                    
                    <% if (product.minimumStock > 0) { %>
                    <div class="text-center">
                        <div class="text-sm text-gray-600">Minimum Stock</div>
                        <div class="text-xl font-bold text-yellow-600 mt-1">
                            <%= product.minimumStock.toLocaleString() %>
                        </div>
                        <div class="text-sm text-gray-500">Alert Level</div>
                    </div>
                    <% } %>
                    
                    <% if (product.maximumStock) { %>
                    <div class="text-center">
                        <div class="text-sm text-gray-600">Maximum Stock</div>
                        <div class="text-xl font-bold text-purple-600 mt-1">
                            <%= product.maximumStock.toLocaleString() %>
                        </div>
                        <div class="text-sm text-gray-500">Capacity</div>
                    </div>
                    <% } %>
                </div>
                
                <!-- Stock Alert -->
                <% if (product.minimumStock > 0 && product.stockQuantity <= product.minimumStock) { %>
                <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-md">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-triangle text-red-600 mr-3"></i>
                        <div>
                            <h4 class="font-medium text-red-800">Low Stock Alert</h4>
                            <p class="text-sm text-red-600 mt-1">
                                Current stock (<%= product.stockQuantity %>) is at or below minimum level (<%= product.minimumStock %>)
                            </p>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Stock Adjustment Form -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Adjust Stock Quantity</h3>
                
                <form id="adjustment-form" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Operation Type -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Operation Type *
                            </label>
                            <div class="space-y-3">
                                <div class="flex items-center">
                                    <input type="radio" id="stock_in" name="type" value="stock_in" 
                                           class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300" checked>
                                    <label for="stock_in" class="ml-3">
                                        <span class="block text-sm font-medium text-gray-700">Add Stock</span>
                                        <span class="block text-sm text-gray-500">Increase inventory quantity</span>
                                    </label>
                                </div>
                                <div class="flex items-center">
                                    <input type="radio" id="stock_out" name="type" value="stock_out" 
                                           class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300">
                                    <label for="stock_out" class="ml-3">
                                        <span class="block text-sm font-medium text-gray-700">Remove Stock</span>
                                        <span class="block text-sm text-gray-500">Decrease inventory quantity</span>
                                    </label>
                                </div>
                                <div class="flex items-center">
                                    <input type="radio" id="adjustment" name="type" value="adjustment" 
                                           class="h-4 w-4 text-yellow-600 focus:ring-yellow-500 border-gray-300">
                                    <label for="adjustment" class="ml-3">
                                        <span class="block text-sm font-medium text-gray-700">Correction</span>
                                        <span class="block text-sm text-gray-500">Adjust to specific quantity</span>
                                    </label>
                                </div>
                                <div class="flex items-center">
                                    <input type="radio" id="damage" name="type" value="damage" 
                                           class="h-4 w-4 text-gray-600 focus:ring-gray-500 border-gray-300">
                                    <label for="damage" class="ml-3">
                                        <span class="block text-sm font-medium text-gray-700">Damage</span>
                                        <span class="block text-sm text-gray-500">Record damaged/wasted items</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Quantity Input -->
                        <div id="quantity-section">
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Quantity *
                            </label>
                            <input type="number" id="quantity" required min="1" step="0.01"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Enter quantity">
                            <div class="mt-1 text-sm text-gray-500">
                                Enter quantity to <%= product.unit %>
                            </div>
                            
                            <!-- For Adjustment Type -->
                            <div id="adjustment-details" class="mt-4 hidden">
                                <div class="p-3 bg-blue-50 rounded-md">
                                    <div class="text-sm text-blue-800 mb-2">Adjustment Details:</div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-xs text-gray-600">Current Stock</div>
                                            <div class="font-medium"><%= product.stockQuantity %> <%= product.unit %></div>
                                        </div>
                                        <div>
                                            <div class="text-xs text-gray-600">New Stock</div>
                                            <div id="new-stock" class="font-medium text-blue-600">--</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reference and Description -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Reference (Optional)
                            </label>
                            <input type="text" id="reference" 
                                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="e.g., Invoice #, PO #, etc.">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Description
                            </label>
                            <textarea id="description" rows="3" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
                                      placeholder="Reason for stock adjustment..."></textarea>
                        </div>
                    </div>

                    <!-- Preview Section -->
                    <div id="preview-section" class="hidden">
                        <div class="p-4 bg-gray-50 rounded-lg">
                            <h4 class="font-medium text-gray-800 mb-3">Adjustment Preview</h4>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="text-center p-3 bg-white rounded border">
                                    <div class="text-sm text-gray-600">Current</div>
                                    <div id="preview-current" class="text-xl font-bold text-gray-800 mt-1">
                                        <%= product.stockQuantity.toLocaleString() %>
                                    </div>
                                </div>
                                <div class="text-center p-3 bg-white rounded border">
                                    <div id="preview-operation" class="text-sm text-gray-600">Operation</div>
                                    <div id="preview-quantity" class="text-xl font-bold text-green-600 mt-1">
                                        +0
                                    </div>
                                </div>
                                <div class="text-center p-3 bg-white rounded border">
                                    <div class="text-sm text-gray-600">New Stock</div>
                                    <div id="preview-new" class="text-xl font-bold text-blue-600 mt-1">
                                        <%= product.stockQuantity.toLocaleString() %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="flex justify-end space-x-3 pt-6 border-t">
                        <a href="/products/view/<%= product._id %>" 
                           class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                            Cancel
                        </a>
                        <button type="button" onclick="previewAdjustment()" 
                                class="px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700">
                            Preview
                        </button>
                        <button type="submit" id="submit-btn" 
                                class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-check-circle mr-2"></i>Apply Adjustment
                        </button>
                    </div>
                </form>
            </div>

            <!-- Recent Adjustments -->
            <div class="mt-10">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Adjustments</h3>
                <div id="recent-transactions" class="space-y-3">
                    <!-- Will be loaded via JavaScript -->
                    <div class="text-center py-8">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
                        <p class="mt-4 text-gray-600">Loading recent transactions...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const productId = '<%= product._id %>';
        const currentStock = <%= product.stockQuantity %>;
        const unit = '<%= product.unit %>';
        
        // Update preview when quantity changes
        document.getElementById('quantity').addEventListener('input', updatePreview);
        document.querySelectorAll('input[name="type"]').forEach(radio => {
            radio.addEventListener('change', updatePreview);
        });
        
        function updatePreview() {
            const quantity = parseFloat(document.getElementById('quantity').value) || 0;
            const type = document.querySelector('input[name="type"]:checked').value;
            
            if (quantity > 0) {
                document.getElementById('preview-section').classList.remove('hidden');
                
                let operationText = '';
                let operationClass = '';
                let newStock = currentStock;
                
                switch(type) {
                    case 'stock_in':
                        operationText = `Add ${quantity} ${unit}`;
                        operationClass = 'text-green-600';
                        newStock = currentStock + quantity;
                        break;
                    case 'stock_out':
                        operationText = `Remove ${quantity} ${unit}`;
                        operationClass = 'text-red-600';
                        newStock = currentStock - quantity;
                        break;
                    case 'adjustment':
                        operationText = `Set to ${quantity} ${unit}`;
                        operationClass = 'text-yellow-600';
                        newStock = quantity;
                        break;
                    case 'damage':
                        operationText = `Damage ${quantity} ${unit}`;
                        operationClass = 'text-gray-600';
                        newStock = currentStock - quantity;
                        break;
                }
                
                // Update preview values
                document.getElementById('preview-current').textContent = currentStock.toLocaleString();
                document.getElementById('preview-operation').textContent = operationText;
                document.getElementById('preview-quantity').textContent = type === 'adjustment' 
                    ? `Set ${quantity.toLocaleString()}`
                    : `${type === 'stock_in' || type === 'adjustment' ? '+' : '-'}${quantity.toLocaleString()}`;
                document.getElementById('preview-quantity').className = `text-xl font-bold ${operationClass} mt-1`;
                document.getElementById('preview-new').textContent = newStock.toLocaleString();
                
                // Update adjustment details if type is adjustment
                if (type === 'adjustment') {
                    document.getElementById('adjustment-details').classList.remove('hidden');
                    document.getElementById('new-stock').textContent = `${quantity.toLocaleString()} ${unit}`;
                } else {
                    document.getElementById('adjustment-details').classList.add('hidden');
                }
                
                // Enable/disable submit button based on validity
                const submitBtn = document.getElementById('submit-btn');
                const isValid = quantity > 0 && (type !== 'stock_out' && type !== 'damage' || newStock >= 0);
                submitBtn.disabled = !isValid;
            } else {
                document.getElementById('preview-section').classList.add('hidden');
                document.getElementById('submit-btn').disabled = true;
            }
        }
        
        function previewAdjustment() {
            const quantity = parseFloat(document.getElementById('quantity').value);
            const type = document.querySelector('input[name="type"]:checked').value;
            
            if (!quantity || quantity <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Quantity',
                    text: 'Please enter a valid quantity'
                });
                return;
            }
            
            updatePreview();
            document.getElementById('preview-section').scrollIntoView({ behavior: 'smooth' });
        }
        
        // Form submission
        document.getElementById('adjustment-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const quantity = parseFloat(document.getElementById('quantity').value);
            const type = document.querySelector('input[name="type"]:checked').value;
            const reference = document.getElementById('reference').value;
            const description = document.getElementById('description').value;
            
            // For adjustment type, quantity is the new stock value
            let adjustedQuantity = quantity;
            if (type === 'adjustment') {
                adjustedQuantity = quantity - currentStock;
            } else if (type === 'stock_out' || type === 'damage') {
                adjustedQuantity = -Math.abs(quantity);
            }
            
            // Validate stock doesn't go negative
            const newStock = currentStock + adjustedQuantity;
            if (newStock < 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Insufficient Stock',
                    text: `Cannot remove ${Math.abs(adjustedQuantity)} ${unit}. Available: ${currentStock} ${unit}`
                });
                return;
            }
            
            const result = await Swal.fire({
                title: 'Confirm Adjustment',
                html: `
                    <div class="text-left">
                        <p>Are you sure you want to ${type === 'adjustment' ? 'adjust stock to' : type === 'stock_in' ? 'add' : 'remove'} <strong>${Math.abs(adjustedQuantity)} ${unit}</strong>?</p>
                        <div class="mt-3 p-2 bg-gray-50 rounded">
                            <div class="flex justify-between">
                                <span>Current:</span>
                                <span><strong>${currentStock} ${unit}</strong></span>
                            </div>
                            <div class="flex justify-between mt-1">
                                <span>Change:</span>
                                <span class="${adjustedQuantity >= 0 ? 'text-green-600' : 'text-red-600'}">
                                    <strong>${adjustedQuantity >= 0 ? '+' : ''}${adjustedQuantity} ${unit}</strong>
                                </span>
                            </div>
                            <div class="flex justify-between mt-1 border-t pt-1">
                                <span>New Stock:</span>
                                <span class="text-blue-600"><strong>${newStock} ${unit}</strong></span>
                            </div>
                        </div>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, apply adjustment'
            });
            
            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/products/api/products/${productId}/stock`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            quantity: Math.abs(adjustedQuantity),
                            type: type === 'adjustment' ? (adjustedQuantity >= 0 ? 'stock_in' : 'stock_out') : type,
                            description: description || `${type === 'adjustment' ? 'Stock adjustment to' : type === 'stock_in' ? 'Stock added' : 'Stock removed'}: ${Math.abs(adjustedQuantity)} ${unit}`,
                            reference
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Stock adjustment applied successfully',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        
                        window.location.href = `/products/view/${productId}`;
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message || 'Failed to apply adjustment'
                        });
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error applying adjustment'
                    });
                }
            }
        });
        
        // Load recent transactions
        async function loadRecentTransactions() {
            try {
                const response = await fetch(`/products/api/products/${productId}/transactions?limit=5`);
                const data = await response.json();
                
                if (data.success && data.data.length > 0) {
                    const container = document.getElementById('recent-transactions');
                    let html = '';
                    
                    data.data.forEach(transaction => {
                        const typeColors = {
                            'stock_in': 'bg-green-100 text-green-800',
                            'stock_out': 'bg-red-100 text-red-800',
                            'adjustment': 'bg-yellow-100 text-yellow-800',
                            'damage': 'bg-gray-100 text-gray-800'
                        };
                        
                        const typeLabels = {
                            'stock_in': 'Stock In',
                            'stock_out': 'Stock Out',
                            'adjustment': 'Adjustment',
                            'damage': 'Damage'
                        };
                        
                        const quantityClass = transaction.quantity > 0 ? 'text-green-600' : 'text-red-600';
                        const quantitySign = transaction.quantity > 0 ? '+' : '';
                        
                        html += `
                            <div class="p-3 bg-white border rounded-md hover:bg-gray-50">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <div class="flex items-center">
                                            <span class="px-2 py-1 text-xs font-semibold rounded-full ${typeColors[transaction.type]}">
                                                ${typeLabels[transaction.type]}
                                            </span>
                                            <span class="ml-3 font-medium ${quantityClass}">
                                                ${quantitySign}${transaction.quantity} ${transaction.unit}
                                            </span>
                                        </div>
                                        <div class="mt-1 text-sm text-gray-600">
                                            ${transaction.description || 'No description'}
                                        </div>
                                        <div class="mt-1 text-xs text-gray-500">
                                            ${new Date(transaction.transactionDate).toLocaleString()}
                                            ${transaction.reference ? ` • Ref: ${transaction.reference}` : ''}
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-sm text-gray-500">Stock Change</div>
                                        <div class="text-sm font-medium">
                                            ${transaction.previousStock} → ${transaction.newStock}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    container.innerHTML = html;
                }
            } catch (error) {
                console.error('Error loading recent transactions:', error);
            }
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadRecentTransactions();
            updatePreview();
        });
    </script>

    <style>
        .nav-link {
            border-bottom-width: 2px;
            padding: 8px 0;
            margin-right: 24px;
        }
        
        .nav-link:hover {
            border-bottom-color: #d1d5db;
            color: #374151;
        }
        
        input[type="radio"]:checked + label {
            font-weight: 600;
        }
    </style>
</body>
</html>