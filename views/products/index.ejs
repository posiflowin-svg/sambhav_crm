<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StockMaster</title>
    <!-- Production CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        .nav-link {
            color: #4a5568;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link:hover {
            background-color: #f7fafc;
            color: #2d3748;
            transform: translateY(-1px);
        }

        .nav-link.logout:hover {
            background-color: #fff5f5;
            color: #c53030;
        }

        .nav-link.login:hover {
            background-color: #e6f7ff;
            color: #2563eb;
        }

        .nav-link i {
            font-size: 1.1em;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <i class="fas fa-boxes text-blue-600 text-2xl mr-2"></i>
                        <span class="text-xl font-bold text-gray-800">StockMaster</span>
                    </div>
                    <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                        <a href="/products" class="nav-link border-blue-500 text-gray-900">Products</a>
                        <a href="/products/transactions" class="nav-link border-transparent text-gray-500 hover:border-gray-300">Transactions</a>
                        <a href="/api/po" class="nav-link border-transparent text-gray-500 hover:border-gray-300">Purchase Orders</a>
        <a href="/dashboard/stock_manager/import-receiving" class="nav-link">Import Receiving</a>
        <a href="/dashboard/stock_manager/product-mapping" class="nav-link">Product Mapping</a>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <% if (user.role === 'admin') { %>
                    <a href="/admin/reports" class="nav-link logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Back To Admin
                    </a>
                    <% } %>
                    <a href="/dispatcher/dashboard" class="nav-link">
                        <i class="bi bi-arrow-left"></i>
                        Dispatcher
                    </a>
                    <% if (user) { %>
                    <a href="/auth/logout" class="nav-link logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>
                    <% } else { %>
                    <a href="/auth/login" class="nav-link login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Login
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Dashboard Stats -->
        <div id="dashboard-stats" class="mb-8">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                <!-- Stats will be loaded dynamically -->
                <div class="bg-white overflow-hidden shadow rounded-lg">
                    <div class="p-5">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-box text-blue-500 text-2xl"></i>
                            </div>
                            <div class="ml-5 w-0 flex-1">
                                <dl>
                                    <dt class="text-sm font-medium text-gray-500 truncate">Loading...</dt>
                                    <dd class="text-lg font-medium text-gray-900">--</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters and Actions -->
        <div class="bg-white shadow rounded-lg p-6 mb-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex-1">
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-search text-gray-400"></i>
                        </div>
                        <input type="text" id="search-input" placeholder="Search products by item code, name or description..."
                            class="pl-10 pr-4 py-2 border border-gray-300 rounded-md w-full focus:ring-blue-500 focus:border-blue-500"
                            onkeyup="if(event.keyCode===13) loadProducts()">
                    </div>
                </div>
                <div class="flex space-x-3">
                    <!-- Hidden category input -->
                    <input type="hidden" id="category-filter" value="">
                    
                    <div class="relative">
                        <!-- Category Tabs Container -->
                        <div class="bg-gray-100 rounded-md p-1 flex space-x-1">
                            <button type="button" 
                                    data-category="" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 bg-white text-blue-700 shadow-sm border border-blue-300">
                                All
                            </button>
                            <button type="button" 
                                    data-category="Components" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                Components
                            </button>
                            <button type="button" 
                                    data-category="TFT Display" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                TFT Display
                            </button>
                            <button type="button" 
                                    data-category="Display" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                Display
                            </button>
                            <button type="button" 
                                    data-category="POS" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                POS
                            </button>
                            <button type="button" 
                                    data-category="Printer" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                Printer
                            </button>
                            <!-- <button type="button" 
                                    data-category="Tools" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                Tools
                            </button>
                            <button type="button" 
                                    data-category="Accessories" 
                                    class="category-tab-btn px-3 py-1.5 text-sm font-medium rounded transition-all duration-200 text-gray-700 hover:bg-white hover:text-blue-700 hover:shadow-sm">
                                Accessories
                            </button> -->
                        </div>
                    </div>
                    
                    <div class="relative inline-flex gap-2 flex-wrap">
                        <button type="button" onclick="exportStockExcel('all')" class="bg-emerald-700 text-white px-4 py-2 rounded-md hover:bg-emerald-800">
                            <i class="fas fa-file-excel mr-2"></i>Export All Stock
                        </button>
                        <button type="button" onclick="exportStockExcel('filtered')" class="bg-emerald-50 text-emerald-800 border border-emerald-300 px-4 py-2 rounded-md hover:bg-emerald-100">
                            Export Filtered Stock
                        </button>
                    </div>
                    <button onclick="loadProducts()" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
                        <i class="fas fa-filter mr-2"></i>Filter
                    </button>
                    <button onclick="window.location.href='/products/add'" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">
                        <i class="fas fa-plus mr-2"></i>Add Product
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div id="content-area">
            <!-- Products List will be loaded here -->
            <div class="text-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
                <p class="mt-4 text-gray-600">Loading products...</p>
            </div>
        </div>
    </div>

    <!-- Modals Container -->
    <div id="modals-container"></div>

    <!-- JavaScript -->
    <script>
        // Correct API base path
        const API_BASE = '/products/api';
        let currentPage = 1;
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            setupCategoryTabs(); // Add this line
            loadDashboardStats();
            loadProducts();
        });

        // Setup category tabs functionality - Add this function
        function setupCategoryTabs() {
            const categoryTabs = document.querySelectorAll('.category-tab-btn');
            const categoryInput = document.getElementById('category-filter');
            
            // Function to update active tab
            function setActiveTab(category) {
                categoryTabs.forEach(tab => {
                    const tabCategory = tab.getAttribute('data-category');
                    if (tabCategory === category) {
                        tab.classList.remove('text-gray-700', 'hover:bg-white', 'hover:text-blue-700', 'hover:shadow-sm');
                        tab.classList.add('bg-white', 'text-blue-700', 'shadow-sm', 'border', 'border-blue-300');
                    } else {
                        tab.classList.remove('bg-white', 'text-blue-700', 'shadow-sm', 'border', 'border-blue-300');
                        tab.classList.add('text-gray-700', 'hover:bg-white', 'hover:text-blue-700', 'hover:shadow-sm');
                    }
                });
            }
            
            // Initialize with "All" selected
            setActiveTab('');
            
            // Add click event to each tab
            categoryTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    const category = this.getAttribute('data-category');
                    categoryInput.value = category;
                    setActiveTab(category);
                    loadProducts(1); // Reload products when category changes
                });
            });
        }

        // Load dashboard statistics
        async function loadDashboardStats() {
            try {
                const response = await fetch(`${API_BASE}/dashboard/stats`);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                
                if (data.success) {
                    const stats = data.data;
                    const statsHtml = `
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-box text-blue-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Total Products</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.totalProducts}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-cubes text-green-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Total Stock</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.totalStock.toLocaleString()}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-exclamation-triangle text-yellow-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Low Stock Items</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.lowStockCount}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-tags text-purple-500 text-2xl"></i>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Categories</dt>
                                            <dd class="text-lg font-medium text-gray-900">${stats.categories.length}</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    document.querySelector('#dashboard-stats .grid').innerHTML = statsHtml;
                }
            } catch (error) {
                console.error('Error loading stats:', error);
                // Show error state in dashboard
                document.querySelector('#dashboard-stats .grid').innerHTML = `
                    <div class="col-span-4 p-4 bg-red-50 border border-red-200 rounded-lg">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-triangle text-red-500 mr-3"></i>
                            <div>
                                <h4 class="font-medium text-red-800">Unable to load dashboard stats</h4>
                                <p class="text-sm text-red-600">${error.message}</p>
                            </div>
                        </div>
                    </div>
                `;
            }
        }

        // Export directly from the server so pagination never truncates the workbook.
        function exportStockExcel(scope) {
            const params = new URLSearchParams({ scope });
            if (scope === 'filtered') {
                const search = document.getElementById('search-input').value.trim();
                const category = document.getElementById('category-filter').value;
                if (search) params.set('search', search);
                if (category) params.set('category', category);
            }
            window.location.href = `/products/api/export/stock-excel?${params.toString()}`;
        }

        // Load products
        async function loadProducts(page = 1) {
            currentPage = page;
            
            // Get filters
            const search = document.getElementById('search-input').value;
            const category = document.getElementById('category-filter').value;
            
            // Build query string
            const queryParams = new URLSearchParams({
                page: currentPage,
                limit: 100,
                ...(search && { search }),
                ...(category && { category })
            });
            
            try {
                const response = await fetch(`${API_BASE}/products?${queryParams}`);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                
                if (data.success) {
                    renderProducts(data.data, data.pagination);
                } else {
                    showError(data.message || 'Failed to load products');
                }
            } catch (error) {
                console.error('Error loading products:', error);
                showError('Failed to load products: ' + error.message);
                document.getElementById('content-area').innerHTML = `
                    <div class="bg-white shadow rounded-lg p-8 text-center">
                        <i class="fas fa-exclamation-triangle text-3xl text-red-500 mb-4"></i>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Error Loading Products</h3>
                        <p class="text-gray-600 mb-4">${error.message}</p>
                        <button onclick="loadProducts()" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
                            <i class="fas fa-redo mr-2"></i>Try Again
                        </button>
                    </div>
                `;
            }
        }

        function renderProducts(products, pagination) {
            let html = `
                <div class="bg-white shadow-md rounded-lg overflow-hidden">
                    <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
                        <h2 class="text-xl font-semibold text-gray-800">Products Inventory</h2>
                        <div class="text-sm text-gray-600">
                            Showing ${products.length} of ${pagination.total} products
                        </div>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item Price</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Unit</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
            `;
            
            if (products.length === 0) {
                html += `
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-box text-3xl mb-3 text-gray-300"></i>
                            <p>No products found</p>
                            <p class="text-sm mt-2">Try changing your search criteria</p>
                        </td>
                    </tr>
                `;
            } else {
                products.forEach(product => {
                    const lowStockClass = product.minimumStock > 0 && product.stockQuantity <= product.minimumStock 
                        ? 'bg-red-100 text-red-800' 
                        : 'bg-green-100 text-green-800';
                    
                    // Format price display
                    let priceHtml = '';
                    if (product.latestPrice) {
                        priceHtml = `
                            <div class="text-sm text-green-600 font-medium mt-1">
                                Latest: ${product.latestPrice.toFixed(2)}/unit
                            </div>
                        `;
                        if (product.averagePrice && product.averagePrice !== product.latestPrice) {
                            priceHtml += `
                                <div class="text-xs text-gray-500">
                                    Avg: ${product.averagePrice.toFixed(2)}
                                </div>
                            `;
                        }
                    } else {
                        priceHtml = `
                            <div class="text-xs text-gray-400 mt-1">
                                No price data
                            </div>
                        `;
                    }
                    
                    // Stock value display
                    let stockValueHtml = '';
                    if (product.stockValue > 0) {
                        stockValueHtml = `
                            <div class="text-xs text-blue-600">
                                Value: ${product.stockValue.toLocaleString()}
                            </div>
                        `;
                    }
                    
                    html += `
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">${product.itemName}</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-semibold text-gray-900">${product.latestPrice !== null ? `${product.latestPrice.toFixed(2)}` : 'N/A'  }</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                                    ${product.category}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                ${product.location}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${lowStockClass} w-fit">
                                        ${product.stockQuantity.toLocaleString()}
                                    </span>
                                    ${stockValueHtml}
                                    ${product.minimumStock > 0 ? `<div class="text-xs text-gray-500 mt-1">Min: ${product.minimumStock}</div>` : ''}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                ${product.unit}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button onclick="viewProduct('${product._id}')" class="text-blue-600 hover:text-blue-900 mr-3" title="View">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button onclick="editProduct('${product._id}')" class="text-yellow-600 hover:text-yellow-900 mr-3" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button onclick="showStockModal('${product._id}', '${product.itemCode}', '${product.itemName}')" class="text-green-600 hover:text-green-900 mr-3" title="Stock Operation">
                                    <i class="fas fa-exchange-alt"></i>
                                </button>
                                <button onclick="deleteProduct('${product._id}', '${product.itemCode}')" class="text-red-600 hover:text-red-900" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
            }
            
            html += `
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Pagination -->
                    ${renderPagination(pagination)}
                </div>
            `;
            
            document.getElementById('content-area').innerHTML = html;
        }

        function renderPagination(pagination) {
            if (pagination.pages <= 1) return '';
            
            let html = `
                <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                    <div class="flex-1 flex justify-between sm:hidden">
                        ${pagination.page > 1 ? `
                            <button onclick="loadProducts(${pagination.page - 1})" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                Previous
                            </button>
                        ` : ''}
                        ${pagination.page < pagination.pages ? `
                            <button onclick="loadProducts(${pagination.page + 1})" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                Next
                            </button>
                        ` : ''}
                    </div>
                    <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                        <div>
                            <p class="text-sm text-gray-700">
                                Showing <span class="font-medium">${(pagination.page - 1) * pagination.limit + 1}</span>
                                to <span class="font-medium">${Math.min(pagination.page * pagination.limit, pagination.total)}</span>
                                of <span class="font-medium">${pagination.total}</span> results
                            </p>
                        </div>
                        <div>
                            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
            `;
            
            for (let i = 1; i <= pagination.pages; i++) {
                if (i === pagination.page) {
                    html += `
                        <span class="z-10 bg-blue-50 border-blue-500 text-blue-600 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            ${i}
                        </span>
                    `;
                } else {
                    html += `
                        <button onclick="loadProducts(${i})" class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            ${i}
                        </button>
                    `;
                }
            }
            
            html += `
                            </nav>
                        </div>
                    </div>
                </div>
            `;
            
            return html;
        }

        // Show stock modal
        function showStockModal(productId, itemCode, itemName) {
            const modalHtml = `
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity z-50"></div>
                <div class="fixed inset-0 z-50 overflow-y-auto">
                    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md">
                            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Stock Operation - ${itemCode}</h3>
                                <p class="text-sm text-gray-500 mb-4">${itemName}</p>
                                <form id="stock-form">
                                    <input type="hidden" id="stock-product-id" value="${productId}">
                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Operation Type *</label>
                                            <select id="stock-type" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                                <option value="stock_in">Stock In (Add)</option>
                                                <option value="stock_out">Stock Out (Remove)</option>
                                                <option value="adjustment">Adjustment</option>
                                                <option value="damage">Damage</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Quantity *</label>
                                            <input type="number" id="stock-quantity" required min="1" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Reference (Optional)</label>
                                            <input type="text" id="stock-reference" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Description</label>
                                            <textarea id="stock-description" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"></textarea>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                                <button type="button" onclick="submitStockForm()" class="inline-flex w-full justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-base font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm">Update Stock</button>
                                <button type="button" onclick="closeModal()" class="mt-3 inline-flex w-full justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('modals-container').innerHTML = modalHtml;
        }

        // Submit stock form
        async function submitStockForm() {
            const productId = document.getElementById('stock-product-id').value;
            const type = document.getElementById('stock-type').value;
            const quantity = document.getElementById('stock-quantity').value;
            const reference = document.getElementById('stock-reference').value;
            const description = document.getElementById('stock-description').value;
            
            if (!quantity || quantity <= 0) {
                showError('Please enter a valid quantity');
                return;
            }
            
            try {
                const response = await fetch(`${API_BASE}/products/${productId}/stock`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        quantity: parseInt(quantity),
                        type,
                        description,
                        reference
                    })
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (data.success) {
                    showSuccess('Stock updated successfully');
                    closeModal();
                    loadProducts();
                    loadDashboardStats();
                } else {
                    showError(data.message || 'Failed to update stock');
                }
            } catch (error) {
                showError('Error updating stock: ' + error.message);
            }
        }

        // Delete product
        async function deleteProduct(productId, itemCode) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to deactivate ${itemCode}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, deactivate it!'
            });
            
            if (result.isConfirmed) {
                try {
                    const response = await fetch(`${API_BASE}/products/${productId}`, {
                        method: 'DELETE'
                    });
                    
                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                    }
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        showSuccess('Product deactivated successfully');
                        loadProducts();
                        loadDashboardStats();
                    } else {
                        showError(data.message || 'Failed to deactivate product');
                    }
                } catch (error) {
                    showError('Error deactivating product: ' + error.message);
                }
            }
        }

        // Close modal
        function closeModal() {
            document.getElementById('modals-container').innerHTML = '';
        }

        // Utility functions
        function showSuccess(message) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: message,
                timer: 2000,
                showConfirmButton: false
            });
        }

        function showError(message) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: message
            });
        }

        // Helper function to view product details
        function viewProduct(productId) {
            window.location.href = `/products/view/${productId}`;
        }

        // Helper function to edit product
        function editProduct(productId) {
            window.location.href = `/products/edit/${productId}`;
        }

        // Debounce search input
        let searchTimeout;
        document.getElementById('search-input').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                loadProducts(1);
            }, 500);
        });

        // Add reset filters function if needed
        function resetFilters() {
            document.getElementById('search-input').value = '';
            const categoryInput = document.getElementById('category-filter');
            categoryInput.value = '';
            
            // Reset tabs UI
            const categoryTabs = document.querySelectorAll('.category-tab-btn');
            categoryTabs.forEach(tab => {
                const tabCategory = tab.getAttribute('data-category');
                if (tabCategory === '') {
                    tab.classList.remove('text-gray-700', 'hover:bg-white', 'hover:text-blue-700', 'hover:shadow-sm');
                    tab.classList.add('bg-white', 'text-blue-700', 'shadow-sm', 'border', 'border-blue-300');
                } else {
                    tab.classList.remove('bg-white', 'text-blue-700', 'shadow-sm', 'border', 'border-blue-300');
                    tab.classList.add('text-gray-700', 'hover:bg-white', 'hover:text-blue-700', 'hover:shadow-sm');
                }
            });
            
            loadProducts(1);
        }
    </script>

    <style>
        .nav-link {
            border-bottom-width: 2px;
            padding: 8px 0;
            margin-right: 24px;
        }
        
        .nav-link:hover {
            border-bottom-color: #d1d5db;
            color: #374151;
        }
        
        tr:hover {
            background-color: #f9fafb;
        }
        
        /* Ensure modal appears on top */
        .z-50 {
            z-index: 50;
        }
    </style>
</body>
</html>