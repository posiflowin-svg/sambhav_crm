<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders Management - Dispatcher</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #eef2ff;
            --secondary: #6c757d;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #06b6d4;
            --dark: #1e293b;
            --light: #f8fafc;
            --gray: #94a3b8;
            --border: #e2e8f0;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #f1f5f9;
            color: var(--dark);
        }
        
        /* Header Styles */
        .dispatcher-header {
            background: linear-gradient(135deg, var(--primary) 0%, #3a56d4 100%);
            color: white;
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        
        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .logo-icon {
            font-size: 2rem;
        }
        
        .logo-text h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }
        
        .logo-text p {
            font-size: 0.875rem;
            opacity: 0.9;
            margin: 0;
        }
        
        .user-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .user-info {
            text-align: right;
        }
        
        .user-info .name {
            font-weight: 600;
        }
        
        .user-info .role {
            font-size: 0.875rem;
            opacity: 0.9;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }
        
        /* Main Content */
        .main-content {
            max-width: 1400px;
            margin: 2rem auto;
            padding: 0 2rem;
        }
        
        /* Page Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2rem;
        }
        
        .page-title h2 {
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }
        
        .page-subtitle {
            color: var(--gray);
            font-size: 1rem;
        }
        
        /* Stats Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease;
            border-top: 4px solid var(--primary);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
        }
        
        .stat-card.pending { border-top-color: var(--warning); }
        .stat-card.approved { border-top-color: var(--info); }
        .stat-card.dispatched { border-top-color: var(--primary); }
        .stat-card.delivered { border-top-color: var(--success); }
        
        .stat-card h3 {
            font-size: 0.875rem;
            color: var(--gray);
            margin-bottom: 0.5rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .stat-card .value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 0.25rem;
        }
        
        .stat-card .description {
            font-size: 0.875rem;
            color: var(--gray);
        }
        
        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
            margin-bottom: 1.5rem;
        }
        
        .filter-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .filter-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--dark);
            margin: 0;
        }
        
        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }
        
        .search-box {
            grid-column: 1 / -1;
            margin-bottom: 1rem;
        }
        
        /* Table Container */
        .table-container {
            background: white;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
        }
        
        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem;
            border-bottom: 1px solid var(--border);
        }
        
        .table-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--dark);
            margin: 0;
        }
        
        /* Table Styles */
        .table {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            margin: 0;
        }
        
        .table thead th {
            background-color: var(--primary-light);
            color: var(--dark);
            font-weight: 600;
            border: none;
            padding: 1rem;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .table tbody td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }
        
        .table tbody tr:last-child td {
            border-bottom: none;
        }
        
        .table tbody tr:hover {
            background-color: rgba(67, 97, 238, 0.03);
        }
        
        /* Status Badges */
        .badge {
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 500;
        }
        
        .status-pending {
            background-color: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }
        
        .status-approved {
            background-color: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
        }
        
        .status-dispatched {
            background-color: rgba(67, 97, 238, 0.1);
            color: var(--primary);
        }
        
        .status-delivered {
            background-color: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }
        
        .status-cancelled {
            background-color: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }
        
        /* Order Type Badges */
        .type-cod {
            background-color: rgba(67, 97, 238, 0.1);
            color: var(--primary);
        }
        
        .type-prepaid {
            background-color: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }
        
        .type-credit {
            background-color: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }
        
        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 0.5rem;
        }
        
        .btn-sm {
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        
        /* Overdue Indicator */
        .overdue {
            color: var(--danger);
            font-weight: 600;
        }
        
        /* Pagination */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border);
        }
        
        .pagination-info {
            color: var(--gray);
            font-size: 0.875rem;
        }
        
        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }
            
            .user-menu {
                width: 100%;
                justify-content: space-between;
            }
            
            .main-content {
                padding: 0 1rem;
            }
            
            .page-header {
                flex-direction: column;
                gap: 1rem;
            }
            
            .filter-grid {
                grid-template-columns: 1fr;
            }
            
            .table-header {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }
            
            .table-responsive {
                font-size: 0.875rem;
            }
            
            .action-buttons {
                flex-direction: column;
            }
        }
        
        @media (max-width: 576px) {
            .dispatcher-header {
                padding: 1rem;
            }
            
            .stats-container {
                grid-template-columns: 1fr;
            }
            
            .pagination-container {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="dispatcher-header">
        <div class="header-content">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="logo-text">
                    <h1>Dispatcher Portal</h1>
                    <p>Order Management System</p>
                </div>
            </div>
            <div class="user-menu">
                <div class="user-info">
                    <div class="name"><%= user.name %></div>
                    <div class="role">Dispatcher</div>
                </div>
                <div class="user-avatar">
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <% if (user) { %>
                    <a href="/auth/logout" style="color: white; text-decoration: underline;">Logout</a>
                    <% } else { %>
                    <a href="/auth/login" style="color: white; text-decoration: underline;">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title">
                <h2>Orders Management</h2>
                <p class="page-subtitle">Track and manage order dispatches</p>
            </div>
            <div class="header-actions">
                <a href="/products" class="btn btn-primary">
                    <i class="bi bi-box-seam"></i> Stock Manager Dashboard
                </a>
                <button class="btn btn-success" onclick="exportOrders(event)">
                    <i class="bi bi-file-earmark-excel"></i> Export to Excel
                </button>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="stats-container">
            <div class="stat-card">
                <h3>Total Orders</h3>
                <div class="value" id="totalOrders">0</div>
                <div class="description">All assigned orders</div>
            </div>

            <div class="stat-card pending">
                <h3>Pending Dispatch</h3>
                <div class="value" id="pendingOrders">0</div>
                <div class="description">Ready for dispatch</div>
            </div>

            <div class="stat-card dispatched">
                <h3>In Transit</h3>
                <div class="value" id="dispatchedOrders">0</div>
                <div class="description">Currently in transit</div>
            </div>

            <div class="stat-card delivered">
                <h3>Delivered Today</h3>
                <div class="value" id="deliveredOrders">0</div>
                <div class="description">Successful deliveries</div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="filter-header">
                <h3 class="filter-title">Filter Orders</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                    <i class="bi bi-arrow-clockwise"></i> Reset Filters
                </button>
            </div>
            
            <div class="filter-grid">
                <div class="search-box">
                    <label class="form-label">Search Orders</label>
                    <div class="input-group">
                        <input 
                            type="text" 
                            id="searchQuery"
                            class="form-control"
                            placeholder="Search by customer name, order ID, invoice number..." 
                        >
                        <button class="btn btn-primary" type="button" onclick="loadOrders(1)">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
                
                <div>
                    <label class="form-label">Status</label>
                    <select id="statusFilter" class="form-select" onchange="loadOrders(1)">
                        <option value="">All Status</option>
                        <option value="approved">Approved</option>
                        <option value="dispatched">Dispatched</option>
                        <option value="delivered">Delivered</option>
                    </select>
                </div>
                
                <div>
                    <label class="form-label">Order Type</label>
                    <select id="orderTypeFilter" class="form-select" onchange="loadOrders(1)">
                        <option value="">All Types</option>
                        <option value="cod">COD</option>
                        <option value="prepaid">Prepaid</option>
                    </select>
                </div>
                
                <div>
                    <label class="form-label">Date Range</label>
                    <select id="dateRangeFilter" class="form-select" onchange="handleDateRangeChange(this.value)">
                        <option value="">All Dates</option>
                        <option value="today">Today</option>
                        <option value="this_week">This Week</option>
                        <option value="this_month">This Month</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>

                <!-- Custom Date Range (Hidden by default) -->
                <div id="customDateRange" style="display: none; grid-column: span 2;">
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label">From Date</label>
                            <input type="date" id="dateFrom" class="form-control" onchange="loadOrders(1)">
                        </div>
                        <div class="col">
                            <label class="form-label">To Date</label>
                            <input type="date" id="dateTo" class="form-control" onchange="loadOrders(1)">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Recent Orders</h3>
                <div class="table-actions">
                    <span class="text-muted" id="tableInfo">Loading...</span>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Order Date</th>
                            <th>Due Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody">
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                                Loading orders...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            <div class="pagination-container">
                <div class="pagination-info" id="paginationInfo">
                    Showing 0 of 0 orders
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="pagination">
                        <!-- Pagination will be loaded here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let currentPage = 1;
        const ordersPerPage = 10;

        // Load orders with filters
        async function loadOrders(page = 1) {
            currentPage = page;
            
            try {
                showLoading();
                
                // Build query parameters
                const params = new URLSearchParams();
                params.append('page', page);
                params.append('limit', ordersPerPage);
                
                // Add filters
                const status = document.getElementById('statusFilter').value;
                const orderType = document.getElementById('orderTypeFilter').value;
                const searchQuery = document.getElementById('searchQuery').value;
                const dateRange = document.getElementById('dateRangeFilter').value;
                const dateFrom = document.getElementById('dateFrom')?.value;
                const dateTo = document.getElementById('dateTo')?.value;
                
                if (status) params.append('status', status);
                if (orderType) params.append('orderType', orderType);
                if (searchQuery) params.append('search', searchQuery);
                if (dateRange && dateRange !== 'custom') params.append('dateRange', dateRange);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);

                const response = await fetch(`/api/dispatcher/orders?${params}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                updateOrdersTable(data.orders);
                updatePagination(data.total, data.page, data.pages);
                updateStats(data.stats);
                
            } catch (error) {
                console.error('Error loading orders:', error);
                showError('Error loading orders. Please try again.');
            }
        }

        function updateOrdersTable(orders) {
            const tbody = document.getElementById('ordersTableBody');
            
            if (!orders || orders.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                            No orders found matching your criteria
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = orders.map(order => `
                <tr>
                    <td>
                        <strong class="text-primary">#${order.invoiceNo || order.orderReference || order._id.slice(-6).toUpperCase()}</strong>
                        ${order.trackingId ? `<br><small class="text-muted">Tracking: ${order.trackingId}</small>` : ''}
                    </td>
                    <td>
                        <div>
                            <strong>${order.customer?.name || order.customerName || 'N/A'}</strong>
                            <br>
                            <small class="text-muted">${order.customer?.address?.city || order.shippingAddress?.city || ''}</small>
                        </div>
                    </td>
                    <td>
                        <small>${order.customer?.mobileNumber || order.customerContact || 'N/A'}</small>
                    </td>
                    <td>
                        <strong>₹${(order.total || order.totalAmount || 0).toLocaleString('en-IN')}</strong>
                    </td>
                    <td>
                        <span class="badge ${order.orderType === 'cod' ? 'bg-warning' : 'bg-success'}">
                            ${order.orderType?.toUpperCase() || 'N/A'}
                        </span>
                    </td>
                    <td>
                        <span class="badge ${getStatusBadgeClass(order.status)}">
                            ${getStatusDisplay(order.status)}
                        </span>
                    </td>
                    <td>
                        ${formatDate(order.orderDate || order.createdAt)}
                    </td>
                    <td>
                        <span class="${isOverdue(order.dueDate) ? 'text-danger fw-bold' : ''}">
                            ${formatDate(order.dueDate)}
                            ${isOverdue(order.dueDate) ? '<i class="bi bi-exclamation-circle ms-1"></i>' : ''}
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a href="/dispatcher/orders/${order._id}" class="btn btn-outline-primary btn-sm" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            ${order.status === 'approved' ? `
                                <button class="btn btn-success btn-sm ms-1" onclick="updateOrderStatus('${order._id}', 'dispatched')" title="Mark as Dispatched">
                                    <i class="bi bi-truck"></i>
                                </button>
                            ` : ''}
                            ${order.status === 'dispatched' ? `
                                <button class="btn btn-primary btn-sm ms-1" onclick="updateOrderStatus('${order._id}', 'delivered')" title="Mark as Delivered">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                            ` : ''}
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function getStatusDisplay(status) {
            const statusMap = {
                'pending': 'Pending',
                'approved': 'Approved',
                'dispatched': 'In Transit',
                'delivered': 'Delivered',
                'cancelled': 'Cancelled'
            };
            return statusMap[status] || status;
        }

        function getStatusBadgeClass(status) {
            const classMap = {
                'pending': 'bg-secondary',
                'approved': 'bg-warning',
                'dispatched': 'bg-info',
                'delivered': 'bg-success',
                'cancelled': 'bg-danger'
            };
            return classMap[status] || 'bg-secondary';
        }

        function formatDate(dateString) {
            if (!dateString) return 'N/A';
            const date = new Date(dateString);
            return date.toLocaleDateString('en-IN');
        }

        function isOverdue(dueDate) {
            if (!dueDate) return false;
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const due = new Date(dueDate);
            due.setHours(0, 0, 0, 0);
            return due < today;
        }

        function updatePagination(total, page, pages) {
            const pagination = document.getElementById('pagination');
            const paginationInfo = document.getElementById('paginationInfo');
            
            if (!total || total === 0) {
                pagination.innerHTML = '';
                paginationInfo.textContent = 'No orders found';
                return;
            }
            
            // Update pagination info
            const start = ((page - 1) * ordersPerPage) + 1;
            const end = Math.min(page * ordersPerPage, total);
            paginationInfo.textContent = `Showing ${start} to ${end} of ${total} orders`;
            
            let paginationHTML = '';

            // Previous button
            paginationHTML += `
                <li class="page-item ${page === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="loadOrders(${page - 1}); return false;">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            `;

            // Page numbers
            const maxVisiblePages = 5;
            let startPage = Math.max(1, page - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(pages, startPage + maxVisiblePages - 1);
            
            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            // First page
            if (startPage > 1) {
                paginationHTML += `
                    <li class="page-item">
                        <a class="page-link" href="#" onclick="loadOrders(1); return false;">1</a>
                    </li>
                    ${startPage > 2 ? '<li class="page-item disabled"><span class="page-link">...</span></li>' : ''}
                `;
            }

            // Page numbers
            for (let i = startPage; i <= endPage; i++) {
                paginationHTML += `
                    <li class="page-item ${i === page ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="loadOrders(${i}); return false;">${i}</a>
                    </li>
                `;
            }

            // Last page
            if (endPage < pages) {
                paginationHTML += `
                    ${endPage < pages - 1 ? '<li class="page-item disabled"><span class="page-link">...</span></li>' : ''}
                    <li class="page-item">
                        <a class="page-link" href="#" onclick="loadOrders(${pages}); return false;">${pages}</a>
                    </li>
                `;
            }

            // Next button
            paginationHTML += `
                <li class="page-item ${page === pages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="loadOrders(${page + 1}); return false;">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            `;

            pagination.innerHTML = paginationHTML;
        }

        function updateStats(stats) {
            if (stats) {
                document.getElementById('totalOrders').textContent = stats.totalOrders?.toLocaleString() || '0';
                document.getElementById('pendingOrders').textContent = stats.pendingOrders?.toLocaleString() || '0';
                document.getElementById('dispatchedOrders').textContent = stats.dispatchedOrders?.toLocaleString() || '0';
                document.getElementById('deliveredOrders').textContent = stats.deliveredOrders?.toLocaleString() || '0';
            }
        }

        function handleDateRangeChange(range) {
            const customRangeDiv = document.getElementById('customDateRange');
            
            if (range === 'custom') {
                customRangeDiv.style.display = 'block';
                // Set default dates for custom range
                const today = new Date();
                const oneWeekAgo = new Date(today);
                oneWeekAgo.setDate(today.getDate() - 7);
                
                document.getElementById('dateFrom').valueAsDate = oneWeekAgo;
                document.getElementById('dateTo').valueAsDate = today;
            } else {
                customRangeDiv.style.display = 'none';
                loadOrders(1);
            }
        }

        async function updateOrderStatus(orderId, status) {
            let trackingId = null;
            
            if (status === 'dispatched') {
                trackingId = prompt('Please enter tracking ID:');
                if (!trackingId) {
                    alert('Tracking ID is required for dispatch.');
                    return;
                }
            }
            
            if (!confirm(`Are you sure you want to mark this order as ${status}?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/dispatcher/orders/${orderId}/status`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + localStorage.getItem('token') // Add if using token auth
                    },
                    body: JSON.stringify({ 
                        status,
                        trackingId: status === 'dispatched' ? trackingId : undefined
                    })
                });

                if (response.ok) {
                    const result = await response.json();
                    alert('Order status updated successfully!');
                    loadOrders(currentPage);
                } else {
                    const error = await response.json();
                    alert('Error updating status: ' + (error.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Status update error:', error);
                alert('Error updating order status. Please try again.');
            }
        }

        async function exportOrders(event) {
            try {
                // Show loading state
                const exportBtn = event.target;
                const originalText = exportBtn.innerHTML;
                exportBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Generating...';
                exportBtn.disabled = true;

                // Build export parameters
                const params = new URLSearchParams();
                const status = document.getElementById('statusFilter').value;
                const orderType = document.getElementById('orderTypeFilter').value;
                const searchQuery = document.getElementById('searchQuery').value;
                const dateRange = document.getElementById('dateRangeFilter').value;
                const dateFrom = document.getElementById('dateFrom')?.value;
                const dateTo = document.getElementById('dateTo')?.value;
                
                if (status) params.append('status', status);
                if (orderType) params.append('orderType', orderType);
                if (searchQuery) params.append('search', searchQuery);
                if (dateRange && dateRange !== 'custom') params.append('dateRange', dateRange);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);

                const response = await fetch(`/api/dispatcher/orders/export?${params}`);
                
                if (!response.ok) {
                    throw new Error('Export failed: ' + response.statusText);
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                
                // Create filename with timestamp
                const timestamp = new Date().toISOString().split('T')[0];
                a.download = `dispatcher_orders_${timestamp}.xlsx`;
                
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);

            } catch (error) {
                console.error('Export error:', error);
                alert('Error exporting orders: ' + error.message);
            } finally {
                // Reset button state
                const exportBtn = event.target;
                exportBtn.innerHTML = '<i class="bi bi-file-earmark-excel"></i> Export to Excel';
                exportBtn.disabled = false;
            }
        }

        function showLoading() {
            document.getElementById('ordersTableBody').innerHTML = `
                <tr>
                    <td colspan="9" class="text-center py-4">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        Loading orders...
                    </td>
                </tr>
            `;
            document.getElementById('tableInfo').textContent = 'Loading...';
        }

        function showError(message) {
            document.getElementById('ordersTableBody').innerHTML = `
                <tr>
                    <td colspan="9" class="text-center py-4 text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        ${message}
                    </td>
                </tr>
            `;
            document.getElementById('tableInfo').textContent = 'Error loading orders';
        }

        function clearFilters() {
            document.getElementById('searchQuery').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('orderTypeFilter').value = '';
            document.getElementById('dateRangeFilter').value = '';
            document.getElementById('customDateRange').style.display = 'none';
            loadOrders(1);
        }

        // Load data when page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadOrders(1);
            
            // Add keyboard shortcut for search
            document.getElementById('searchQuery').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    loadOrders(1);
                }
            });
        });
    </script>
</body>
</html>