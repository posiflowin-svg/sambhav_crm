  .status-created { background-color: #e3f2fd; color: #1976d2; }
  .status-accountant-review { background-color: #fff8e1; color: #ff8f00; }
  .status-accountant-approved { background-color: #e8f5e9; color: #388e3c; }
  .status-dispatch-pending { background-color: #f3e5f5; color: #8e24aa; }
