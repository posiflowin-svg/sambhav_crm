  }
  
  .btn-primary:hover {
    background-color: #388e3c;
  }

  .actions-cell {
    width: 220px; /* Slightly wider to accommodate both buttons */
  }

  .action-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 4px;
