<%- include('../../partials/header') %>

<style>
  /* Custom date range styling */
  #customDateRange {
    transition: all 0.3s ease;
    align-items: center;
    gap: 5px;
  }

  #customDateRange .col-md-6 {
    padding-left: 5px;
    padding-right: 5px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    #customDateRange {
      flex-direction: column;
      gap: 10px;
    }
    
    #customDateRange .col-md-6 {
      width: 100%;
      padding-left: 0;
      padding-right: 0;
    }
  }
  .card-hover:hover {
    transform: translateY(-2px);
    transition: transform 0.2s ease;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }
  
  .badge {
    padding: 0.35em 0.65em;
    font-weight: 500;
  }
</style>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
      <i class="bi bi-truck me-2"></i>COD Dispatch Dashboard
    </h2>
  </div>

  <!-- Status Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'approved' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'approved' ? 'border-primary' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Approved Orders</h6>
                <h3 class="mb-0"><%= approvedCount %></h3>
              </div>
              <div class="bg-primary bg-opacity-10 p-3 rounded">
                <i class="bi bi-check-circle text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'packed' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'packed' ? 'border-warning' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Packed Orders</h6>
                <h3 class="mb-0"><%= packedCount %></h3>
              </div>
              <div class="bg-warning bg-opacity-10 p-3 rounded">
                <i class="bi bi-box-seam text-warning fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'dispatched' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'dispatched' ? 'border-info' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Dispatched Orders</h6>
                <h3 class="mb-0"><%= dispatchedCount %></h3>
              </div>
              <div class="bg-info bg-opacity-10 p-3 rounded">
                <i class="bi bi-truck text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'completed' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'completed' ? 'border-success' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Delivered Orders</h6>
                <h3 class="mb-0"><%= completedCount %></h3>
              </div>
              <div class="bg-success bg-opacity-10 p-3 rounded">
                <i class="bi bi-check-circle-fill text-success fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Filter and Search Section -->
  <div class="card mb-4">
    <div class="card-body p-3">
      <form id="filterForm" class="row g-3 align-items-center">
        <div class="col-md-6">
          <label for="searchInput" class="form-label">Search Orders</label>
          <div class="input-group">
            <input type="text" class="form-control" id="searchInput" name="search" 
                  placeholder="Customer, Contact, Order Ref, Tracking ID" value="<%= searchQuery %>">
            <button class="btn btn-outline-secondary" type="submit">
              <i class="bi bi-search"></i>
            </button>
          </div>
        </div>
        
        <div class="col-md-4">
          <label for="dateFilter" class="form-label">Date Range</label>
          <select class="form-select" id="dateFilter" name="dateRange">
            <option value="">All Time</option>
            <option value="today" <%= dateRange === 'today' ? 'selected' : '' %>>Today</option>
            <option value="week" <%= dateRange === 'week' ? 'selected' : '' %>>This Week</option>
            <option value="month" <%= dateRange === 'month' ? 'selected' : '' %>>This Month</option>
            <option value="custom" <%= dateRange === 'custom' ? 'selected' : '' %>>Custom Range</option>
          </select>
          
          <!-- Custom Date Range Inputs -->
          <div id="customDateRange" class="row g-2 mt-2" style="display: <%= dateRange === 'custom' ? 'flex' : 'none' %>;">
            <div class="col-md-6">
              <input type="date" class="form-control" name="dateFrom" value="<%= dateFrom || '' %>">
            </div>
            <div class="col-md-6">
              <input type="date" class="form-control" name="dateTo" value="<%= dateTo || '' %>">
            </div>
          </div>
        </div>
        
        <div class="col-md-2 d-flex align-items-end">
          <button type="submit" class="btn btn-primary me-3">
            <i class="bi bi-funnel me-1"></i> Filter
          </button>
          <a href="?" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-counterclockwise"></i>
          </a>
          <a href="/dashboard/cod_dispatch/orders/bulk-print?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>" 
            class="btn btn-primary">
            <i class="bi bi-download"></i> ZIP
          </a>
        </div>
        <input type="hidden" name="status" value="<%= currentStatus %>">
      </form>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Order Ref</th>
              <th>Customer</th>
              <th>Contact</th>
              <th>Amount</th>
              <th>Date</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr class="<%= order.isBillOnHold ? 'table-warning' : '' %>">
                <td class="ps-4 fw-bold">
                  <a href="#" class="text-decoration-none view-order-link" data-order-id="<%= order._id %>">
                    #<%= order.orderReference || order._id.toString().slice(-6).toUpperCase() %>
                  </a>
                  <% if (order.shippingType) { %>
                  <span class="badge 
                    <% if (order.shippingType === 'Critica') { %> bg-danger <% } %>
                    <% if (order.shippingType === 'Blue Dart') { %> bg-primary <% } %>
                    <% if (order.shippingType === 'ShipRocket') { %> bg-success <% } %>
                    <% if (order.shippingType === 'Other') { %> bg-secondary <% } %>
                    <% if (order.shippingType === 'PORTER') { %> bg-warning text-dark <% } %>
                  ">
                    <%= order.shippingType %>
                  </span>
                <% } %>
                </td>
                <td><%= order.customerName %></td>
                <td><%= order.customerContact %></td>
                <td class="fw-bold">₹<%= order.total.toLocaleString('en-IN') %></td>
                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= getStatusBadgeColor(order.companyStatus) %>">
                    <i class="bi <%= getStatusIcon(order.companyStatus) %> me-1"></i>
                    <%= order.companyStatus.replace('_', ' ') %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <div class="btn-group btn-group-sm" role="group">
                    <button class="btn btn-outline-primary view-order-btn" 
                            data-order-id="<%= order._id %>"
                            title="View Details">
                      <i class="bi bi-eye"></i>
                    </button>
                    
                      <button class="btn btn-outline-secondary print-btn" 
                              data-order-id="<%= order._id %>"
                              title="Print Invoice">
                        <i class="bi bi-printer"></i>
                      </button>
                    
                    <% if (order.companyStatus === 'accountant_approved') { %>
                      <button class="btn btn-outline-success" 
                              data-bs-toggle="modal" 
                              data-bs-target="#packModal" 
                              data-order-id="<%= order._id %>"
                              title="Mark as Packed">
                        <i class="bi bi-box-seam"></i>
                      </button>
                      <% if (!order.isBillOnHold) { %>
                        <button class="btn btn-outline-warning" 
                                data-bs-toggle="modal" 
                                data-bs-target="#holdModal" 
                                data-order-id="<%= order._id %>"
                                title="Hold Bill">
                          <i class="bi bi-pause-circle"></i>
                        </button>
                      <% } %>
                    <% } else if (order.companyStatus === 'dispatch_packed') { %>
                      <button class="btn btn-outline-info" 
                              data-bs-toggle="modal" 
                              data-bs-target="#dispatchModal" 
                              data-order-id="<%= order._id %>"
                              title="Mark as Dispatched">
                        <i class="bi bi-truck"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      
      <% if (orders.length === 0) { %>
        <div class="text-center py-5">
          <img src="https://img.freepik.com/free-vector/empty-concept-illustration_114360-1188.jpg?uid=R55028212&ga=GA1.1.497053720.1738572050&semt=ais_items_boosted&w=740" alt="No orders" style="height: 150px;" class="mb-3">
          <h5 class="text-muted">No orders found</h5>
          <p class="text-muted">Try adjusting your search or filter criteria</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        <% if (currentPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= currentPage - 1 %>">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>
        <% } %>
        
        <% const maxVisiblePages = 5;
          let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
          let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
          
          if (endPage - startPage + 1 < maxVisiblePages) {
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
          }
          
          if (startPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=1">1</a>
          </li>
          <% if (startPage > 2) { %>
            <li class="page-item disabled">
              <span class="page-link">...</span>
            </li>
          <% } %>
        <% } %>
        
        <% for (let i = startPage; i <= endPage; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= i %>"><%= i %></a>
          </li>
        <% } %>
        
        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <li class="page-item disabled">
              <span class="page-link">...</span>
            </li>
          <% } %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= totalPages %>"><%= totalPages %></a>
          </li>
        <% } %>
        
        <% if (currentPage < totalPages) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= currentPage + 1 %>">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>

<!-- Order Details Modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-file-text me-2"></i>
          Order Details: <span id="orderIdHeader"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="orderDetailsContent">
        <!-- Content will be loaded via AJAX -->
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i> Close
        </button>
        <button type="button" class="btn btn-secondary" id="printInModalBtn" style="display: none;">
          <i class="bi bi-printer me-1"></i> Print Invoice
        </button>
        <button type="button" class="btn btn-success" id="packInModalBtn" style="display: none;">
          <i class="bi bi-box-seam me-1"></i> Mark as Packed
        </button>
        <button type="button" class="btn btn-info text-white" id="dispatchInModalBtn" style="display: none;">
          <i class="bi bi-truck me-1"></i> Mark as Dispatched
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Pack Modal -->
<div class="modal fade" id="packModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-box-seam text-success me-2"></i>Mark as Packed
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="packForm" method="POST">
        <div class="modal-body">
          <p>Are you sure you want to mark this order as packed?</p>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-success">
            <i class="bi bi-box-seam me-1"></i> Mark as Packed
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Hold Bill Modal -->
<div class="modal fade" id="holdModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-pause-circle text-warning me-2"></i>Hold Bill
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="holdForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="holdReason" class="form-label">Reason for Hold</label>
            <textarea class="form-control" id="holdReason" name="holdReason" rows="3" 
                      placeholder="Enter reason for holding this bill..." required></textarea>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-pause-circle me-1"></i> Hold Bill
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Dispatch Modal -->
<div class="modal fade" id="dispatchModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-truck text-info me-2"></i>Mark as Dispatched
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="dispatchForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tracking ID</label>
            <input type="text" name="trackingId" class="form-control" placeholder="Enter tracking number" required>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-info text-white">
            <i class="bi bi-truck me-1"></i> Mark as Dispatched
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Check if Bootstrap is loaded
    if (typeof bootstrap === 'undefined') {
      console.error('Bootstrap JS is not loaded!');
      return;
    }

    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
    tooltipTriggerList.forEach(function (tooltipTriggerEl) {
      new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Handle form submission with all filters
    document.getElementById('filterForm')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      const params = new URLSearchParams(formData).toString();
      window.location.href = `?${params}`;
    });

    // Handle both order ID click and view button click
    document.querySelectorAll('.view-order-btn, .view-order-link').forEach(element => {
      element.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        loadOrderDetails(orderId);
      });
    });

    // Enhanced loadOrderDetails function
    async function loadOrderDetails(orderId) {
      try {
        const orderDetailsModal = new bootstrap.Modal('#orderDetailsModal');
        const orderDetailsContent = document.getElementById('orderDetailsContent');
        
        // Show loading state
        orderDetailsContent.innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-2">Loading order details...</div>
          </div>
        `;

        orderDetailsModal.show();

        const response = await fetch(`/dashboard/cod_dispatch/orders/${orderId}/details`);
        const data = await response.text();
        
        if (!response.ok) {
          throw new Error(data.error || 'Failed to load order');
        }

        orderDetailsContent.innerHTML = data;
        setupModalActionButtons(orderId);

      } catch (error) {
        console.error('Load order error:', error);
        document.getElementById('orderDetailsContent').innerHTML = `
          <div class="alert alert-danger m-3">
            <i class="bi bi-exclamation-octagon me-2"></i>
            <strong>Error loading order</strong>
            <div class="mt-2">${error.message}</div>
            <button class="btn btn-sm btn-outline-secondary mt-3" onclick="loadOrderDetails('${orderId}')">
              <i class="bi bi-arrow-clockwise"></i> Try Again
            </button>
          </div>
        `;
      }
    }

    // Set up action buttons in the modal
    function setupModalActionButtons(orderId) {
      const packBtn = document.getElementById('packInModalBtn');
      const dispatchBtn = document.getElementById('dispatchInModalBtn');
      const printBtn = document.getElementById('printInModalBtn');
      
      // Reset buttons
      packBtn.style.display = 'none';
      dispatchBtn.style.display = 'none';
      printBtn.style.display = 'none';
      
      // Check order status from the loaded content
      const statusBadge = document.querySelector('#orderDetailsContent .badge');
      if (!statusBadge) return;
      
      const status = statusBadge.textContent.trim().toLowerCase();
      
      if (status.includes('approved') || status.includes('packed')) {
        printBtn.style.display = 'inline-block';
        printBtn.onclick = () => printOrder(orderId);
      }
      
      if (status.includes('approved')) {
        packBtn.style.display = 'inline-block';
        packBtn.onclick = () => {
          const packModal = bootstrap.Modal.getOrCreateInstance('#packModal');
          document.getElementById('packForm').action = `/dashboard/cod_dispatch/orders/${orderId}/packed`;
          packModal.show();
        };
      } else if (status.includes('packed')) {
        dispatchBtn.style.display = 'inline-block';
        dispatchBtn.onclick = () => {
          const dispatchModal = bootstrap.Modal.getOrCreateInstance('#dispatchModal');
          document.getElementById('dispatchForm').action = `/dashboard/cod_dispatch/orders/${orderId}/dispatched`;
          dispatchModal.show();
        };
      }
    }

    // Initialize modals
    const packModal = document.getElementById('packModal');
    const dispatchModal = document.getElementById('dispatchModal');
    const holdModal = document.getElementById('holdModal');
    if (packModal) {
      packModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const orderId = button.getAttribute('data-order-id');
        document.getElementById('packForm').action = `/dashboard/cod_dispatch/orders/${orderId}/packed`;
      });
    }

    if (dispatchModal) {
      dispatchModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const orderId = button.getAttribute('data-order-id');
        document.getElementById('dispatchForm').action = `/dashboard/cod_dispatch/orders/${orderId}/dispatched`;
      });
    }

    if (holdModal) {
      holdModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const orderId = button.getAttribute('data-order-id');
        document.getElementById('holdForm').action = `/dashboard/cod_dispatch/orders/${orderId}/hold`;
        // Clear previous input
        document.getElementById('holdReason').value = '';
      });
    }

    document.querySelectorAll('.print-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        printOrder(orderId);
      });
    });

    // Print order function
    function printOrder(orderId) {
      window.open(`/dashboard/cod_dispatch/orders/${orderId}/print`, '_blank');
    }

    // Show/hide custom date range based on selection
    const dateFilter = document.getElementById('dateFilter');
    const customDateRange = document.getElementById('customDateRange');
    
    dateFilter.addEventListener('change', function() {
      customDateRange.style.display = this.value === 'custom' ? 'flex' : 'none';
    });

    // Set default dates for custom range if empty
    const dateFromInput = document.querySelector('input[name="dateFrom"]');
    const dateToInput = document.querySelector('input[name="dateTo"]');
    
    if (dateFilter.value === 'custom' && !dateFromInput.value) {
      const today = new Date();
      const oneWeekAgo = new Date();
      oneWeekAgo.setDate(today.getDate() - 7);
      
      dateFromInput.valueAsDate = oneWeekAgo;
      dateToInput.valueAsDate = today;
    }
  });
</script>