<%- include('../../partials/header') %>

<style>
  /* Custom date range styling */
  #customDateRange {
    transition: all 0.3s ease;
    align-items: center;
    gap: 5px;
  }

  #customDateRange .col-md-6 {
    padding-left: 5px;
    padding-right: 5px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    #customDateRange {
      flex-direction: column;
      gap: 10px;
    }
    
    #customDateRange .col-md-6 {
      width: 100%;
      padding-left: 0;
      padding-right: 0;
    }
  }
  .card-hover:hover {
    transform: translateY(-2px);
    transition: transform 0.2s ease;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }
  
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  .avatar-text {
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }
  
  .badge {
    padding: 0.35em 0.65em;
    font-weight: 500;
  }
</style>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
      <i class="bi bi-cash-coin me-2"></i>COD Accountant Dashboard
    </h2>
    <!-- <div class="d-flex align-items-center">
      <span class="badge bg-light text-dark me-3">
        <i class="bi bi-inbox me-1"></i> 
        Total Orders: <%= typeof totalOrders !== 'undefined' ? totalOrders : orders.length %>
      </span>
      <div class="input-group input-group-sm" style="width: 250px;">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="Search..." id="quickSearch">
      </div>
    </div> -->
  </div>

<!-- Status Cards -->
  <div class="row mb-3">
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'active' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'active' ? 'border-primary' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Active Orders</h6>
                <h3 class="mb-0"><%= typeof activeCount !== 'undefined' ? activeCount : orders.filter(o => o.companyStatus === 'active').length %></h3>
              </div>
              <div class="bg-primary bg-opacity-10 p-3 rounded">
                <i class="bi bi-hourglass-split text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'reviewed' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'reviewed' ? 'border-info' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Reviewed Orders</h6>
                <h3 class="mb-0"><%= reviewedCount %></h3>
              </div>
              <div class="bg-info bg-opacity-10 p-3 rounded">
                <i class="bi bi-check2-square text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'processing' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'processing' ? 'border-warning' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Processing Orders</h6>
                <h3 class="mb-0"><%= processingCount %></h3>
              </div>
              <div class="bg-warning bg-opacity-10 p-3 rounded">
                <i class="bi bi-gear text-warning fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="?<%= getFilterQueryString({ status: 'completed' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'completed' ? 'border-success' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Completed Orders</h6>
                <h3 class="mb-0"><%= completedCount %></h3>
              </div>
              <div class="bg-success bg-opacity-10 p-3 rounded">
                <i class="bi bi-check-circle text-success fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

<!-- Filter and Search Section -->
  <div class="card mb-4">
    <div class="card-body p-3">
      <form id="filterForm" class="row g-3 align-items-center">
        <div class="col-md-4">
          <label for="searchInput" class="form-label">Search Orders</label>
          <div class="input-group">
            <input type="text" class="form-control" id="searchInput" name="search" 
                  placeholder="Customer, Contact, orderReference" value="<%= searchQuery %>">
            <button class="btn btn-outline-secondary" type="submit">
              <i class="bi bi-search"></i>
            </button>
          </div>
        </div>
        
        <div class="col-md-3">
          <label for="dateFilter" class="form-label">Date Range</label>
          <select class="form-select" id="dateFilter" name="dateRange">
            <option value="">All Time</option>
            <option value="today" <%= dateRange === 'today' ? 'selected' : '' %>>Today</option>
            <option value="week" <%= dateRange === 'week' ? 'selected' : '' %>>This Week</option>
            <option value="month" <%= dateRange === 'month' ? 'selected' : '' %>>This Month</option>
            <option value="custom" <%= dateRange === 'custom' ? 'selected' : '' %>>Custom Range</option>
          </select>
          
          <!-- Custom Date Range Inputs -->
          <div id="customDateRange" class="row g-2 mt-2" style="display: <%= dateRange === 'custom' ? 'flex' : 'none' %>;">
            <div class="col-md-6">
              <input type="date" class="form-control" name="dateFrom" value="<%= dateFrom || '' %>">
            </div>
            <div class="col-md-6">
              <input type="date" class="form-control" name="dateTo" value="<%= dateTo || '' %>">
            </div>
          </div>
        </div>
        
          <div class="col-md-3">
            <label for="amountFilter" class="form-label">Amount Filter</label>
            <div class="input-group">
              <select class="form-select" id="amountFilter" name="amountRange">
                <option value="">All Amounts</option>
                <option value="0-1000" <%= amountRange === '0-1000' ? 'selected' : '' %>>₹0 - ₹1000</option>
                <option value="1000-5000" <%= amountRange === '1000-5000' ? 'selected' : '' %>>₹1000 - ₹5000</option>
                <option value="5000+" <%= amountRange === '5000+' ? 'selected' : '' %>>₹5000+</option>
                <option value="exact" <%= amountRange === 'exact' ? 'selected' : '' %>>Exact Amount</option>
              </select>
              <input type="number" 
                    class="form-control <%= amountRange === 'exact' ? '' : 'd-none' %>" 
                    id="exactAmountInput" 
                    name="exactAmount" 
                    placeholder="Enter amount"
                    value="<%= exactAmount %>">
            </div>
          </div>
        
          <div class="col-md-2 d-flex flex-wrap align-items-end gap-2">
            <button type="submit" class="btn btn-primary me-2"> 
              <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <button type="button" id="exportBtn" class="btn btn-success me-2">
              <i class="bi bi-file-excel me-1"></i> Export
            </button>
            <a href="?" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
            <% if (currentStatus === 'completed') { %>
              <a href="/dashboard/cod_accountant/orders/bulk-print?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>" 
                class="btn btn-primary">
                <i class="bi bi-download"></i> ZIP
              </a>
            <% } %>
          </div>
        <input type="hidden" name="status" value="<%= currentStatus %>">
      </form>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Order ID</th>
              <th>Customer</th>
              <th>Contact</th>
              <th>Amount</th>
              <th>Date</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr class="<%= order.isBillOnHold ? 'table-warning' : '' %>">
                <td class="ps-4 fw-bold">
                  <a href="#" class="text-decoration-none view-order-link" data-order-id="<%= order._id %>">
                    #<%= order.orderReference || order._id.toString().slice(-6).toUpperCase() %>
                  </a>
                </td>

                <td>
                  <div class="d-flex align-items-center">
                    <div>
                      <h6 class="mb-0"><%= order.customerName %></h6>
                      <small class="text-muted"><%= order.customerGSTIN || '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= order.customerContact %></td>
                <td class="fw-bold">₹<%= order.total.toLocaleString('en-IN') %></td>
                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= getStatusBadgeColor(order.companyStatus) %>">
                    <i class="bi <%= getStatusIcon(order.companyStatus) %> me-1"></i>
                    <%= order.companyStatus.replace('_', ' ') %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <div class="btn-group btn-group-sm" role="group">
                    <button class="btn btn-outline-primary view-order-btn" 
                            data-order-id="<%= order._id %>"
                            title="View Details">
                      <i class="bi bi-eye"></i>
                    </button>
                    
                    <% if (order.companyStatus === 'accountant_review') { %>
                      <button class="btn btn-outline-success" 
                              data-bs-toggle="modal" 
                              data-bs-target="#shippingLabelsModal" 
                              data-order-id="<%= order._id %>"
                              title="Approve Order">
                        <i class="bi bi-check-circle"></i>
                      </button>

                      <!-- Cancel Order Button -->
                      <button class="btn btn-outline-danger cancel-order-btn" 
                              data-order-id="<%= order._id %>" 
                              title="Cancel Order">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    <% } else if (order.companyStatus === 'dispatch_packed') { %>
                      <button class="btn btn-outline-info" 
                              data-bs-toggle="modal" 
                              data-bs-target="#trackingModal" 
                              data-order-id="<%= order._id %>"
                              title="Add Tracking">
                        <i class="bi bi-truck"></i>
                      </button>
                    <% } %>

                    <% if (order.companyStatus !== 'created') { %>
                      <button class="btn btn-outline-secondary print-btn" 
                              data-order-id="<%= order._id %>"
                              title="Print Invoice">
                        <i class="bi bi-printer"></i>
                      </button>
                    <% } %>

                    <% if (order.companyStatus === 'dispatched') { %>
                      <!-- Mark Payment Button -->
                      <button class="btn btn-outline-warning" 
                              data-bs-toggle="modal" 
                              data-bs-target="#codPaymentModal" 
                              data-order-id="<%= order._id %>" 
                              title="Mark Payment as Received">
                        <i class="bi bi-cash-coin"></i>
                      </button>
                      <button class="btn btn-outline-info" 
                              data-bs-toggle="modal" 
                              data-bs-target="#trackingModal" 
                              data-order-id="<%= order._id %>"
                              title="Add Tracking">
                        <i class="bi bi-truck"></i>
                      </button>
                      <% } %>
                      <% if (order.isBillOnHold || order.companyStatus === 'dispatched') { %>
                        <!-- Cancel Order Button -->
                        <button class="btn btn-outline-danger cancel-order-btn" 
                                data-order-id="<%= order._id %>" 
                                title="Cancel Order">
                          <i class="bi bi-x-circle"></i>
                        </button>
                      <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      
      <% if (orders.length === 0) { %>
        <div class="text-center py-5">
          <img src="https://img.freepik.com/free-vector/empty-concept-illustration_114360-1188.jpg?uid=R55028212&ga=GA1.1.497053720.1738572050&semt=ais_items_boosted&w=740" alt="No orders" style="height: 150px;" class="mb-3">
          <h5 class="text-muted">No orders found</h5>
          <p class="text-muted">Try adjusting your search or filter criteria</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        <% if (currentPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= currentPage - 1 %>">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>
        <% } %>
        
        <% const maxVisiblePages = 5;
          let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
          let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
          
          if (endPage - startPage + 1 < maxVisiblePages) {
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
          }
          
          if (startPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=1">1</a>
          </li>
          <% if (startPage > 2) { %>
            <li class="page-item disabled">
              <span class="page-link">...</span>
            </li>
          <% } %>
        <% } %>
        
        <% for (let i = startPage; i <= endPage; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= i %>"><%= i %></a>
          </li>
        <% } %>
        
        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <li class="page-item disabled">
              <span class="page-link">...</span>
            </li>
          <% } %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= totalPages %>"><%= totalPages %></a>
          </li>
        <% } %>
        
        <% if (currentPage < totalPages) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= currentPage + 1 %>">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>

<!-- Add this Order Details Modal before your closing </body> tag -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-file-text me-2"></i>
          Order Details: <span id="orderIdHeader"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="orderDetailsContent">
        <!-- Content will be loaded via AJAX -->
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i> Close
        </button>
        <button type="button" class="btn btn-primary" id="approveInModalBtn" style="display: none;">
          <i class="bi bi-check-circle me-1"></i> Approve Order
        </button>
        <button type="button" class="btn btn-info text-white" id="trackingInModalBtn" style="display: none;">
          <i class="bi bi-truck me-1"></i> Add Tracking
        </button>
        <button type="button" class="btn btn-success" id="printInModalBtn">
          <i class="bi bi-printer me-1"></i> Print Invoice
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Review Order Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-check-circle-fill text-primary me-2"></i>Review Order
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="reviewForm" method="POST">
        <div class="modal-body">
          <!-- <div class="mb-3">
            <label class="form-label">Order Reference Number</label>
            <input type="text" name="orderReference" class="form-control" required>
          </div> -->
          
          <div class="mb-3">
            <label class="form-label">Company Name</label>
            <select name="companyName" class="form-select" required>
              <option value="">Select Company</option>
              <option value="POSIFLOW">POSIFLOW</option>
              <option value="Shreyans">Shreyans</option>
              <option value="SR GOLD">SR GOLD</option>
            </select>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Payment Mode</label>
            <select name="paymentMode" class="form-select" required>
              <option value="">Select Payment Mode</option>
              <optgroup label="Shreyans">
                <option value="Shreyans Retail Solution">Shreyans Retail Solution</option>
              </optgroup>
              <optgroup label="POSIFLOW">
                <option value="POSIFLOW ICICI">POSIFLOW ICICI</option>
                <option value="POSIFLOW Kotak">POSIFLOW Kotak</option>
                <option value="AXIS BANK LTD">AXIS BANK LTD</option>
                <option value="POSIFLOW RETAIL PRIVATE LIMITED">POSIFLOW RETAIL PRIVATE LIMITED</option>
                <option value="Cash">Cash</option>
                <option value="CREDIT BASE">CREDIT BASE</option>
              </optgroup>
            </select>
          </div>
          
          <div class="mb-3" id="cashSubOptionContainer" style="display: none;">
            <label class="form-label">Cash Sub Option</label>
            <select name="cashSubOption" class="form-select">
              <option value="">Select Sub Option</option>
              <option value="Dhaval Jain HUF">Dhaval Jain HUF</option>
              <option value="Arvind Jain HUF">Arvind Jain HUF</option>
            </select>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Shipping Type</label>
            <select name="shippingType" class="form-select">
              <option value="">Select Shipping Provider</option>
              <option value="Critica">Critica</option>
              <option value="Blue Dart">Blue Dart</option>
              <option value="ShipRocket">ShipRocket</option>
              <option value="PORTER">PORTER</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-primary" id="reviewButton">
            <i class="bi bi-check-circle me-1"></i> Mark as Reviewed
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Upload Shipping Labels Modal -->
<div class="modal fade" id="shippingLabelsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-file-earmark-pdf-fill text-primary me-2"></i>Upload Shipping Labels
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="shippingLabelsForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Shipping Labels</label>
            <input 
              type="file" 
              name="shippingLabels" 
              class="form-control" 
              accept=".pdf,.jpg,.jpeg,.png" 
              multiple
              required
            >
            <small class="text-muted">Upload multiple PDF or image files (max 5)</small>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-success" id="uploadLabelsButton">
            <i class="bi bi-upload me-1"></i> Upload & Mark as Approved
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Tracking Modal -->
<div class="modal fade" id="trackingModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-truck text-info me-2"></i>Add Tracking ID
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="trackingForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tracking ID</label>
            <input type="text" name="trackingId" class="form-control" placeholder="Enter tracking number" required>
          </div>
           <!-- Hidden fields to preserve filters -->
          <input type="hidden" name="status" value="<%= currentStatus %>">
          <input type="hidden" name="search" value="<%= searchQuery %>">
          <input type="hidden" name="dateRange" value="<%= dateRange %>">
          <input type="hidden" name="amountRange" value="<%= amountRange %>">
          <input type="hidden" name="dateFrom" value="<%= dateFrom %>">
          <input type="hidden" name="dateTo" value="<%= dateTo %>">
          <input type="hidden" name="page" value="<%= currentPage %>">
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-info text-white">
            <i class="bi bi-save me-1"></i> Save Tracking
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- COD Payment Modal -->
<div class="modal fade" id="codPaymentModal" tabindex="-1" aria-labelledby="codPaymentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form method="POST" action="/dashboard/cod_accountant/orders/mark-payment">
      <input type="hidden" name="orderId" id="codPaymentOrderId">
      <!-- Hidden fields to preserve filters -->
      <input type="hidden" name="status" value="<%= currentStatus %>">
      <input type="hidden" name="search" value="<%= searchQuery %>">
      <input type="hidden" name="dateRange" value="<%= dateRange %>">
      <input type="hidden" name="amountRange" value="<%= amountRange %>">
      <input type="hidden" name="dateFrom" value="<%= dateFrom %>">
      <input type="hidden" name="dateTo" value="<%= dateTo %>">
      <input type="hidden" name="page" value="<%= currentPage %>">
      
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Mark Payment as Received</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Payment Date</label>
            <input type="date" name="paymentDate" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Payment Time</label>
            <input type="time" name="paymentTime" class="form-control" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-success">Mark as Paid & Deliver</button>
        </div>
      </div>
    </form>
  </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Check if Bootstrap is loaded
    if (typeof bootstrap === 'undefined') {
      console.error('Bootstrap JS is not loaded!');
      return;
    }

    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
    tooltipTriggerList.forEach(function (tooltipTriggerEl) {
      new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Initialize amount filter functionality
      const amountFilter = document.getElementById('amountFilter');
      const exactAmountInput = document.getElementById('exactAmountInput');
      
      if (amountFilter && exactAmountInput) {
        // Show/hide exact amount input based on selection
        amountFilter.addEventListener('change', function() {
          exactAmountInput.classList.toggle('d-none', this.value !== 'exact');
          
          // If switching away from exact amount, clear the input
          if (this.value !== 'exact') {
            exactAmountInput.value = '';
          }
        });
        
        // Initialize visibility on page load
        exactAmountInput.classList.toggle('d-none', amountFilter.value !== 'exact');
      }

    // Handle form submission with all filters
    document.getElementById('filterForm')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      const params = new URLSearchParams(formData).toString();
      window.location.href = `?${params}`;
    });

    // Quick search functionality
    document.getElementById('quickSearch')?.addEventListener('keyup', function(e) {
      if (e.key === 'Enter') {
        const searchValue = this.value.trim();
        const params = new URLSearchParams(window.location.search);
        params.set('search', searchValue);
        window.location.href = `?${params.toString()}`;
      }
    });

   // Handle both order ID click and view button click
    document.querySelectorAll('.view-order-btn, .view-order-link').forEach(element => {
      element.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        loadOrderDetails(orderId);
      });
    });

    // Print button click handler
    document.querySelectorAll('.print-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        printOrder(orderId);
      });
    });


    // Enhanced loadOrderDetails function
    async function loadOrderDetails(orderId) {
      try {
        const orderDetailsModal = new bootstrap.Modal('#orderDetailsModal');
        const orderDetailsContent = document.getElementById('orderDetailsContent');
        
        // Show loading state
        orderDetailsContent.innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-2">Loading order details...</div>
          </div>
        `;

        orderDetailsModal.show();

        const response = await fetch(`/dashboard/cod_accountant/orders/${orderId}/details`);
        const data = await response.text();
        
        if (!response.ok) {
          throw new Error(data.error || 'Failed to load order');
        }

        orderDetailsContent.innerHTML = data;
        setupModalActionButtons(orderId);

      } catch (error) {
        console.error('Load order error:', error);
        document.getElementById('orderDetailsContent').innerHTML = `
          <div class="alert alert-danger m-3">
            <i class="bi bi-exclamation-octagon me-2"></i>
            <strong>Error loading order</strong>
            <div class="mt-2">${error.message}</div>
            <button class="btn btn-sm btn-outline-secondary mt-3" onclick="loadOrderDetails('${orderId}')">
              <i class="bi bi-arrow-clockwise"></i> Try Again
            </button>
          </div>
        `;
      }
    }
    
    // Set up action buttons in the modal
    function setupModalActionButtons(orderId) {
      const approveBtn = document.getElementById('approveInModalBtn');
      const trackingBtn = document.getElementById('trackingInModalBtn');
      const printBtn = document.getElementById('printInModalBtn');
      
      // Reset buttons
      approveBtn.style.display = 'none';
      trackingBtn.style.display = 'none';
      
      // Always set up print button
      printBtn.onclick = () => printOrder(orderId);
      
      // Check order status from the loaded content
      const statusBadge = document.querySelector('#orderDetailsContent .badge');
      if (!statusBadge) return;
      
      const status = statusBadge.textContent.trim().toLowerCase();
      
      if (status.includes('created')) {
        approveBtn.style.display = 'inline-block';
        approveBtn.onclick = () => {
          const reviewModal = bootstrap.Modal.getOrCreateInstance('#reviewModal');
          document.getElementById('reviewForm').action = `/dashboard/cod_accountant/orders/${orderId}/approve`;
          reviewModal.show();
        };
      } else if (status.includes('approved') || status.includes('packed')) {
        trackingBtn.style.display = 'inline-block';
        trackingBtn.onclick = () => {
          // Set the order ID before showing the modal
          window.currentOrderId = orderId;
          const trackingModal = bootstrap.Modal.getOrCreateInstance('#trackingModal');
          trackingModal.show();
        };
      }
    }
      
    // Print order function
    function printOrder(orderId) {
      window.open(`/dashboard/cod_accountant/orders/${orderId}/print`, '_blank');
    }

    // Initialize approve and tracking modals
    const trackingModal = document.getElementById('trackingModal');
    // Initialize review and shipping labels modals
    const reviewModal = document.getElementById('reviewModal');

    if (reviewModal) {
      reviewModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        if (!button) return;

        let orderId = button.getAttribute('data-order-id');
        const reviewForm = document.getElementById('reviewForm');

        // Toggle cash sub-option display
        document.querySelector('select[name="paymentMode"]')?.addEventListener('change', function() {
          const container = document.getElementById('cashSubOptionContainer');
          if (container) {
            container.style.display = this.value === 'Cash' ? 'block' : 'none';
          }
        });

        // Attach submit handler for review form
        reviewForm.onsubmit = async function(e) {
          e.preventDefault();

          const form = e.target;
          const reviewButton = form.querySelector('button[type="submit"]');

          reviewButton.disabled = true;
          reviewButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processing...';

          try {
            // Prepare review data
            const reviewData = {
              // orderReference: form.orderReference.value,
              companyName: form.companyName.value,
              paymentMode: form.paymentMode.value,
              cashSubOption: form.cashSubOption?.value || null,
              shippingType: form.shippingType.value
            };

            // Submit review
            const reviewResponse = await fetch(`/dashboard/cod_accountant/orders/${orderId}/approve`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(reviewData)
            });

            if (!reviewResponse.ok) {
              const errorData = await reviewResponse.json().catch(() => ({}));
              throw new Error(errorData.error || 'Order review failed');
            }

            // After successful review, show shipping labels modal
            const reviewModalInstance = bootstrap.Modal.getInstance(reviewModal);
            reviewModalInstance.hide();
            
            const shippingLabelsModalInstance = bootstrap.Modal.getOrCreateInstance('#shippingLabelsModal');
            shippingLabelsModalInstance.show();
          } catch (error) {
            console.error('Error:', error);
            alert(error.message || 'There was an error processing your request.');
          } finally {
            reviewButton.disabled = false;
            reviewButton.innerHTML = '<i class="bi bi-check-circle me-1"></i> Mark as Reviewed';
          }
        };
      });
    }

    const shippingLabelsModal = document.getElementById('shippingLabelsModal');
    if (shippingLabelsModal) {
      shippingLabelsModal.addEventListener('show.bs.modal', function(event) {
        // Get the button that triggered the modal
        const button = event.relatedTarget;
        
        // Get the order ID from the button's data attribute
        const orderId = button.getAttribute('data-order-id');
        
        // Log for debugging
        // console.log('Shipping labels modal opened for order:', orderId);

        const form = document.getElementById('shippingLabelsForm');
        const uploadButton = form.querySelector('button[type="submit"]');
        const fileInput = form.querySelector('input[type="file"][name="shippingLabels"]');

        form.onsubmit = async function(e) {
          e.preventDefault();
          
          // Validate order ID exists
          if (!orderId) {
            alert('Error: Could not determine order ID');
            return;
          }

          uploadButton.disabled = true;
          uploadButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Uploading...';

          try {
            const files = fileInput.files;
            if (files.length === 0) {
              throw new Error('Please select at least one file');
            }

            const uploadFormData = new FormData();
            for (let i = 0; i < files.length; i++) {
              uploadFormData.append('shippingLabels', files[i]);
            }

            // console.log('Uploading files for order:', orderId);
            
            const uploadResponse = await fetch(`/api/file/orders/${orderId}/shipping-labels`, {
              method: 'POST',
              body: uploadFormData
            });

            if (!uploadResponse.ok) {
              const errorData = await uploadResponse.json().catch(() => ({}));
              console.error('Upload failed:', {
                status: uploadResponse.status,
                statusText: uploadResponse.statusText,
                errorData
              });
              throw new Error(errorData.error || `Upload failed (${uploadResponse.status})`);
            }
            
            const shippingLabelsModalInstance = bootstrap.Modal.getInstance(shippingLabelsModal);
            shippingLabelsModalInstance.hide();
            window.location.reload();
            
          } catch (error) {
            console.error('Upload error:', error);
            alert(`Upload failed: ${error.message}`);
          } finally {
            uploadButton.disabled = false;
            uploadButton.innerHTML = '<i class="bi bi-upload me-1"></i> Upload & Mark as Approved';
          }
        };
      });
    }
    
    if (trackingModal) {
      trackingModal.addEventListener('show.bs.modal', function(event) {
        // Get order ID either from relatedTarget or from the global variable
        let orderId;
        
        if (event.relatedTarget) {
          // When modal is opened via button click
          orderId = event.relatedTarget.getAttribute('data-order-id');
        } else {
          // When modal is opened programmatically
          orderId = window.currentOrderId; // We'll set this before showing the modal
        }
        
        if (!orderId) {
          console.error('No order ID found for tracking modal');
          return;
        }
        
        const form = document.getElementById('trackingForm');
        form.action = `/dashboard/cod_accountant/orders/${orderId}/tracking`;
        
        // Set current filter values as hidden inputs
        const currentStatus = '<%= currentStatus %>';
        const searchQuery = '<%= searchQuery %>';
        const dateRange = '<%= dateRange %>';
        const amountRange = '<%= amountRange %>';
        const dateFrom = '<%= dateFrom %>';
        const dateTo = '<%= dateTo %>';
        const currentPage = <%= currentPage || 1 %>;
        
        // Create or update hidden inputs
        const hiddenFields = {
          status: currentStatus,
          search: searchQuery,
          dateRange: dateRange,
          amountRange: amountRange,
          dateFrom: dateFrom,
          dateTo: dateTo,
          page: currentPage
        };
        
        for (const [name, value] of Object.entries(hiddenFields)) {
          let input = form.querySelector(`input[name="${name}"]`);
          if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            form.appendChild(input);
          }
          input.value = value;
        }
      });
    }

    document.querySelector('select[name="paymentMode"]').addEventListener('change', function() {
      const cashSubOptionContainer = document.getElementById('cashSubOptionContainer');
      cashSubOptionContainer.style.display = this.value === 'Cash' ? 'block' : 'none';
    });

    // Show/hide custom date range based on selection
    const dateFilter = document.getElementById('dateFilter');
    const customDateRange = document.getElementById('customDateRange');
    
    dateFilter.addEventListener('change', function() {
      customDateRange.style.display = this.value === 'custom' ? 'flex' : 'none';
    });

    // Set default dates for custom range if empty
    const dateFromInput = document.querySelector('input[name="dateFrom"]');
    const dateToInput = document.querySelector('input[name="dateTo"]');
    
    if (dateFilter.value === 'custom' && !dateFromInput.value) {
      const today = new Date();
      const oneWeekAgo = new Date();
      oneWeekAgo.setDate(today.getDate() - 7);
      
      dateFromInput.valueAsDate = oneWeekAgo;
      dateToInput.valueAsDate = today;
    }

    document.getElementById('exportBtn').addEventListener('click', function() {
      // Get all form data
      const formData = new FormData(document.getElementById('filterForm'));
      const params = new URLSearchParams();
      
      // Add all form values to params
      for (const [key, value] of formData.entries()) {
        if (value) { // Only add if value exists
          params.append(key, value);
        }
      }
      
      // Add current status if not already in params
      if (!params.has('status')) {
        const status = document.querySelector('input[name="status"]').value;
        if (status) {
          params.append('status', status);
        }
      }
      
      // Trigger download
      window.location.href = `/dashboard/cod_accountant/orders/cod/export?${params.toString()}`;
    });
    
    // Show/hide custom date range based on selection
    document.getElementById('dateFilter').addEventListener('change', function() {
      const customDateRange = document.getElementById('customDateRange');
      customDateRange.style.display = this.value === 'custom' ? 'flex' : 'none';
    });

  // Initialize COD Payment Modal
  const codPaymentModal = document.getElementById('codPaymentModal');
  if (codPaymentModal) {
    codPaymentModal.addEventListener('show.bs.modal', function(event) {
      const button = event.relatedTarget;
      const orderId = button.getAttribute('data-order-id');
      document.getElementById('codPaymentOrderId').value = orderId;
      
      // Set current filter values as hidden inputs
      const form = this.querySelector('form');
      const currentStatus = '<%= currentStatus %>';
      const searchQuery = '<%= searchQuery %>';
      const dateRange = '<%= dateRange %>';
      const amountRange = '<%= amountRange %>';
      const dateFrom = '<%= dateFrom %>';
      const dateTo = '<%= dateTo %>';
      const currentPage = <%= currentPage || 1 %>;
      
      // Create or update hidden inputs
      const hiddenFields = {
        status: currentStatus,
        search: searchQuery,
        dateRange: dateRange,
        amountRange: amountRange,
        dateFrom: dateFrom,
        dateTo: dateTo,
        page: currentPage
      };
      
      for (const [name, value] of Object.entries(hiddenFields)) {
        let input = form.querySelector(`input[name="${name}"]`);
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          form.appendChild(input);
        }
        input.value = value;
      }
    });
  }
    // Cancel order confirmation
    document.querySelectorAll('.cancel-order-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const orderId = btn.getAttribute('data-order-id');
        if (confirm('Are you sure you want to cancel this order?')) {
          fetch(`/dashboard/cod_accountant/orders/${orderId}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          }).then(res => {
            if (res.ok) location.reload();
            else alert('Failed to cancel order');
          });
        }
      });
    });
  });
</script>