                <div class="card h-100">
                  <div class="card-body text-center">
                    <h6 class="text-muted">Total Revenue</h6>
                    <h3 class="text-success" id="memberTotalRevenue">₹0.00</h3>
                  </div>
                </div>
              </div>
            </div>
            <div class="card">
              <div class="card-header">
                <h6 class="mb-0">Performance Details</h6>
