<!-- Orders Modal -->
<div class="modal fade" id="ordersModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Salesperson Orders</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <!-- Search and Filter -->
        <div class="row mb-3">
          <div class="col-md-6">
            <div class="input-group">
              <input type="text" class="form-control" placeholder="Search orders..." id="ordersSearchInput">
              <button class="btn btn-outline-secondary" type="button" id="ordersSearchBtn">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </div>
          <div class="col-md-6">
            <div class="input-group">
              <input type="date" class="form-control" id="ordersFromDate">
              <span class="input-group-text">to</span>
              <input type="date" class="form-control" id="ordersToDate">
              <button class="btn btn-primary" type="button" id="applyDateFilterBtn">
                Apply
              </button>
            </div>
          </div>
        </div>
        
        <!-- Orders Table -->
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Products</th>
                <th>Type</th>
                <th>Total (₹)</th>
                <th>Payment</th>
                <th>Courier</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="ordersTableBody">
              <!-- Orders will be loaded here -->
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3">
          <div class="text-muted" id="ordersPaginationInfo">
            Showing 0 to 0 of 0 entries
          </div>
          <ul class="pagination mb-0" id="ordersPagination">
            <!-- Pagination will be added here -->
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentSalesPersonId = null;
  let currentOrdersPage = 1;
  const ordersPerPage = 10;

  // Helper: read current date range from URL (fallback to inputs)
  function getCurrentDateParams() {
    const qp = new URLSearchParams(window.location.search);
    let fromDate = qp.get('fromDate');
    let toDate   = qp.get('toDate');

    // Fallback: read from inputs if URL doesn't have them
    if (!fromDate) {
      const fromEl = document.getElementById('fromDate');
      if (fromEl && fromEl.value) fromDate = fromEl.value;
    }
    if (!toDate) {
      const toEl = document.getElementById('toDate');
      if (toEl && toEl.value) toDate = toEl.value;
    }

    const params = new URLSearchParams();
    if (fromDate) params.set('fromDate', fromDate);
    if (toDate)   params.set('toDate', toDate);
    return params;
  }

  // INR formatter guard
  function inr(n){ try { return Number(n ?? 0).toLocaleString('en-IN'); } catch { return n; } }

  document.getElementById('loadStatsBtn').addEventListener('click', async () => {
    const btn = document.getElementById('loadStatsBtn');
    const statsContainer = document.getElementById('statsContainer');
    const salesTable = document.querySelector('.sales-persons-table tbody');
    const prodTable  = document.querySelector('.products-table tbody');

    try {
      btn.disabled = true;
      btn.textContent = 'Loading...';

      // Build endpoint with date range
      const dateParams = getCurrentDateParams();
      const qs = dateParams.toString();
      // Make sure this path matches your router.get('/admin/api/admin/stats', ...)
      const res = await fetch(`/dashboard/admin/api/admin/stats${qs ? `?${qs}` : ''}`, { credentials: 'same-origin' });
      const data = await res.json();

      if (!data.success) throw new Error(data.message || 'Failed to load stats');

      const { allSalesPersons = [], allProducts = [] } = data.stats || {};

      // Render Sales Persons
      salesTable.innerHTML = allSalesPersons.length
        ? allSalesPersons.map((sp, i) => `
            <tr>
              <td>${i + 1}</td>
              <td>${sp.name || '-'}</td>
              <td>${sp.totalOrders ?? 0}</td>
              <td>₹${inr(sp.totalRevenue)}</td>
            </tr>
          `).join('')
        : `<tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr>`;

      // Render Products
      prodTable.innerHTML = allProducts.length
        ? allProducts.map((p, i) => `
            <tr>
              <td>${i + 1}</td>
              <td>${p.name || '-'}</td>
              <td>${p.totalSold ?? 0}</td>
              <td>₹${inr(p.totalRevenue)}</td>
            </tr>
          `).join('')
        : `<tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr>`;

      statsContainer.style.display = 'block';
      btn.style.display = 'none';
    } catch (err) {
      console.error(err);
      alert('Failed to load stats');
      btn.textContent = 'Load Stats';
      btn.disabled = false;
    }
  });
  
  // Function to show orders modal
  function showOrdersModal(salesPersonId, salesPersonName) {
    currentSalesPersonId = salesPersonId;
    currentOrdersPage = 1;
    
    // Set modal title
    document.querySelector('#ordersModal .modal-title').textContent = 
      `${salesPersonName}'s Orders`;
    
    // Reset search and filters
    document.getElementById('ordersSearchInput').value = '';
    document.getElementById('ordersFromDate').value = '';
    document.getElementById('ordersToDate').value = '';
    
    // Load orders
    loadSalesPersonOrders();
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('ordersModal'));
    modal.show();
  }

  // Function to load orders
  async function loadSalesPersonOrders() {
    const searchTerm = document.getElementById('ordersSearchInput').value;
    const fromDate = document.getElementById('ordersFromDate').value;
    const toDate = document.getElementById('ordersToDate').value;
    
    // Build query params
    const params = new URLSearchParams();
    params.append('salesPerson', currentSalesPersonId);
    params.append('page', currentOrdersPage);
    params.append('limit', ordersPerPage);
    if (searchTerm) params.append('search', searchTerm);
    if (fromDate) params.append('fromDate', fromDate);
    if (toDate) params.append('toDate', toDate);
    
    try {
      // Show loading state
      document.getElementById('ordersTableBody').innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </td>
        </tr>
      `;
      
      const response = await fetch(`/api/orders1?${params.toString()}`);
      const data = await response.json();
      
      if (data.success) {
        renderOrdersTable(data.orders);
        renderOrdersPagination(data.totalOrders, data.currentPage, data.totalPages);
      } else {
        throw new Error(data.message || 'Failed to load orders');
      }
    } catch (error) {
      console.error('Error loading orders:', error);
      document.getElementById('ordersTableBody').innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-4 text-danger">
            <i class="fas fa-exclamation-circle me-2"></i>
            Failed to load orders. Please try again.
          </td>
        </tr>
      `;
    }
  }

  // Function to render orders table
  function renderOrdersTable(orders) {
    const tableBody = document.getElementById('ordersTableBody');
    
    if (orders.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-4 text-muted">
            No orders found for this salesperson
          </td>
        </tr>
      `;
      return;
    }
    
    let html = '';
    
    orders.forEach(order => {
      // Enhanced products list display
      const productsList = order.items.length > 0 
        ? `
          <div class="products-container">
            ${order.items.map(item => {
              const productName = item.productName || (item.product && item.product.name) || 'Unknown Product';
              return `
                <div class="product-item">
                  <span class="product-name">${productName}</span>
                  <div class="product-details">
                    <span class="badge bg-light text-dark">Qty: ${item.quantity}</span>
                    <span class="badge bg-light text-dark">₹${item.price.toFixed(2)}</span>
                    <span class="badge bg-light text-dark">Total: ₹${(item.price * item.quantity).toFixed(2)}</span>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        `
        : '<span class="text-muted">No products</span>';
      
      html += `
        <tr>
          <td>${order.orderReference || order._id.toString().slice(-6).toUpperCase()}</td>
          <td>${new Date(order.createdAt).toLocaleDateString()}</td>
          <td class="products-cell">${productsList}</td>
          <td>
            <span class="badge ${order.orderType === 'cod' ? 'bg-warning' : 'bg-success'}">
              ${order.orderType.toUpperCase()}
            </span>
          </td>
          <td>₹${order.total.toFixed(2)}</td>
          <td>
            <span class="badge ${order.paymentStatus === 'verified' ? 'bg-success' : 'bg-secondary'}">
              ${order.paymentStatus ? order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1) : 'Pending'}
            </span>
          </td>
          <td>
            ${order.shippingType ? `
              <span class="badge 
                ${order.shippingType === 'Critica' ? 'bg-danger' : 
                  order.shippingType === 'Blue Dart' ? 'bg-primary' : 
                  order.shippingType === 'ShipRocket' ? 'bg-success' : 
                  order.shippingType === 'PORTER' ? 'bg-warning text-dark' : 'bg-secondary'}">
                ${order.shippingType}
              </span>
            ` : '<span class="text-muted">-</span>'}
          </td>
          <td>
            <span class="badge bg-company-${order.companyStatus}">
              ${order.companyStatus.split('_').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}
            </span>
          </td>
        </tr>
      `;
    });
    
    tableBody.innerHTML = html;
  }

  // Function to render pagination
  function renderOrdersPagination(totalOrders, currentPage, totalPages) {
    const paginationInfo = document.getElementById('ordersPaginationInfo');
    const start = (currentPage - 1) * ordersPerPage + 1;
    const end = Math.min(currentPage * ordersPerPage, totalOrders);
    
    paginationInfo.textContent = `Showing ${start} to ${end} of ${totalOrders} entries`;
    
    const pagination = document.getElementById('ordersPagination');
    pagination.innerHTML = '';
    
    if (totalPages <= 1) return;
    
    // Previous button
    const prevLi = document.createElement('li');
    prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
    prevLi.innerHTML = `<a class="page-link" href="#" ${currentPage === 1 ? 'tabindex="-1" aria-disabled="true"' : ''}>&laquo;</a>`;
    prevLi.addEventListener('click', (e) => {
      e.preventDefault();
      if (currentPage > 1) {
        currentOrdersPage--;
        loadSalesPersonOrders();
      }
    });
    pagination.appendChild(prevLi);
    
    // Page numbers
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);
    
    for (let i = startPage; i <= endPage; i++) {
      const pageLi = document.createElement('li');
      pageLi.className = `page-item ${i === currentPage ? 'active' : ''}`;
      pageLi.innerHTML = `<a class="page-link" href="#">${i}</a>`;
      pageLi.addEventListener('click', (e) => {
        e.preventDefault();
        currentOrdersPage = i;
        loadSalesPersonOrders();
      });
      pagination.appendChild(pageLi);
    }
    
    // Next button
    const nextLi = document.createElement('li');
    nextLi.className = `page-item ${currentPage >= totalPages ? 'disabled' : ''}`;
    nextLi.innerHTML = `<a class="page-link" href="#" ${currentPage >= totalPages ? 'tabindex="-1" aria-disabled="true"' : ''}>&raquo;</a>`;
    nextLi.addEventListener('click', (e) => {
      e.preventDefault();
      if (currentPage < totalPages) {
        currentOrdersPage++;
        loadSalesPersonOrders();
      }
    });
    pagination.appendChild(nextLi);
  }

  // Initialize event listeners
  document.addEventListener('DOMContentLoaded', function() {
    // Orders search
    document.getElementById('ordersSearchBtn').addEventListener('click', function() {
      currentOrdersPage = 1;
      loadSalesPersonOrders();
    });

    document.getElementById('ordersSearchInput').addEventListener('keyup', function(e) {
      if (e.key === 'Enter') {
        currentOrdersPage = 1;
        loadSalesPersonOrders();
      }
    });

    // Date filter (for the orders modal)
    document.getElementById('applyDateFilterBtn').addEventListener('click', function() {
      currentOrdersPage = 1;
      loadSalesPersonOrders();
    });

    // On page load, highlight the correct tab based on URL (?period=...)
    const params = new URLSearchParams(window.location.search);
    let period = params.get('period');

    if (!period) {
      // Infer if someone hits a bookmarked URL without 'period'
      const from = params.get('fromDate');
      const to   = params.get('toDate');
      const todayStr = fmt(new Date());
      const now = new Date();

      if (!from && !to) period = 'all';
      else if (from === todayStr && to === todayStr) period = 'today';
      else {
        const weekStart = fmt(getWeekStartMonday(now));
        const monthStart = fmt(new Date(now.getFullYear(), now.getMonth(), 1));
        const yearStart = fmt(new Date(now.getFullYear(), 0, 1));
        if (from === weekStart && to === todayStr)      period = 'week';
        else if (from === monthStart && to === todayStr) period = 'month';
        else if (from === yearStart && to === todayStr)  period = 'year';
        else                                             period = 'custom';
      }
    }

    setActivePeriodTab(period);
  });

  function resetDateFilter() {
    // reset to today (so tab highlight is correct)
    filterData('today');
  }

  // ===== Helpers =====
  function fmt(d) {
    const z = n => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}`;
  }

  function setActivePeriodTab(period) {
    document.querySelectorAll('#periodTabs .period-tab').forEach(t => {
      t.classList.toggle('active', t.dataset.period === period);
    });
  }

  function getWeekStartMonday(date = new Date()) {
    const d = new Date(date);
    const day = (d.getDay() + 6) % 7; // Mon=0..Sun=6  (for Sunday start: use d.getDay())
    d.setDate(d.getDate() - day);
    d.setHours(0,0,0,0);
    return d;
  }

  // ===== Filters (tabs + custom date) =====
  function filterData(period) {
    const params = new URLSearchParams(window.location.search);
    const today = new Date();
    const toDate = fmt(today);
    let fromDate;

    switch (period) {
      case 'today':
        fromDate = toDate;
        params.set('fromDate', fromDate);
        params.set('toDate', toDate);
        break;

      case 'week': {
        const first = getWeekStartMonday(today);
        fromDate = fmt(first);
        params.set('fromDate', fromDate);
        params.set('toDate', toDate);
        break;
      }

      case 'month': {
        const first = new Date(today.getFullYear(), today.getMonth(), 1);
        fromDate = fmt(first);
        params.set('fromDate', fromDate);
        params.set('toDate', toDate);
        break;
      }

      case 'year': {
        const first = new Date(today.getFullYear(), 0, 1);
        fromDate = fmt(first);
        params.set('fromDate', fromDate);
        params.set('toDate', toDate);
        break;
      }

      case 'all':
        params.delete('fromDate');
        params.delete('toDate');
        break;
    }

    params.set('period', period);
    window.location.href = `/dashboard/admin?${params.toString()}`;
  }
  
  function applyDateFilter() {
    const fromDate = document.getElementById('fromDate').value || '';
    const toDate   = document.getElementById('toDate').value   || '';

    if (fromDate && toDate && new Date(fromDate) > new Date(toDate)) {
      alert('End date must be after start date');
      return;
    }

    const params = new URLSearchParams(window.location.search);
    if (fromDate) params.set('fromDate', fromDate); else params.delete('fromDate');
    if (toDate)   params.set('toDate', toDate);     else params.delete('toDate');
    params.set('period', 'custom');
    window.location.href = `/dashboard/admin?${params.toString()}`;
  }

  function toggleTeamMembers(card, teamId) {
    const membersSection = card.querySelector('.team-members');
    membersSection.style.display = membersSection.style.display === 'block' ? 'none' : 'block';
    
    // If showing, load data if not already loaded
    if (membersSection.style.display === 'block' && membersSection.innerHTML.includes('Loading...')) {
      fetchTeamMembers(teamId, membersSection);
    }
  }

  function showTeamMemberModal(memberData, teamId) {
    // Set modal content
    document.getElementById('memberAvatar').textContent = memberData.name.charAt(0).toUpperCase();
    document.getElementById('memberName').textContent = memberData.name;
    document.getElementById('memberTeam').textContent = teamId;
    document.getElementById('memberTotalOrders').textContent = memberData.orderCount;
    document.getElementById('memberTotalRevenue').textContent = `₹${memberData.revenue.toLocaleString('en-IN')}`;
    document.getElementById('memberSubtotal').textContent = `₹${memberData.subtotal.toLocaleString('en-IN')}`;
    document.getElementById('memberTax').textContent = `₹${memberData.tax.toLocaleString('en-IN')}`;
    document.getElementById('memberAvgOrder').textContent = `₹${(memberData.revenue / memberData.orderCount).toFixed(2)}`;
    document.getElementById('memberRank').textContent = `#${memberData.rank || 1}`;
    
    // Set up the "View All Orders" button
    document.getElementById('viewMemberOrdersBtn').onclick = function() {
      showOrdersModal(memberData._id, memberData.name);
      
      // Hide the current modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('teamMemberModal'));
      modal.hide();
    };
    
    // Show the modal
    const modal = new bootstrap.Modal(document.getElementById('teamMemberModal'));
    modal.show();
  }

  async function fetchTeamMembers(teamId, element) {
    try {
      const response = await fetch(`/api/teams/${teamId}/members`);
      const data = await response.json();
      
      let html = '<h4>Top Performers:</h4>';
      if (data.length > 0) {
        data.forEach(member => {
          html += `
            <div class="team-member">
              <span class="member-name">${member.name}</span>
              <span class="member-value">₹${member.revenue.toLocaleString('en-IN')}</span>
            </div>
          `;
        });
      } else {
        html += '<p>No data available</p>';
      }
      
      element.innerHTML = html;
    } catch (error) {
      console.error('Error fetching team members:', error);
      element.innerHTML = '<p>Error loading data</p>';
    }
  }

  // Simple chart buttons functionality
  document.querySelectorAll('.chart-actions button').forEach(button => {
    button.addEventListener('click', function() {
      this.parentElement.querySelectorAll('button').forEach(btn => {
        btn.classList.remove('active');
      });
      this.classList.add('active');
      // Here you would typically fetch new data based on the selection
      // For now we're just demonstrating the UI interaction
    });
  });
</script>

