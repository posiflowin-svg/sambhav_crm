                <div class="row">
                  <div class="col-md-6">
                    <p class="mb-1"><strong>Subtotal:</strong> <span id="memberSubtotal">₹0.00</span></p>
                    <p class="mb-1"><strong>Tax:</strong> <span id="memberTax">₹0.00</span></p>
                  </div>
