<%- include('../../partials/header') %>

<style>
  /* Custom date range styling */
  #customDateRange {
    transition: all 0.3s ease;
    align-items: center;
    gap: 5px;
  }

  #customDateRange .col-md-6 {
    padding-left: 5px;
    padding-right: 5px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    #customDateRange {
      flex-direction: column;
      gap: 10px;
    }
    
    #customDateRange .col-md-6 {
      width: 100%;
      padding-left: 0;
      padding-right: 0;
    }
  }
  .card-hover:hover {
    transform: translateY(-2px);
    transition: transform 0.2s ease;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }
  
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  .avatar-text {
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }
  
  .badge {
    padding: 0.35em 0.65em;
    font-weight: 500;
  }
</style>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
      <i class="bi bi-credit-card me-2"></i>Prepaid Accountant Dashboard
    </h2>
  </div>

  <!-- Status Cards -->
  <div class="row mb-4">
    <div class="col-md-4">
      <a href="?<%= getFilterQueryString({ status: 'active' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'active' ? 'border-primary' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Active Orders</h6>
                <h3 class="mb-0"><%= typeof activeCount !== 'undefined' ? activeCount : orders.filter(o => o.companyStatus === 'active').length %></h3>
              </div>
              <div class="bg-primary bg-opacity-10 p-3 rounded">
                <i class="bi bi-hourglass-split text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a href="?<%= getFilterQueryString({ status: 'processing' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'processing' ? 'border-warning' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Processing Orders</h6>
                <h3 class="mb-0"><%= processingCount %></h3>
              </div>
              <div class="bg-warning bg-opacity-10 p-3 rounded">
                <i class="bi bi-gear text-warning fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a href="?<%= getFilterQueryString({ status: 'completed' }) %>" class="text-decoration-none">
        <div class="card card-hover <%= currentStatus === 'completed' ? 'border-success' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1 text-muted">Completed Orders</h6>
                <h3 class="mb-0"><%= completedCount %></h3>
              </div>
              <div class="bg-success bg-opacity-10 p-3 rounded">
                <i class="bi bi-check-circle text-success fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Filter and Search Section -->
  <div class="card mb-4">
    <div class="card-body p-3">
      <form id="filterForm" class="row g-3 align-items-center">
        <div class="col-md-4">
          <label for="searchInput" class="form-label">Search Orders</label>
          <div class="input-group">
            <input type="text" class="form-control" id="searchInput" name="search" 
                  placeholder="Customer, Contact, orderReference" value="<%= searchQuery %>">
            <button class="btn btn-outline-secondary" type="submit">
              <i class="bi bi-search"></i>
            </button>
          </div>
        </div>
        
        <div class="col-md-3">
          <label for="dateFilter" class="form-label">Date Range</label>
          <select class="form-select" id="dateFilter" name="dateRange">
            <option value="">All Time</option>
            <option value="today" <%= dateRange === 'today' ? 'selected' : '' %>>Today</option>
            <option value="week" <%= dateRange === 'week' ? 'selected' : '' %>>This Week</option>
            <option value="month" <%= dateRange === 'month' ? 'selected' : '' %>>This Month</option>
            <option value="custom" <%= dateRange === 'custom' ? 'selected' : '' %>>Custom Range</option>
          </select>
          
          <!-- Custom Date Range Inputs -->
          <div id="customDateRange" class="row g-2 mt-2" style="display: <%= dateRange === 'custom' ? 'flex' : 'none' %>;">
            <div class="col-md-6">
              <input type="date" class="form-control" name="dateFrom" value="<%= dateFrom || '' %>">
            </div>
            <div class="col-md-6">
              <input type="date" class="form-control" name="dateTo" value="<%= dateTo || '' %>">
            </div>
          </div>
        </div>
        
        <div class="col-md-3">
          <label for="amountFilter" class="form-label">Amount Filter</label>
          <div class="input-group">
            <select class="form-select" id="amountFilter" name="amountRange">
              <option value="">All Amounts</option>
              <option value="0-1000" <%= amountRange === '0-1000' ? 'selected' : '' %>>₹0 - ₹1000</option>
              <option value="1000-5000" <%= amountRange === '1000-5000' ? 'selected' : '' %>>₹1000 - ₹5000</option>
              <option value="5000+" <%= amountRange === '5000+' ? 'selected' : '' %>>₹5000+</option>
              <option value="exact" <%= amountRange === 'exact' ? 'selected' : '' %>>Exact Amount</option>
            </select>
            <input type="number" 
                  class="form-control <%= amountRange === 'exact' ? '' : 'd-none' %>" 
                  id="exactAmountInput" 
                  name="exactAmount" 
                  placeholder="Enter amount"
                  value="<%= exactAmount %>">
          </div>
        </div>
        
        <div class="col-md-2 d-flex flex-wrap align-items-end gap-2">
          <button type="submit" class="btn btn-primary me-2"> 
            <i class="bi bi-funnel me-1"></i> Filter
          </button>
          <button type="button" id="exportBtn" class="btn btn-success me-2">
            <i class="bi bi-file-excel me-1"></i> Export
          </button>
          <a href="?" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-counterclockwise"></i>
          </a>
          <% if (currentStatus === 'completed') { %>
            <a href="/dashboard/prepaid_accountant/orders/bulk-print?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>" 
              class="btn btn-primary">
              <i class="bi bi-download"></i> ZIP
            </a>
          <% } %>
        </div>
        <input type="hidden" name="status" value="<%= currentStatus %>">
      </form>
    </div>
  </div>
  <!-- Orders Table -->
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Order ID</th>
              <th>Customer</th>
              <th>Contact</th>
              <th>Amount</th>
              <th>Date</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr class="<%= order.isBillOnHold ? 'table-warning' : '' %>">
                <td class="ps-4 fw-bold">
                  <a href="#" class="text-decoration-none view-order-link" data-order-id="<%= order._id %>">
                    #<%= order.orderReference || order._id.toString().slice(-6).toUpperCase() %>
                  </a>
                </td>

                <td>
                  <div class="d-flex align-items-center">
                    <div>
                      <h6 class="mb-0"><%= order.customerName %></h6>
                      <small class="text-muted"><%= order.customerGSTIN || '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= order.customerContact %></td>
                <td class="fw-bold">₹<%= order.total.toLocaleString('en-IN') %></td>
                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= getStatusBadgeColor(order.companyStatus) %>">
                    <i class="bi <%= getStatusIcon(order.companyStatus) %> me-1"></i>
                    <%= order.companyStatus.replace('_', ' ') %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <div class="btn-group btn-group-sm" role="group">
                    <button class="btn btn-outline-primary view-order-btn" 
                            data-order-id="<%= order._id %>"
                            title="View Details">
                      <i class="bi bi-eye"></i>
                    </button>
                    
                    <% if (order.companyStatus === 'created' || order.companyStatus === 'accountant_review') { %>
                      <button class="btn btn-outline-success" 
                              data-bs-toggle="modal" 
                              data-bs-target="#approveModal" 
                              data-order-id="<%= order._id %>"
                              title="Approve Order">
                        <i class="bi bi-check-circle"></i>
                      </button>
                    <% } else if (order.companyStatus === 'dispatch_packed') { %>
                      <button class="btn btn-outline-info" 
                              data-bs-toggle="modal" 
                              data-bs-target="#trackingModal" 
                              data-order-id="<%= order._id %>"
                              title="Add Tracking">
                        <i class="bi bi-truck"></i>
                      </button>
                    <% } %>

                    <% if (order.companyStatus !== 'created') { %>
                      <button class="btn btn-outline-secondary print-btn" 
                              data-order-id="<%= order._id %>"
                              title="Print Invoice">
                        <i class="bi bi-printer"></i>
                      </button>
                    <% } %>

                    <% if (order.companyStatus === 'dispatched' && order.orderType === 'prepaid') { %>
                      <button class="btn btn-outline-success mark-delivered-btn" 
                              data-order-id="<%= order._id %>" 
                              title="Mark as Delivered">
                        <i class="bi bi-box-seam"></i>
                      </button>
                    <% } %>
                    <% if (order.isBillOnHold || order.companyStatus === 'dispatched') { %>
                      <!-- Cancel Order Button -->
                      <button class="btn btn-outline-danger cancel-order-btn" 
                              data-order-id="<%= order._id %>" 
                              title="Cancel Order">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      
      <% if (orders.length === 0) { %>
        <div class="text-center py-5">
          <img src="https://img.freepik.com/free-vector/empty-concept-illustration_114360-1188.jpg?uid=R55028212&ga=GA1.1.497053720.1738572050&semt=ais_items_boosted&w=740" alt="No orders" style="height: 150px;" class="mb-3">
          <h5 class="text-muted">No orders found</h5>
          <p class="text-muted">Try adjusting your search or filter criteria</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        <% if (currentPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= currentPage - 1 %>">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>
        <% } %>
        
        <% const maxVisiblePages = 5;
          let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
          let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
          
          if (endPage - startPage + 1 < maxVisiblePages) {
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
          }
          
          if (startPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=1">1</a>
          </li>
          <% if (startPage > 2) { %>
            <li class="page-item disabled">
              <span class="page-link">...</span>
            </li>
          <% } %>
        <% } %>
        
        <% for (let i = startPage; i <= endPage; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= i %>"><%= i %></a>
          </li>
        <% } %>
        
        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <li class="page-item disabled">
              <span class="page-link">...</span>
            </li>
          <% } %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= totalPages %>"><%= totalPages %></a>
          </li>
        <% } %>
        
        <% if (currentPage < totalPages) { %>
          <li class="page-item">
            <a class="page-link" href="?status=<%= currentStatus %>&search=<%= searchQuery %>&dateRange=<%= dateRange %>&amountRange=<%= amountRange %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&page=<%= currentPage + 1 %>">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>

<!-- Order Details Modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-file-text me-2"></i>
          Order Details: <span id="orderIdHeader"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="orderDetailsContent">
        <!-- Content will be loaded via AJAX -->
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i> Close
        </button>
        <button type="button" class="btn btn-primary" id="approveInModalBtn" style="display: none;">
          <i class="bi bi-check-circle me-1"></i> Approve Order
        </button>
        <button type="button" class="btn btn-info text-white" id="trackingInModalBtn" style="display: none;">
          <i class="bi bi-truck me-1"></i> Add Tracking
        </button>
        <button type="button" class="btn btn-success" id="printInModalBtn">
          <i class="bi bi-printer me-1"></i> Print Invoice
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Approve Order Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-check-circle-fill text-primary me-2"></i>Approve Order
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="approveForm" method="POST">
        <div class="modal-body">
          <!-- <div class="mb-3">
            <label class="form-label">Order Reference Number</label>
            <input type="text" name="orderReference" class="form-control" required>
          </div> -->
          
          <div class="mb-3">
            <label class="form-label">Company Name</label>
            <select name="companyName" class="form-select" required>
              <option value="">Select Company</option>
              <option value="POSIFLOW">POSIFLOW</option>
              <option value="Shreyans">Shreyans</option>
              <option value="SR GOLD">SR GOLD</option>
            </select>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Payment Mode</label>
            <select name="paymentMode" id="paymentModeSelect" class="form-select" required>
              <option value="">Select Payment Mode</option>
              <optgroup label="Shreyans">
                <option value="Shreyans Retail Solution">Shreyans Retail Solution</option>
              </optgroup>
              <optgroup label="POSIFLOW">
                <option value="POSIFLOW ICICI">POSIFLOW ICICI</option>
                <option value="POSIFLOW Kotak">POSIFLOW Kotak</option>
                <option value="AXIS BANK LTD">AXIS BANK LTD</option>
                <option value="POSIFLOW RETAIL PRIVATE LIMITED">POSIFLOW RETAIL PRIVATE LIMITED</option>
              </optgroup>
              <option value="Cash">Cash</option>
            </select>
          </div>

          <!-- Cash Sub Option (shown only when Cash is selected) -->
          <div class="mb-3" id="cashSubOptionGroup" style="display: none;">
            <label class="form-label">Cash Sub Option</label>
            <select name="cashSubOption" class="form-select">
              <option value="">Select Cash Sub Option</option>
              <option value="Dhaval Jain HUF">Dhaval Jain HUF</option>
              <option value="Arvind Jain HUF">Arvind Jain HUF</option>
              <option value="CASH IN HAND">CASH IN HAND</option>
            </select>
          </div>

          <!-- Payment Date and Time Fields -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Payment Date</label>
              <input type="date" name="paymentDate" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Payment Time</label>
              <input type="time" name="paymentTime" class="form-control" required>
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Shipping Type</label>
            <select name="shippingType" class="form-select">
              <option value="">Select Shipping Provider</option>
              <option value="Critica">Critica</option>
              <option value="Blue Dart">Blue Dart</option>
              <option value="ShipRocket">ShipRocket</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-1"></i> Approve Order
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Tracking Modal -->
<div class="modal fade" id="trackingModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title">
          <i class="bi bi-truck text-info me-2"></i>Add Tracking ID
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="trackingForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tracking ID</label>
            <input type="text" name="trackingId" class="form-control" placeholder="Enter tracking number" required>
          </div>
          <!-- Hidden fields to preserve filters -->
          <input type="hidden" name="status" value="<%= currentStatus %>">
          <input type="hidden" name="search" value="<%= searchQuery %>">
          <input type="hidden" name="dateRange" value="<%= dateRange %>">
          <input type="hidden" name="amountRange" value="<%= amountRange %>">
          <input type="hidden" name="dateFrom" value="<%= dateFrom %>">
          <input type="hidden" name="dateTo" value="<%= dateTo %>">
          <input type="hidden" name="page" value="<%= currentPage %>">
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-info text-white">
            <i class="bi bi-save me-1"></i> Save Tracking
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Check if Bootstrap is loaded
    if (typeof bootstrap === 'undefined') {
      console.error('Bootstrap JS is not loaded!');
      return;
    }

    // Initialize amount filter functionality
    const amountFilter = document.getElementById('amountFilter');
    const exactAmountInput = document.getElementById('exactAmountInput');
    
    if (amountFilter && exactAmountInput) {
      // Show/hide exact amount input based on selection
      amountFilter.addEventListener('change', function() {
        exactAmountInput.classList.toggle('d-none', this.value !== 'exact');
        
        // If switching away from exact amount, clear the input
        if (this.value !== 'exact') {
          exactAmountInput.value = '';
        }
      });
      
      // Initialize visibility on page load
      exactAmountInput.classList.toggle('d-none', amountFilter.value !== 'exact');
    }

    // Handle form submission with all filters
    document.getElementById('filterForm')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      const params = new URLSearchParams(formData).toString();
      window.location.href = `?${params}`;
    });

    // Handle both order ID click and view button click
    document.querySelectorAll('.view-order-btn, .view-order-link').forEach(element => {
      element.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        loadOrderDetails(orderId);
      });
    });

    // Print button click handler
    document.querySelectorAll('.print-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        printOrder(orderId);
      });
    });

    // Enhanced loadOrderDetails function
    async function loadOrderDetails(orderId) {
      try {
        const orderDetailsModal = new bootstrap.Modal('#orderDetailsModal');
        const orderDetailsContent = document.getElementById('orderDetailsContent');
        
        // Show loading state
        orderDetailsContent.innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-2">Loading order details...</div>
          </div>
        `;

        orderDetailsModal.show();

        const response = await fetch(`/dashboard/prepaid_accountant/orders/${orderId}/details`);
        const data = await response.text();
        
        if (!response.ok) {
          throw new Error(data.error || 'Failed to load order');
        }

        orderDetailsContent.innerHTML = data;
        setupModalActionButtons(orderId);

      } catch (error) {
        console.error('Load order error:', error);
        document.getElementById('orderDetailsContent').innerHTML = `
          <div class="alert alert-danger m-3">
            <i class="bi bi-exclamation-octagon me-2"></i>
            <strong>Error loading order</strong>
            <div class="mt-2">${error.message}</div>
            <button class="btn btn-sm btn-outline-secondary mt-3" onclick="loadOrderDetails('${orderId}')">
              <i class="bi bi-arrow-clockwise"></i> Try Again
            </button>
          </div>
        `;
      }
    }

    // Set up action buttons in the modal
    function setupModalActionButtons(orderId) {
      const approveBtn = document.getElementById('approveInModalBtn');
      const trackingBtn = document.getElementById('trackingInModalBtn');
      const printBtn = document.getElementById('printInModalBtn');
      
      // Reset buttons
      approveBtn.style.display = 'none';
      trackingBtn.style.display = 'none';
      
      // Always set up print button
      printBtn.onclick = () => printOrder(orderId);
      
      // Check order status from the loaded content
      const statusBadge = document.querySelector('#orderDetailsContent .badge');
      if (!statusBadge) return;
      
      const status = statusBadge.textContent.trim().toLowerCase();
      
      if (status.includes('created') || status.includes('review')) {
        approveBtn.style.display = 'inline-block';
        approveBtn.onclick = () => {
          const approveModal = bootstrap.Modal.getOrCreateInstance('#approveModal');
          document.getElementById('approveForm').action = `/dashboard/prepaid_accountant/orders/${orderId}/approve`;
          approveModal.show();
        };
      } else if (status.includes('approved')) {
        trackingBtn.style.display = 'inline-block';
        trackingBtn.onclick = () => {
          // Set the order ID before showing the modal
          window.currentOrderId = orderId;
          const trackingModal = bootstrap.Modal.getOrCreateInstance('#trackingModal');
          trackingModal.show();
        };
      }
    }
        
// Print order function
    function printOrder(orderId) {
      window.open(`/dashboard/prepaid_accountant/orders/${orderId}/print`, '_blank');
    }

    // Initialize approve and tracking modals
    const approveModal = document.getElementById('approveModal');

    if (approveModal) {
      approveModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const orderId = button.getAttribute('data-order-id');
        document.getElementById('approveForm').action = `/dashboard/prepaid_accountant/orders/${orderId}/approve`;
      });
    }

    // Tracking modal event listener
    const trackingModal = document.getElementById('trackingModal');
    if (trackingModal) {
      trackingModal.addEventListener('show.bs.modal', function(event) {
        // Get order ID either from relatedTarget or from the global variable
        let orderId;
        
        if (event.relatedTarget) {
          // When modal is opened via button click
          orderId = event.relatedTarget.getAttribute('data-order-id');
        } else {
          // When modal is opened programmatically
          orderId = window.currentOrderId;
        }
        
        if (!orderId) {
          console.error('No order ID found for tracking modal');
          return;
        }
        
        const form = document.getElementById('trackingForm');
        form.action = `/dashboard/prepaid_accountant/orders/${orderId}/tracking`;
        
        // Set current filter values as hidden inputs
        const currentStatus = '<%= currentStatus %>';
        const searchQuery = '<%= searchQuery %>';
        const dateRange = '<%= dateRange %>';
        const amountRange = '<%= amountRange %>';
        const dateFrom = '<%= dateFrom %>';
        const dateTo = '<%= dateTo %>';
        const currentPage = <%= currentPage || 1 %>;
        
        // Create or update hidden inputs
        const hiddenFields = {
          status: currentStatus,
          search: searchQuery,
          dateRange: dateRange,
          amountRange: amountRange,
          dateFrom: dateFrom,
          dateTo: dateTo,
          page: currentPage
        };
        
        for (const [name, value] of Object.entries(hiddenFields)) {
          let input = form.querySelector(`input[name="${name}"]`);
          if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            form.appendChild(input);
          }
          input.value = value;
        }
      });
    }
    
    document.getElementById('paymentModeSelect').addEventListener('change', function() {
      const cashSubOptionGroup = document.getElementById('cashSubOptionGroup');
      cashSubOptionGroup.style.display = this.value === 'Cash' ? 'block' : 'none';
    });

    // Show/hide custom date range based on selection
    const dateFilter = document.getElementById('dateFilter');
    const customDateRange = document.getElementById('customDateRange');
    
    dateFilter.addEventListener('change', function() {
      customDateRange.style.display = this.value === 'custom' ? 'flex' : 'none';
    });

    // Set default dates for custom range if empty
    const dateFromInput = document.querySelector('input[name="dateFrom"]');
    const dateToInput = document.querySelector('input[name="dateTo"]');
    
    if (dateFilter.value === 'custom' && !dateFromInput.value) {
      const today = new Date();
      const oneWeekAgo = new Date();
      oneWeekAgo.setDate(today.getDate() - 7);
      
      dateFromInput.valueAsDate = oneWeekAgo;
      dateToInput.valueAsDate = today;
    }

    document.getElementById('exportBtn').addEventListener('click', function() {
      // Get all form data
      const formData = new FormData(document.getElementById('filterForm'));
      const params = new URLSearchParams();
      
      // Add all form values to params
      for (const [key, value] of formData.entries()) {
        if (value) { // Only add if value exists
          params.append(key, value);
        }
      }
      
      // Add current status if not already in params
      if (!params.has('status')) {
        const status = document.querySelector('input[name="status"]').value;
        if (status) {
          params.append('status', status);
        }
      }
      
      // Trigger download
      window.location.href = `/dashboard/prepaid_accountant/orders/prepaid/export?${params.toString()}`;
    });
    
    // Show/hide custom date range based on selection
    document.getElementById('dateFilter').addEventListener('change', function() {
      const customDateRange = document.getElementById('customDateRange');
      customDateRange.style.display = this.value === 'custom' ? 'flex' : 'none';
    });

    document.querySelectorAll('.mark-delivered-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const orderId = btn.getAttribute('data-order-id');
        if (confirm('Are you sure you want to mark this order as delivered?')) {
          fetch(`/dashboard/prepaid_accountant/orders/${orderId}/deliver`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          }).then(res => {
            if (res.ok) location.reload();
            else alert('Failed to mark as delivered');
          });
        }
      });
    });

    // Cancel order confirmation
    document.querySelectorAll('.cancel-order-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const orderId = btn.getAttribute('data-order-id');
        if (confirm('Are you sure you want to cancel this order?')) {
          fetch(`/dashboard/prepaid_accountant/orders/${orderId}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          }).then(res => {
            if (res.ok) location.reload();
            else alert('Failed to cancel order');
          });
        }
      });
    });
  });
</script>