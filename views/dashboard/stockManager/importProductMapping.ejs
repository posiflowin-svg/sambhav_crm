<%- include('../../partials/header', { title: 'Import Product Mapping' }) %>

<div class="container-fluid px-4 py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Import Product Mapping</h1>
      <div class="text-muted">Map Posiflow PI SKUs to Sambhav Stock Manager products.</div>
    </div>
    <a class="btn btn-outline-secondary" href="/dashboard/stock_manager/import-receiving">Import Receiving</a>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-header"><strong>Create / Change Mapping</strong></div>
    <div class="card-body">
      <form method="POST" action="/dashboard/stock_manager/product-mapping" class="row g-3 align-items-end">
        <div class="col-lg-5">
          <label class="form-label">Posiflow Product</label>
          <input type="search" class="form-control mb-2" id="sourceProductSearch" placeholder="Search Posiflow SKU / product name..." autocomplete="off">
          <select class="form-select" name="sourceSku" id="sourceSku" required>
            <option value="">Select source product...</option>
            <% sourceProducts.forEach(p => { %>
              <option value="<%= p.sku %>" data-name="<%= p.name %>"><%= p.sku %> · <%= p.name %></option>
            <% }) %>
          </select>
          <input type="hidden" name="sourceProductName" id="sourceProductName">
        </div>
        <div class="col-lg-5">
          <label class="form-label">Sambhav Stock Product</label>
          <input type="search" class="form-control mb-2" id="sambhavProductSearch" placeholder="Search Sambhav SKU / product name..." autocomplete="off">
          <select class="form-select" name="productId" id="sambhavProductId" required>
            <option value="">Select Sambhav product...</option>
            <% products.forEach(p => { %>
              <option value="<%= p._id %>"><%= p.itemCode %> · <%= p.itemName %> · Stock <%= p.stockQuantity %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-2 d-grid"><button class="btn btn-success">Save Mapping</button></div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body border-bottom">
      <input type="search" class="form-control" id="mappingTableSearch" placeholder="Search saved mapping by Posiflow SKU, product name or Sambhav product..." autocomplete="off">
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark"><tr><th>Posiflow SKU</th><th>Posiflow Product</th><th>Sambhav Product</th><th>Stock</th></tr></thead>
        <tbody>
          <% if (!mappings.length) { %><tr><td colspan="4" class="text-center text-muted py-5">No mappings yet.</td></tr><% } %>
          <% mappings.forEach(m => { %>
            <tr class="mapping-row">
              <td><strong><%= m.sourceSku %></strong></td>
              <td><%= m.sourceProductName || '-' %></td>
              <td><%= m.sambhavProduct ? `${m.sambhavProduct.itemCode} · ${m.sambhavProduct.itemName}` : 'Deleted' %></td>
              <td><%= m.sambhavProduct ? m.sambhavProduct.stockQuantity : '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
function attachSelectSearch(inputId, selectId) {
  const input = document.getElementById(inputId);
  const select = document.getElementById(selectId);
  if (!input || !select) return;

  const options = Array.from(select.options).map(function (option) {
    return {
      value: option.value,
      text: option.textContent,
      name: option.dataset ? option.dataset.name : '',
      disabled: option.disabled
    };
  });

  input.addEventListener('input', function () {
    const query = input.value.trim().toLowerCase();
    const currentValue = select.value;
    select.innerHTML = '';

    options.forEach(function (item, index) {
      if (index === 0 || !query || item.text.toLowerCase().includes(query)) {
        const option = document.createElement('option');
        option.value = item.value;
        option.textContent = item.text;
        option.disabled = item.disabled;
        if (item.name) option.dataset.name = item.name;
        select.appendChild(option);
      }
    });

    if (Array.from(select.options).some(function (o) { return o.value === currentValue; })) {
      select.value = currentValue;
    }
  });
}

attachSelectSearch('sourceProductSearch', 'sourceSku');
attachSelectSearch('sambhavProductSearch', 'sambhavProductId');

document.getElementById('sourceSku')?.addEventListener('change', function(){
  const option = this.options[this.selectedIndex];
  document.getElementById('sourceProductName').value = option?.dataset?.name || '';
});

document.getElementById('mappingTableSearch')?.addEventListener('input', function () {
  const query = this.value.trim().toLowerCase();
  document.querySelectorAll('.mapping-row').forEach(function (row) {
    row.style.display = !query || row.textContent.toLowerCase().includes(query) ? '' : 'none';
  });
});
</script>
