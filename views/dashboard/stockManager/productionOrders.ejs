<!-- views/dashboard/stockManager/productionOrders.ejs -->
<%- include('../../partials/header', { title: 'Manage Production Orders' }) %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Production Orders</h1>
        <div class="btn-group">
            <a href="/dashboard/stock_manager" class="btn btn-primary">Dashboard</a>
            <a href="/dashboard/stock_manager/products" class="btn btn-primary">Manage Products</a>
            <a href="/dashboard/stock_manager/raw-materials" class="btn btn-primary">Manage Raw Materials</a>
            <a href="/dashboard/stock_manager/production-orders" class="btn btn-success active">Production Orders</a>
                        <a href="/dashboard/stock_manager/importer-orders" class="btn btn-primary">Importer Orders</a>
        </div>  
    </div>

    <!-- Status Filter -->
    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div class="btn-group" role="group">
                <a href="/dashboard/stock_manager/production-orders" class="btn btn-<%= status === 'all' ? 'primary' : 'outline-primary' %>">All</a>
                <!-- <a href="/dashboard/stock_manager/production-orders?status=draft" class="btn btn-<%= status === 'draft' ? 'secondary' : 'outline-secondary' %>">Draft</a> -->
                <a href="/dashboard/stock_manager/production-orders?status=pending" class="btn btn-<%= status === 'pending' ? 'warning' : 'outline-warning' %>">Pending</a>
                <a href="/dashboard/stock_manager/production-orders?status=in_progress" class="btn btn-<%= status === 'in_progress' ? 'primary' : 'outline-primary' %>">In Progress</a>
                <a href="/dashboard/stock_manager/production-orders?status=completed" class="btn btn-<%= status === 'completed' ? 'success' : 'outline-success' %>">Completed</a>
                <a href="/dashboard/stock_manager/production-orders?status=cancelled" class="btn btn-<%= status === 'cancelled' ? 'danger' : 'outline-danger' %>">Cancelled</a>
            </div>
            <a href="/dashboard/stock_manager/production-orders/create" class="btn btn-success">
                <i class="fas fa-plus"></i> Create New PO
            </a>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Production Orders
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>PO Number</th>
                            <th>Product</th>
                            <th>Target Qty</th>
                            <th>Completed Qty</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td><%= order.poNumber %></td>
                                    <td><%= order.product.name %></td>
                                    <td><%= order.targetQuantity %></td>
                                    <td><%= order.completedQuantity || 0 %></td>
                                    <td>
                                        <span class="badge bg-<%= 
                                            order.status === 'completed' ? 'success' : 
                                            order.status === 'in_progress' ? 'primary' : 
                                            order.status === 'pending' ? 'warning' : 
                                            order.status === 'cancelled' ? 'danger' : 'secondary' %>">
                                            <%= order.status.replace('_', ' ') %>
                                        </span>
                                    </td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- View Button -->
                                            <a href="/dashboard/stock_manager/production-orders/<%= order._id %>" 
                                            class="btn btn-outline-primary d-flex align-items-center">
                                                <i class="fas fa-eye me-1"></i> View
                                            </a>
                                            
                                            <% if (order.status === 'draft' || order.status === 'pending') { %>
                                                <!-- Edit Button (commented out but styled) -->
                                                <!--
                                                <a href="/dashboard/stock_manager/production-orders/<%= order._id %>/edit" 
                                                class="btn btn-outline-primary d-flex align-items-center">
                                                    <i class="fas fa-edit me-1"></i> Edit
                                                </a>
                                                -->
                                                
                                                <!-- Delete Button with Confirmation -->
                                                <form action="/dashboard/stock_manager/production-orders/<%= order._id %>/delete" 
                                                    method="POST" class="d-inline"
                                                    onsubmit="return confirm('Are you sure you want to delete this production order? This action cannot be undone.')">
                                                    <button type="submit" 
                                                            class="btn btn-outline-danger d-flex align-items-center ms-1">
                                                        <i class="fas fa-trash-alt me-1"></i> Delete
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center">No production orders found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage - 1 %><%= status ? '&status=' + status : '' %>">Previous</a>
                            </li>
                        <% } %>
                        
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %><%= status ? '&status=' + status : '' %>"><%= i %></a>
                            </li>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %><%= status ? '&status=' + status : '' %>">Next</a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>