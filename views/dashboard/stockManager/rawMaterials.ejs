<!-- views/dashboard/stockManager/rawMaterials.ejs -->
<%- include('../../partials/header', { title: 'Manage Raw Materials' }) %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Manage Raw Materials</h1>
        <div class="btn-group">
            <a href="/dashboard/stock_manager" class="btn btn-primary">Dashboard</a>
            <a href="/dashboard/stock_manager/products" class="btn btn-primary">Manage Products</a>
            <a href="/dashboard/stock_manager/raw-materials" class="btn btn-success active">Manage Raw Materials</a>
            <a href="/dashboard/stock_manager/production-orders" class="btn btn-primary">Production Orders</a>
                        <a href="/dashboard/stock_manager/importer-orders" class="btn btn-primary">Importer Orders</a>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <input type="text" name="search" class="form-control" placeholder="Search materials..." value="<%= search %>">
                </div>
                <div class="col-md-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary me-2">Search</button>
                    <a href="/dashboard/stock_manager/raw-materials" class="btn btn-secondary me-2">Clear</a>
                    <a href="/dashboard/stock_manager/raw-materials/create" class="btn btn-success">
                        <i class="fas fa-plus"></i> Add New Material
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Materials Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Raw Materials List
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>SKU</th>
                            <th>Unit</th>
                            <th>Current Stock</th>
                            <th>Min Stock</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (materials.length > 0) { %>
                            <% materials.forEach(material => { %>
                                <tr>
                                    <td><%= material.name %></td>
                                    <td><%= material.sku %></td>
                                    <td><%= material.unit %></td>
                                    <td>
                                        <span class="badge bg-<%= material.currentStock > material.minimumStockLevel ? 'success' : material.currentStock > 0 ? 'warning' : 'danger' %>">
                                            <%= material.currentStock %>
                                        </span>
                                    </td>
                                    <td><%= material.minimumStockLevel %></td>
                                    <td>
                                        <span class="badge bg-<%= material.isActive ? 'success' : 'secondary' %>">
                                            <%= material.isActive ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <!-- Edit -->
                                            <a href="/dashboard/stock_manager/raw-materials/<%= material._id %>/edit" 
                                            class="btn btn-light border d-flex align-items-center">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>

                                            <!-- Stock -->
                                            <a href="/dashboard/stock_manager/raw-materials/<%= material._id %>/stock" 
                                            class="btn btn-light border d-flex align-items-center">
                                            <i class="bi bi-box-seam me-1"></i> Stock
                                            </a>

                                            <!-- Delete -->
                                            <form action="/dashboard/stock_manager/raw-materials/<%= material._id %>/delete" 
                                                method="POST" class="d-inline" 
                                                onsubmit="return confirm('Are you sure you want to delete this raw material? This action cannot be undone.')">
                                            <button type="submit" class="btn btn-light border d-flex align-items-center text-danger">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center">No raw materials found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>">Previous</a>
                            </li>
                        <% } %>
                        
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %><%= search ? '&search=' + search : '' %>"><%= i %></a>
                            </li>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>">Next</a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>