<!-- views/dashboard/stockManager/rawMaterials/stock.ejs -->
<%- include('../../../partials/header', { title: 'Manage Stock - ' + material.name }) %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Manage Stock - <%= material.name %></h1>
        <a href="/dashboard/stock_manager/raw-materials" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <!-- Error Messages -->
    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="mb-0">
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <!-- Current Stock Info -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">Current Stock</h5>
                    <h2 class="card-text"><%= material.currentStock %> <%= material.unit %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h5 class="card-title">Minimum Level</h5>
                    <h2 class="card-text"><%= material.minimumStockLevel %> <%= material.unit %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-<%= material.currentStock > material.minimumStockLevel ? 'success' : 'danger' %> text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">Status</h5>
                    <h2 class="card-text">
                        <%= material.currentStock > material.minimumStockLevel ? 'Adequate' : 'Low Stock' %>
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Adjustment Form -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-exchange-alt me-1"></i>
            Adjust Stock
        </div>
        <div class="card-body">
            <form method="POST" action="/dashboard/stock_manager/raw-materials/<%= material._id %>/stock">
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="action" class="form-label">Action *</label>
                            <select class="form-select" id="action" name="action" required>
                                <option value="">Select Action</option>
                                <option value="add">Add Stock</option>
                                <option value="remove">Remove Stock</option>
                                <!-- <option value="adjust">Adjust Stock</option> -->
                                <option value="damage">Record Damage</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantity *</label>
                            <input type="number" class="form-control" id="quantity" name="quantity" 
                                   min="1" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="description" class="form-label">Description *</label>
                            <input type="text" class="form-control" id="description" name="description" 
                                   placeholder="Reason for stock adjustment" required>
                        </div>
                    </div>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Update Stock</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Transaction History -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-history me-1"></i>
            Recent Stock Transactions
        </div>
        <div class="card-body">
            <% if (transactions.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Quantity</th>
                                <th>Description</th>
                                <th>Performed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% transactions.forEach(transaction => { %>
                                <tr>
                                    <td><%= new Date(transaction.createdAt).toLocaleString() %></td>
                                    <td>
                                        <span class="badge bg-<%= 
                                            transaction.type.includes('_in') ? 'success' : 
                                            transaction.type.includes('_out') ? 'danger' : 
                                            transaction.type === 'adjustment' ? 'warning' : 
                                            'secondary' %>">
                                            <%= transaction.type.replace(/_/g, ' ') %>
                                        </span>
                                    </td>
                                    <td><%= transaction.quantity %> <%= transaction.unit %></td>
                                    <td><%= transaction.description %></td>
                                    <td><%= transaction.performedBy.name %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="text-muted">No stock transactions found</p>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../../partials/footer') %>