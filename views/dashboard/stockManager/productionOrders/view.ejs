<!-- views/dashboard/stockManager/productionOrders/view.ejs -->
<%- include('../../../partials/header', { title: 'Production Order - ' + order.poNumber }) %>

<div class="container-fluid px-4">
    <!-- Page Title and Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Production Order: <%= order.poNumber %></h1>
        <div>
            <a href="/dashboard/stock_manager/production-orders" class="btn btn-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
            <% if (order.status === 'draft' || order.status === 'pending') { %>
            <!-- <a href="/dashboard/stock_manager/production-orders/<%= order._id %>/edit" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit Order
            </a> -->
            <% } %>
        </div>
    </div>

    <!-- Status Alert -->
    <% if (order.status === 'draft') { %>
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        <div>This production order is in <strong>draft</strong> status. It needs to be submitted for approval.</div>
    </div>
    <% } else if (order.status === 'pending') { %>
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="fas fa-clock me-2"></i>
        <div>This production order is <strong>pending approval</strong>. Waiting for manager approval.</div>
    </div>
    <% } else if (order.status === 'approved') { %>
    <div class="alert alert-primary d-flex align-items-center" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        <div>This production order has been <strong>approved</strong> and is ready to be started.</div>
    </div>
    <% } %>

    <!-- Order Details -->
    <div class="row mb-4">
        <!-- Order Information -->
         <!-- col-lg-4  -->
        <div class="mb-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-info-circle me-1"></i>
                    Order Information
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">PO Number:</div>
                        <div class="col-sm-8"><%= order.poNumber %></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Product:</div>
                        <div class="col-sm-8"><%= order.productName %></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Target Quantity:</div>
                        <div class="col-sm-8"><%= order.targetQuantity %> units</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Completed Quantity:</div>
                        <div class="col-sm-8"><%= order.completedQuantity || 0 %> units</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Progress:</div>
                        <div class="col-sm-8">
                            <% const progress = order.targetQuantity > 0 ? Math.min(100, Math.round((order.completedQuantity / order.targetQuantity) * 100)) : 0; %>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: <%= progress %>%;" 
                                     aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100">
                                    <%= progress %>%
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Status:</div>
                        <div class="col-sm-8">
                            <span class="badge bg-<%= 
                                order.status === 'completed' ? 'success' : 
                                order.status === 'in_progress' ? 'primary' : 
                                order.status === 'approved' ? 'info' :
                                order.status === 'pending' ? 'warning' : 
                                order.status === 'cancelled' ? 'danger' : 'secondary' %> text-capitalize">
                                <%= order.status.replace('_', ' ') %>
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Raised By:</div>
                        <div class="col-sm-8"><%= order.raisedBy.name %></div>
                    </div>
                    <% if (order.assignedTo && order.assignedTo.name) { %>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Assigned To:</div>
                        <div class="col-sm-8"><%= order.assignedTo.name %></div>
                    </div>
                    <% } %>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Created:</div>
                        <div class="col-sm-8"><%= new Date(order.createdAt).toLocaleString() %></div>
                    </div>
                    <% if (order.expectedCompletionDate) { %>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Expected Completion:</div>
                        <div class="col-sm-8"><%= new Date(order.expectedCompletionDate).toLocaleDateString() %></div>
                    </div>
                    <% } %>
                    <% if (order.actualCompletionDate) { %>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Actual Completion:</div>
                        <div class="col-sm-8"><%= new Date(order.actualCompletionDate).toLocaleString() %></div>
                    </div>
                    <% } %>
                    <% if (order.notes) { %>
                    <div class="row">
                        <div class="col-sm-4 fw-bold">Notes:</div>
                        <div class="col-sm-8"><%= order.notes %></div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Actions Panel -->
        <!-- <div class="col-lg-6 mb-4">
            <% if (order.status === 'approved') { %>
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
