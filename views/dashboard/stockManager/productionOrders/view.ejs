            </div>
            <% } %>
        </div> -->
    </div>

    <!-- Material Requirements -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-list-alt me-1"></i>
            Material Requirements
        </div>
        <div class="card-body p-0">
            <% if (order.materialRequirements && order.materialRequirements.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Raw Material</th>
                                <th>Required Quantity</th>
                                <th>Available Quantity</th>
                                <th>Missing Quantity</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.materialRequirements.forEach(req => { 
                                const isSufficient = req.availableQuantity >= req.requiredQuantity;
                            %>
                                <tr class="<%= isSufficient ? '' : 'table-warning' %>">
                                    <td><%= req.materialName %></td>
                                    <td><%= req.requiredQuantity %></td>
                                    <td><%= req.availableQuantity %></td>
                                    <td><%= req.missingQuantity %></td>
                                    <td>
                                        <span class="badge bg-<%= isSufficient ? 'success' : 'danger' %>">
                                            <%= isSufficient ? 'Sufficient' : 'Insufficient' %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="p-4 text-center text-muted">
                    <i class="fas fa-box-open fa-2x mb-2"></i>
                    <p>No material requirements defined for this production order</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Issues -->
    <% if (order.issues && order.issues.length > 0) { %>
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-exclamation-triangle me-1"></i>
            Production Issues
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Material Affected</th>
                            <th>Quantity Affected</th>
                            <th>Reported By</th>
                            <th>Reported At</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.issues.forEach(issue => { %>
                        <tr>
                            <td><%= issue.description %></td>
                            <td><%= issue.material ? issue.material.name : 'N/A' %></td>
                            <td><%= issue.quantityAffected %></td>
                            <td><%= issue.reportedBy ? issue.reportedBy.name : 'Unknown' %></td>
                            <td><%= new Date(issue.reportedAt).toLocaleString() %></td>
                            <td>
                                <span class="badge bg-<%= issue.resolved ? 'success' : 'warning' %>">
                                    <%= issue.resolved ? 'Resolved' : 'Pending' %>
                                </span>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <% } %>
</div>

<script>
// Add issue field dynamically
document.getElementById('add-issue')?.addEventListener('click', function() {
    const container = document.querySelector('.issue-container');
    const index = container.children.length;
    const newIssue = document.createElement('div');
    newIssue.className = 'issue-item mb-2';
    newIssue.innerHTML = `
        <input type="text" class="form-control" name="issues[${index}][description]" 
               placeholder="Issue description">
        <input type="number" class="form-control mt-1" name="issues[${index}][quantityAffected]" 
               placeholder="Quantity affected" min="0">
    `;
    container.appendChild(newIssue);
});
</script>

<%- include('../../../partials/footer') %>