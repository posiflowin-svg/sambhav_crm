<%- include('../partials/header') %>

<style>
  :root {
    --primary: #4361ee;
    --primary-light: #e6f0fd;
    --secondary: #3f37c9;
    --success: #4cc9f0;
    --danger: #f72585;
    --warning: #f8961e;
    --info: #4895ef;
    --light: #f8f9fa;
    --dark: #212529;
    --gray: #6c757d;
    --white: #ffffff;
    --border-radius: 8px;
    --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    --transition: all 0.3s ease;
  }

  .tab-nav {
    display: flex;
    gap: 10px;
    background-color: var(--white);
    padding: 15px 30px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: var(--box-shadow);
  }
  .tab-nav a {
    text-decoration: none;
    color: var(--gray);
    font-weight: 500;
    padding: 8px 16px;
    border-radius: var(--border-radius);
    transition: var(--transition);
    font-size: 14px;
  }
  .tab-nav a.active,
  .tab-nav a:hover {
    background-color: var(--primary);
    color: var(--white);
  }
  
  .admin-content {
    padding: 30px;
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    animation: fadeIn 0.5s ease;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .page-header h2 {
    color: var(--dark);
    font-size: 24px;
    margin: 0;
  }
  
  .btn {
    padding: 10px 20px;
    border-radius: var(--border-radius);
    border: none;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  
  .btn-primary {
    background-color: var(--primary);
    color: var(--white);
  }
  
  .btn-primary:hover {
    background-color: var(--secondary);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(67, 97, 238, 0.2);
  }
  
  .btn-danger {
    background-color: var(--danger);
    color: var(--white);
  }
  
  .btn-danger:hover {
    background-color: #d1146b;
    transform: translateY(-2px);
  }
  
  .btn-warning {
    background-color: var(--warning);
    color: var(--white);
  }
  
  .btn-warning:hover {
    background-color: #e08715;
    transform: translateY(-2px);
  }
  
  .card {
    background: var(--white);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    overflow: hidden;
  }
  
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }
  
  .card-header {
    padding: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  
  .card-body {
    padding: 20px;
  }
  
  .form-group {
    margin-bottom: 20px;
  }
  
  .form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--dark);
    font-size: 14px;
  }
  
  .form-control {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--border-radius);
    font-size: 14px;
    transition: var(--transition);
    background-color: var(--light);
  }
  
  .form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
    background-color: var(--white);
  }
  
  .search-container {
    margin-bottom: 30px;
    animation: slideUp 0.4s ease;
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .search-card {
    padding: 20px;
    background-color: var(--white);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
  }
  
  .search-form {
    display: flex;
    gap: 10px;
  }
  
  .search-form .form-control {
    flex: 1;
  }
  
  .user-form-card {
    margin-bottom: 30px;
    animation: slideUp 0.5s ease;
  }
  
  .user-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    animation: fadeIn 0.6s ease;
  }
  
  .user-card {
    position: relative;
  }
  
  .user-card .card-body {
    padding-bottom: 60px;
  }
  
  .user-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-weight: bold;
    font-size: 24px;
    margin-bottom: 15px;
  }
  
  .user-name {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 5px;
    color: var(--dark);
  }
  
  .user-detail {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
    font-size: 14px;
    color: var(--gray);
  }
  
  .user-detail i {
    margin-right: 10px;
    color: var(--primary);
    width: 20px;
    text-align: center;
  }
  
  .user-status {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
  }
  
  .status-active {
    background-color: rgba(76, 201, 240, 0.1);
    color: var(--success);
  }
  
  .status-inactive {
    background-color: rgba(247, 37, 133, 0.1);
    color: var(--danger);
  }
  
  .user-actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 15px 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    display: flex;
    gap: 10px;
  }
  
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    animation: fadeIn 0.5s ease;
  }
  
  .empty-state i {
    font-size: 60px;
    color: var(--gray);
    opacity: 0.3;
    margin-bottom: 20px;
  }
  
  .empty-state h3 {
    color: var(--dark);
    margin-bottom: 10px;
  }
  
  .empty-state p {
    color: var(--gray);
    max-width: 500px;
    margin: 0 auto;
  }
  
  /* Modal */
  .modal {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    display: none;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .modal.show {
    opacity: 1;
    display: flex;
  }
  
  .modal-content {
    background-color: var(--white);
    padding: 30px;
    border-radius: var(--border-radius);
    width: 100%;
    max-width: 500px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    position: relative;
    transform: translateY(-20px);
    transition: transform 0.3s ease;
  }
  
  .modal.show .modal-content {
    transform: translateY(0);
  }
  
  .modal-header {
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .modal-title {
    margin: 0;
    font-size: 20px;
    color: var(--dark);
  }
  
  .btn-close {
    background: none;
    border: none;
    font-size: 24px;
    color: var(--gray);
    cursor: pointer;
    transition: var(--transition);
    padding: 0;
    line-height: 1;
  }
  
  .btn-close:hover {
    color: var(--danger);
    transform: rotate(90deg);
  }
  
  .modal-footer {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  
  @media (max-width: 768px) {
    .admin-content {
      padding: 20px;
    }
    
    .search-form {
      flex-direction: column;
    }
    
    .user-grid {
      grid-template-columns: 1fr;
    }
    
    .tab-nav {
      overflow-x: auto;
      padding: 15px;
    }
    
    .tab-nav a {
      white-space: nowrap;
    }
  }
</style>

<div class="tab-nav">
  <a href="/dashboard/admin">
    <i class="bi bi-speedometer2"></i> Dashboard
  </a>
  <a href="/dashboard/admin/users" class="active">
    <i class="bi bi-people-fill"></i> Users
  </a>
  <a href="/dashboard/admin/products">
    <i class="bi bi-box-seam"></i> Products
  </a>
  <a href="/dashboard/admin/orders">
    <i class="bi bi-cart-fill"></i> Orders
  </a>
  <a href="/dashboard/admin/products1">
    <i class="bi bi-box-seam"></i> Inventory
  </a>
</div>

<div class="admin-content">
  <div class="page-header">
    <h2>User Management</h2>
    <button class="btn btn-primary" onclick="openCreateModal()">
      <i class="bi bi-plus"></i> Create User
    </button>
  </div>

  <!-- Search Card -->
  <div class="search-container">
    <div class="card search-card">
      <form action="/dashboard/admin/users/search" method="GET" class="search-form">
        <input 
          type="text" 
          name="query" 
          class="form-control"
          placeholder="Search users by name, email or role..." 
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
        >
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-search"></i> Search
        </button>
        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
          <a href="/dashboard/admin/users" class="btn btn-danger">
            <i class="bi bi-x"></i> Clear
          </a>
        <% } %>
      </form>
    </div>
  </div>

  <!-- User Grid -->
  <div class="user-grid">
    <% if (users.length === 0) { %>
      <div class="card empty-state">
        <i class="bi bi-people"></i>
        <% if (searchQuery) { %>
          <h3>No users found</h3>
          <p>No users match your search for "<%= searchQuery %>". Try a different search term.</p>
        <% } else { %>
          <h3>No users yet</h3>
          <p>Get started by creating your first user account.</p>
          <button class="btn btn-primary mt-3" onclick="openCreateModal()">
            <i class="bi bi-plus"></i> Create User
          </button>
        <% } %>
      </div>
    <% } else { %>
      <% users.forEach(function(user) { %>
        <div class="card user-card">
          <div class="card-body">
            <div class="user-avatar">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
            <h3 class="user-name"><%= user.name %></h3>
            
            <div class="user-detail">
              <i class="bi bi-envelope-fill"></i>
              <span><%= user.email %></span>
            </div>
            
            <div class="user-detail">
              <i class="bi bi-person-badge-fill"></i>
              <span><%= user.role.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></span>
            </div>
            
            <% if (user.role === 'sales' && user.salesSubRole) { %>
              <div class="user-detail">
                <i class="bi bi-people-fill"></i>
                <span><%= user.salesSubRole %></span>
              </div>
            <% } %>

            <div class="user-detail">
              <i class="bi bi-circle-fill"></i>
              <span class="user-status <%= user.isActive ? 'status-active' : 'status-inactive' %>">
                <%= user.isActive ? 'Active' : 'Inactive' %>
              </span>
            </div>
          </div>
          
          <div class="user-actions">
            <button class="btn btn-warning" onclick='openEditModal(<%- JSON.stringify(user) %>)'>
              <i class="bi bi-pencil-square"></i> Edit
            </button>
            <form action="/dashboard/admin/users/<%= user._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');" style="margin:0;">
              <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash-fill"></i> Delete
              </button>
            </form>
          </div>
        </div>

      <% }); %>
    <% } %>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal" id="editModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title">Edit User</h3>
      <button class="btn-close" onclick="closeEditModal()">&times;</button>
    </div>
    <form id="editForm" method="POST">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input type="text" name="name" id="editName" class="form-control" placeholder="John Doe" required />
      </div>
      
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" id="editEmail" class="form-control" placeholder="user@example.com" required />
      </div>
      
      <div class="form-group">
        <label class="form-label">New Password (leave blank to keep current)</label>
        <input type="password" name="password" id="editPassword" class="form-control" placeholder="••••••••" />
      </div>
      
      <div class="form-group">
        <label class="form-label">Confirm New Password</label>
        <input type="password" name="confirmPassword" id="editConfirmPassword" class="form-control" placeholder="••••••••" />
      </div>
      
      <div class="form-group">
        <label class="form-label">Role</label>
        <select name="role" id="editRole" class="form-control" required onchange="toggleSalesSubRole(this)">
          <option value="">Select Role</option>
          <option value="sales">Sales</option>
          <option value="cod_accountant">COD Accountant</option>
          <option value="prepaid_accountant">Prepaid Accountant</option>
          <option value="cod_dispatch">COD Dispatch</option>
          <option value="prepaid_dispatch">Prepaid Dispatch</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      
      <div class="form-group" id="editSalesSubRoleGroup" style="display: none;">
        <label class="form-label">Sales Team</label>
        <select name="salesSubRole" id="editSalesSubRole" class="form-control">
          <option value="">Select Sales Team</option>
          <option value="Direct Sale">Direct Sale</option>
          <option value="India Mart Team">India Mart Team</option>
          <option value="POS Team">POS Team</option>
          <option value="A4 Team">A4 Team</option>
          <option value="Dealer">Dealer</option>
          <option value="Label Team">Label Team</option>
        </select>
      </div>
      
      <div class="form-group">
        <label class="form-label">Status</label>
        <select name="isActive" id="editIsActive" class="form-control" required>
          <option value="true">Active</option>
          <option value="false">Inactive</option>
        </select>
      </div>
      
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Update User</button>
      </div>
    </form>
  </div>
</div>

