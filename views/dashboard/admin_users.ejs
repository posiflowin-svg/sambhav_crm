<script>
  // Function to toggle sales sub-role visibility
  function toggleSalesSubRole(selectElement) {
    const isSales = selectElement.value === 'sales';
    const formId = selectElement.id === 'editRole' ? 'edit' : 'create';
    const subRoleGroup = document.getElementById(`${formId}SalesSubRoleGroup`);
    
    subRoleGroup.style.display = isSales ? 'block' : 'none';
    if (!isSales) {
      document.getElementById(`${formId}SalesSubRole`).value = '';
    }
  }

  // Edit Modal Functions
  function openEditModal(user) {
    document.getElementById('editName').value = user.name;
    document.getElementById('editEmail').value = user.email;
    document.getElementById('editRole').value = user.role;
    document.getElementById('editIsActive').value = user.isActive ? 'true' : 'false';
    document.getElementById('editForm').action = `/dashboard/admin/users/${user._id}/update`;
    
    // Handle sales sub-role
    if (user.role === 'sales') {
      document.getElementById('editSalesSubRoleGroup').style.display = 'block';
      document.getElementById('editSalesSubRole').value = user.salesSubRole || '';
    } else {
      document.getElementById('editSalesSubRoleGroup').style.display = 'none';
    }
    
    const modal = document.getElementById('editModal');
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    const modal = document.getElementById('editModal');
    modal.classList.remove('show');
    document.body.style.overflow = '';
  }
  
  // Create Modal Functions
  function openCreateModal() {
    // Reset form and hide sales sub-role by default
    document.getElementById('createSalesSubRoleGroup').style.display = 'none';
    document.getElementById('createSalesSubRole').value = '';
    
    const modal = document.getElementById('createModal');
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  function closeCreateModal() {
    const modal = document.getElementById('createModal');
    modal.classList.remove('show');
    document.body.style.overflow = '';
  }

  // Close modals when clicking outside
  window.addEventListener('click', function(event) {
    if (event.target.classList.contains('modal')) {
      closeEditModal();
      closeCreateModal();
    }
  });
  
  // Password confirmation validation
  document.getElementById('createForm')?.addEventListener('submit', function(e) {
    const password = this.querySelector('[name="password"]').value;
    const confirmPassword = this.querySelector('[name="confirmPassword"]').value;
    
    if (password !== confirmPassword) {
      e.preventDefault();
      alert('Passwords do not match!');
    }
    
    // Validate sales sub-role if role is sales
    const role = this.querySelector('[name="role"]').value;
    if (role === 'sales') {
      const subRole = this.querySelector('[name="salesSubRole"]').value;
      if (!subRole) {
        e.preventDefault();
        alert('Please select a sales team!');
      }
    }
  });
  
  document.getElementById('editForm')?.addEventListener('submit', function(e) {
    const password = this.querySelector('[name="password"]').value;
    const confirmPassword = this.querySelector('[name="confirmPassword"]').value;
    
    if (password && password !== confirmPassword) {
      e.preventDefault();
      alert('Passwords do not match!');
    }
    
    // Validate sales sub-role if role is sales
    const role = this.querySelector('[name="role"]').value;
    if (role === 'sales') {
      const subRole = this.querySelector('[name="salesSubRole"]').value;
      if (!subRole) {
        e.preventDefault();
        alert('Please select a sales team!');
      }
    }
  });
</script>

