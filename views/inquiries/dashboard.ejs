        // Add keyboard shortcuts (Ctrl+Enter to submit)
        document.getElementById('replyForm').addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('replyForm').requestSubmit();
            }
        });

        // Optional: Add paste formatting
        document.getElementById('replyMessage').addEventListener('paste', function(e) {
            // You could add custom paste handling here if needed
            // For example, formatting pasted Excel tables
            setTimeout(() => {
                // Trigger count update after paste
                this.dispatchEvent(new Event('input'));
            }, 10);
        });
        // ==================== UTILITY FUNCTIONS ====================
        function formatDate(dateString) {
            if (!dateString) return 'N/A';
            const date = new Date(dateString);
            return date.toLocaleDateString('en-IN', {
                day: '2-digit', month: '2-digit', year: 'numeric'
            });
        }

        function formatDateTime(dateString) {
            if (!dateString) return 'N/A';
            const date = new Date(dateString);
            return date.toLocaleString('en-IN', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
        }

        function escapeHtml(unsafe) {
            if (!unsafe) return '';
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function showNotification(message, type = 'success') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} mr-2"></i>
                <span>${message}</span>
            `;
            
            const container = document.getElementById('notificationContainer');
            container.appendChild(notification);
            
            setTimeout(() => notification.remove(), 3000);
        }

        function showLoading() {
            document.getElementById('inquiriesTableBody').innerHTML = `
                <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                        <i class="fas fa-spinner fa-spin text-2xl mb-2 block text-blue-600"></i>
                        <p>Loading inquiries...</p>
                    </td>
                </tr>
            `;
            document.getElementById('tableInfo').textContent = 'Loading...';
        }

        function showError(message) {
            document.getElementById('inquiriesTableBody').innerHTML = `
                <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-red-600">
                        <i class="fas fa-exclamation-triangle text-2xl mb-2 block"></i>
                        <p>${message}</p>
                        <button onclick="loadInquiries(1)" class="mt-3 text-sm text-blue-600 hover:text-blue-800">
                            <i class="fas fa-redo-alt mr-1"></i> Try Again
                        </button>
                    </td>
                </tr>
            `;
        }

        // Date filter handler
function setDateFilter(range) {
    // Update button active state
    document.querySelectorAll('[id^="filter-"]').forEach(btn => {
        btn.classList.remove('filter-btn-active');
        btn.classList.add('filter-btn-inactive');
    });
    
    const activeBtn = document.getElementById(`filter-${range}`);
    if (activeBtn) {
        activeBtn.classList.remove('filter-btn-inactive');
        activeBtn.classList.add('filter-btn-active');
    }
    
    const today = new Date();
    let fromDate, toDate;
    
    // Reset time to midnight for consistent local date handling
    const resetTime = (date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());
    
    switch(range) {
        case 'today':
            fromDate = toDate = resetTime(today);
            break;
            
        case 'yesterday':
            const yesterday = new Date(today);
            yesterday.setDate(today.getDate() - 1);
            fromDate = toDate = resetTime(yesterday);
            break;
            
        case 'thisWeek':
            // Get Monday of current week (Monday = 1, Sunday = 0)
            const dayOfWeek = today.getDay(); // 0=Sun, 1=Mon, ..., 6=Sat
            const daysToMonday = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
            fromDate = resetTime(new Date(today));
            fromDate.setDate(today.getDate() - daysToMonday);
            // Saturday = Monday + 5 days
            toDate = resetTime(new Date(fromDate));
            toDate.setDate(fromDate.getDate() + 5);
            break;
            
        case 'thisMonth':
            fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
            toDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            break;
            
        case 'thisYear':
            fromDate = new Date(today.getFullYear(), 0, 1);
            toDate = new Date(today.getFullYear(), 11, 31);
            break;
            
        default:
            return;
    }
    
    // Set input values using robust formatDate function
    document.getElementById('dateFrom').value = formatDate(fromDate);
    document.getElementById('dateTo').value = formatDate(toDate);
    
    loadInquiries(1);
}

// Robust date formatter - handles Date objects, strings, null/undefined
function formatDate(dateInput) {
    if (!dateInput) return '';
    
    let dateObj;
    if (typeof dateInput === 'string') {
        // Parse string to Date (avoid timezone issues by using local date parts)
        const parts = dateInput.split(/[-T]/);
        if (parts.length >= 3) {
            // Handles "YYYY-MM-DD" or "YYYY-MM-DDTHH:mm:ss"
            dateObj = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        } else {
            dateObj = new Date(dateInput);
        }
    } else if (dateInput instanceof Date) {
        dateObj = dateInput;
    } else {
        return '';
    }
    
    // Validate date
    if (isNaN(dateObj.getTime())) {
        console.warn('Invalid date:', dateInput);
        return '';
    }
    
    const year = dateObj.getFullYear();
    const month = String(dateObj.getMonth() + 1).padStart(2, '0');
    const day = String(dateObj.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
}

        function filterByStatus(status) {
            document.getElementById('statusFilter').value = status;
            loadInquiries(1);
        }

        function clearFilters() {
            document.getElementById('searchQuery').value = '';
            document.getElementById('statusFilter').value = 'all';
            document.getElementById('assignedChinaFilter').value = '';
            document.getElementById('assignedSalesFilter').value = '';
            setDateFilter('thisWeek');
        }

        function exportInquiries() {
            try {
                const params = new URLSearchParams();
                
                const status = document.getElementById('statusFilter').value;
                const assignedChina = document.getElementById('assignedChinaFilter').value;
                const assignedSales = document.getElementById('assignedSalesFilter').value;
                const searchQuery = document.getElementById('searchQuery').value;
                const dateFrom = document.getElementById('dateFrom').value;
                const dateTo = document.getElementById('dateTo').value;
                
                if (status && status !== 'all') params.append('status', status);
                if (assignedChina) params.append('assignedChina', assignedChina);
                if (assignedSales) params.append('assignedSales', assignedSales);
                if (searchQuery) params.append('search', searchQuery);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);
                
                params.append('export', 'true');

                window.location.href = `/api/inquiries/export?${params}`;
            } catch (error) {
                showNotification('Export failed. Please try again.', 'error');
            }
        }

        // Enter key for search
        document.getElementById('searchQuery')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadInquiries(1);
            }
        });

        /**
         * Open modal to edit a note
         */
        function openEditNoteModal(inquiryId, noteId, currentMessage) {
            document.getElementById('editNoteInquiryId').value = inquiryId;
            document.getElementById('editNoteId').value = noteId;
            document.getElementById('editNoteMessage').value = currentMessage;
            openModal('editNoteModal');
        }

        /**
         * Update a note
         */
        async function updateNote(event) {
            event.preventDefault();
            
            const inquiryId = document.getElementById('editNoteInquiryId').value;
            const noteId = document.getElementById('editNoteId').value;
            const message = document.getElementById('editNoteMessage').value.trim();

            if (!message) {
                showNotification('Please enter a message', 'error');
                return;
            }

            try {
                const response = await fetch(`/api/inquiries/${inquiryId}/notes/${noteId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });

                const result = await response.json();

                if (response.ok) {
                    showNotification('Note updated successfully!', 'success');
                    closeModal('editNoteModal');
                    
                    // Refresh the view modal if it's open
                    if (document.getElementById('viewModal').classList.contains('active')) {
                        viewInquiry(inquiryId);
                    }
                } else {
                    showNotification('Error: ' + result.message, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error updating note', 'error');
            }
        }

        /**
         * Open modal to reply to a specific note
         */
        function openReplyToNoteModal(inquiryId, noteId, originalMessage, originalAuthor) {
            document.getElementById('replyToNoteInquiryId').value = inquiryId;
            document.getElementById('replyToNoteParentId').value = noteId;
            
            // Show original note preview
            document.getElementById('originalNotePreview').innerHTML = `
                <div class="flex items-start">
                    <div class="flex-shrink-0 mr-3">
                        <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center text-gray-700 font-bold">
                            ${originalAuthor ? originalAuthor.charAt(0).toUpperCase() : '?'}
                        </div>
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium text-gray-500">${originalAuthor || 'Unknown'}</span>
                        </div>
                        <p class="text-sm text-gray-700 mt-1 italic">"${escapeHtml(originalMessage.substring(0, 150))}${originalMessage.length > 150 ? '...' : ''}"</p>
                    </div>
                </div>
            `;
            
            // Set default role based on user
            document.getElementById('replyToNoteRole').value = userRole === 'china' ? 'china' : 'sales';
            document.getElementById('replyToNoteMessage').value = '';
            
            openModal('replyToNoteModal');
        }

        /**
         * Submit reply to a specific note
         */
        async function submitNoteReply(event) {
            event.preventDefault();
            
            const inquiryId = document.getElementById('replyToNoteInquiryId').value;
            const parentNoteId = document.getElementById('replyToNoteParentId').value;
            const message = document.getElementById('replyToNoteMessage').value.trim();
            const role = document.getElementById('replyToNoteRole').value;

            if (!message) {
                showNotification('Please enter a message', 'error');
                return;
            }

            try {
                const response = await fetch(`/api/inquiries/${inquiryId}/notes/${parentNoteId}/reply`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, role })
                });

                const result = await response.json();

                if (response.ok) {
                    showNotification('Reply added successfully!', 'success');
                    closeModal('replyToNoteModal');
                    
                    // Refresh the view modal
                    if (document.getElementById('viewModal').classList.contains('active')) {
                        viewInquiry(inquiryId);
                    }
                } else {
                    showNotification('Error: ' + result.message, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error adding reply', 'error');
            }
        }

        // ==================== NOTES DROPDOWN ====================
        function toggleNotesDropdown(inquiryId) {
            const dropdown = document.getElementById(`notes-dropdown-${inquiryId}`);
            
            // Close all other dropdowns first
            document.querySelectorAll('[id^="notes-dropdown-"]').forEach(el => {
                if (el.id !== `notes-dropdown-${inquiryId}`) {
                    el.classList.add('hidden');
                }
            });
            
            // Toggle current dropdown
            dropdown.classList.toggle('hidden');
            
            // Close dropdown when clicking outside
            if (!dropdown.classList.contains('hidden')) {
                setTimeout(() => {
                    document.addEventListener('click', function closeDropdown(e) {
                        if (!dropdown.contains(e.target) && !e.target.closest(`[onclick*="toggleNotesDropdown('${inquiryId}')"]`)) {
                            dropdown.classList.add('hidden');
                            document.removeEventListener('click', closeDropdown);
                        }
                    });
                }, 100);
            }
        }

        // Close all notes dropdowns when opening a modal
        const originalOpenModal = openModal;
        openModal = function(modalId) {
            document.querySelectorAll('[id^="notes-dropdown-"]').forEach(el => {
                el.classList.add('hidden');
            });
            originalOpenModal(modalId);
        };
    </script>
