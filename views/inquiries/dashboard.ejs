    <!-- 6. Reply to Specific Note Modal (New) -->
    <div id="replyToNoteModal" class="modal-overlay">
        <div class="modal-container max-w-2xl">
            <div class="modal-header">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-reply text-green-600 mr-2"></i>
                        Reply to Note
                    </h3>
                    <p class="text-sm text-gray-500 mt-1" id="replyToNoteInfo">Replying to a specific note</p>
                </div>
                <button onclick="closeModal('replyToNoteModal')" class="text-gray-400 hover:text-gray-600">
