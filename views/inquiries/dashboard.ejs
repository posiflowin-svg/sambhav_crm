    <!-- Notification Container -->
    <div id="notificationContainer" style="position: fixed; top: 20px; right: 20px; z-index: 1100;"></div>

    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        // Global variables
        let currentPage = 1;
        let currentInquiryId = null;
        let currentInquiryToDelete = null;
        let userRole = '<%= user.role %>';
        let userId = '<%= user._id %>';

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            setDateFilter('thisWeek');
            
            // Close modals on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeAllModals();
                }
            });

            // Close modals on overlay click
            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeAllModals();
                    }
                });
            });
        });

        // ==================== MODAL CONTROLS ====================
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
            document.body.style.overflow = '';
        }

        function closeAllModals() {
            document.querySelectorAll('.modal-overlay').forEach(modal => {
                modal.classList.remove('active');
            });
            document.body.style.overflow = '';
        }

        // ==================== VIEW INQUIRY ====================
        async function viewInquiry(inquiryId) {
            currentInquiryId = inquiryId;
            openModal('viewModal');
            
            // Show loading
            document.getElementById('viewLoading').classList.remove('hidden');
            document.getElementById('viewContent').classList.add('hidden');
            document.getElementById('viewInquiryId').textContent = 'Loading...';

            try {
                const response = await fetch(`/api/inquiries/${inquiryId}`);
                const data = await response.json();
                
                if (data.success) {
                    renderInquiryDetails(data.data);
                } else {
                    throw new Error(data.message || 'Failed to load inquiry');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error loading inquiry details', 'error');
                closeModal('viewModal');
            }
        }

        function renderInquiryDetails(inquiry) {
            document.getElementById('viewLoading').classList.add('hidden');
            document.getElementById('viewContent').classList.remove('hidden');
            document.getElementById('viewInquiryId').textContent = `Inquiry #${inquiry._id.slice(-8)}`;

            const statusColors = {
                'new': 'bg-purple-100 text-purple-800',
                'china-processing': 'bg-yellow-100 text-yellow-800',
                'pricing-ready': 'bg-indigo-100 text-indigo-800',
                'sales-processing': 'bg-orange-100 text-orange-800',
                'completed': 'bg-green-100 text-green-800',
                'cancelled': 'bg-red-100 text-red-800'
            };

            const productStatusColors = {
                'pending': 'bg-gray-100 text-gray-800',
                'china-searching': 'bg-yellow-100 text-yellow-800',
                'china-priced': 'bg-indigo-100 text-indigo-800',
                'sent-to-sales': 'bg-orange-100 text-orange-800',
                'quoted-to-customer': 'bg-purple-100 text-purple-800',
                'won': 'bg-green-100 text-green-800',
                'lost': 'bg-red-100 text-red-800'
            };

            // Products HTML
            const productsHtml = inquiry.products.map((p, index) => `
                <div class="bg-white border border-gray-200 rounded-lg p-4 mb-3 hover:shadow-sm transition">
                    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-3">
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <h4 class="font-medium text-gray-900">${escapeHtml(p.productName)}</h4>
                                <span class="status-badge ${productStatusColors[p.status] || 'bg-gray-100 text-gray-800'}">
                                    ${p.status ? p.status.replace(/-/g, ' ') : 'Pending'}
                                </span>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-3 text-sm">
                                <div>
                                    <span class="text-gray-500">Quantity:</span>
                                    <span class="font-medium ml-1">${p.quantity}</span>
                                </div>
                                ${p.targetPrice ? `
                                    <div>
                                        <span class="text-gray-500">Target:</span>
                                        <span class="font-medium ml-1">$${p.targetPrice.toFixed(2)}</span>
                                    </div>
                                ` : ''}
                                ${p.chinaPrice ? `
                                    <div>
                                        <span class="text-gray-500">China:</span>
                                        <span class="font-medium ml-1">$${p.chinaPrice.toFixed(2)}</span>
                                    </div>
                                ` : ''}
                                ${p.finalSellingPrice ? `
                                    <div>
                                        <span class="text-gray-500">Final:</span>
                                        <span class="font-medium ml-1">$${p.finalSellingPrice.toFixed(2)}</span>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

            // Notes/Timeline HTML with edit and reply buttons
            const notesHtml = inquiry.notes && inquiry.notes.length > 0 ? 
                inquiry.notes.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt)).map(note => {
                    // Check if current user can edit this note
                    const canEdit = note.addedBy?._id === userId || userRole === 'admin';
                    
                    // Check if this is a reply (has parent)
                    const isReply = note.parentNoteId;
                    
                    return `
                    <div class="timeline-item ${isReply ? 'ml-8' : ''}" data-note-id="${note._id}">
                        <div class="timeline-dot ${note.role || 'system'}"></div>
                        <div class="bg-gray-50 rounded-lg p-4 hover:shadow-sm transition">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="text-xs font-medium px-2 py-1 rounded-full 
                                            ${note.role === 'sales' ? 'bg-green-100 text-green-800' : 
                                            note.role === 'china' ? 'bg-yellow-100 text-yellow-800' : 
                                            'bg-gray-100 text-gray-800'}">
                                            <i class="fas ${note.role === 'sales' ? 'fa-headset' : 
                                                            note.role === 'china' ? 'fa-plane' : 
                                                            'fa-cog'} mr-1"></i>
                                            ${note.role ? note.role.toUpperCase() : 'SYSTEM'}
                                        </span>
                                        <span class="text-xs text-gray-400">
                                            ${formatDateTime(note.createdAt)}
                                            ${note.isEdited ? '<span class="ml-2 text-gray-400">(edited)</span>' : ''}
                                        </span>
                                        ${note.addedBy ? `
                                            <span class="text-xs text-gray-400">
                                                by ${note.addedBy.name || 'Unknown'}
                                            </span>
                                        ` : ''}
                                    </div>
                                    <p class="text-sm text-gray-700 whitespace-pre-wrap">${escapeHtml(note.message)}</p>
                                </div>
                                
                                <!-- Action buttons for note 
                                <div class="flex space-x-2 ml-4" onclick="event.stopPropagation()">
                                    ${canEdit ? `
                                        <button onclick="openEditNoteModal('${inquiry._id}', '${note._id}', ${JSON.stringify(escapeHtml(note.message))})" 
                                                class="text-blue-600 hover:text-blue-800 text-sm" title="Edit Note">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    ` : ''}
                                    <button onclick="openReplyToNoteModal('${inquiry._id}', '${note._id}', ${JSON.stringify(escapeHtml(note.message))}, ${JSON.stringify(note.addedBy?.name || 'Unknown')})" 
                                            class="text-green-600 hover:text-green-800 text-sm" title="Reply to this note">
                                        <i class="fas fa-reply"></i>
                                    </button>
                                </div>-->
                            </div>
                            
                            <!-- Show if it's a reply (optional) -->
                            ${isReply ? `
                                <div class="mt-2 text-xs text-gray-400 border-t pt-2">
                                    <i class="fas fa-reply mr-1"></i> Reply to previous note
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `}).join('') : 
                '<p class="text-gray-500 text-center py-4">No notes yet</p>';

            // Generate star rating HTML with current rating value
            const currentRating = inquiry.rating || 0;
            const ratingStarsHtml = generateRatingStars(currentRating, inquiry._id);

            const html = `
                <div class="space-y-6">
                    <!-- Header Info with Rating -->
                    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-4 border border-blue-100">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div>
                                <p class="text-xs text-gray-500">Company</p>
                                <p class="font-medium">${inquiry.companyId?.companyName || 'N/A'}</p>
                                <p class="text-xs text-gray-500 mt-1">${inquiry.companyId?.phoneNumber || ''}</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Priority Rating</p>
                                <div class="mt-1">
                                    ${ratingStarsHtml}
                                </div>
                                ${currentRating > 0 ? `
                                    <p class="text-xs text-gray-500 mt-1">Priority Level: ${getPriorityLevel(currentRating)}</p>
                                ` : '<p class="text-xs text-gray-500 mt-1">No priority set</p>'}
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Created</p>
                                <p class="font-medium">${formatDate(inquiry.createdAt)}</p>
                                <p class="text-xs text-gray-500 mt-1">by ${inquiry.createdBy?.name || 'System'}</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Last Updated</p>
                                <p class="font-medium">${formatDate(inquiry.updatedAt)}</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Status</p>
                                <span class="status-badge ${statusColors[inquiry.overallStatus]} mt-1">
                                    ${inquiry.overallStatus.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Assignment -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-gray-50 rounded-lg p-4">
