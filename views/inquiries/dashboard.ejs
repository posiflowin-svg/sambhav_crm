                </button>
            </div>
            
            <div class="modal-body">
                <!-- Original Note Preview -->
                <div id="originalNotePreview" class="bg-gray-50 rounded-lg p-4 mb-4 border-l-4 border-gray-300">
                    <!-- Will be populated dynamically -->
                </div>
                
                <form id="replyToNoteForm" onsubmit="submitNoteReply(event)">
                    <input type="hidden" id="replyToNoteInquiryId">
                    <input type="hidden" id="replyToNoteParentId">
                    
