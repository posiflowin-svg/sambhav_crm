        // Helper function to generate star rating HTML
        function generateRatingStars(currentRating, inquiryId) {
            let starsHtml = '<div class="flex items-center gap-1 star-rating-container" data-inquiry-id="' + inquiryId + '">';
            
            for (let i = 1; i <= 5; i++) {
                const isActive = i <= currentRating;
                const starClass = isActive ? 'fas fa-star text-yellow-400' : 'far fa-star text-gray-300';
                starsHtml += `
                    <i class="${starClass} text-xl cursor-pointer transition-all duration-200 hover:scale-110 star-rating-star" 
                    data-rating="${i}" 
                    data-inquiry-id="${inquiryId}"
                    onclick="setRating('${inquiryId}', ${i})"
                    onmouseover="hoverStar(this, ${i})"
                    onmouseout="resetStars('${inquiryId}', ${currentRating})">
                    </i>
                `;
            }
            
            starsHtml += '</div>';
            return starsHtml;
        }

        // Helper function to get priority level text
        function getPriorityLevel(rating) {
            if (rating >= 4) return 'High Priority ⚡';
            if (rating >= 3) return 'Medium Priority 📌';
            if (rating >= 2) return 'Low Priority 📋';
            if (rating >= 1) return 'Very Low Priority 🟢';
            return 'No Priority';
        }

        // Star hover effect
        function hoverStar(starElement, rating) {
            const container = starElement.closest('.star-rating-container');
            const stars = container.querySelectorAll('.star-rating-star');
            
            stars.forEach((star, index) => {
                const starValue = parseInt(star.getAttribute('data-rating'));
                if (starValue <= rating) {
                    star.classList.remove('far', 'fa-star', 'text-gray-300');
                    star.classList.add('fas', 'fa-star', 'text-yellow-400');
                } else {
                    star.classList.remove('fas', 'fa-star', 'text-yellow-400');
                    star.classList.add('far', 'fa-star', 'text-gray-300');
                }
            });
        }

        // Reset stars to current rating
        function resetStars(inquiryId, currentRating) {
            const container = document.querySelector(`.star-rating-container[data-inquiry-id="${inquiryId}"]`);
            if (!container) return;
            
            const stars = container.querySelectorAll('.star-rating-star');
            stars.forEach((star, index) => {
                const starValue = parseInt(star.getAttribute('data-rating'));
                if (starValue <= currentRating) {
                    star.classList.remove('far', 'fa-star', 'text-gray-300');
                    star.classList.add('fas', 'fa-star', 'text-yellow-400');
                } else {
                    star.classList.remove('fas', 'fa-star', 'text-yellow-400');
                    star.classList.add('far', 'fa-star', 'text-gray-300');
                }
            });
        }

        // Set rating function
        async function setRating(inquiryId, rating) {
            try {
                // Show loading state
                const container = document.querySelector(`.star-rating-container[data-inquiry-id="${inquiryId}"]`);
                if (container) {
                    container.style.opacity = '0.5';
                    container.style.pointerEvents = 'none';
                }
                
                // Make sure rating is a number
                const numericRating = parseInt(rating, 10);
                
                console.log('Sending rating:', numericRating); // Debug log
                
                const response = await fetch(`/api/inquiries/${inquiryId}/rating`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ rating: numericRating }) // Send as number
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Update the stars to show the new rating
                    resetStars(inquiryId, numericRating);
                    
                    // Update the priority level text
                    const priorityText = document.querySelector(`.star-rating-container[data-inquiry-id="${inquiryId}"]`)
                        ?.closest('div')
                        ?.parentElement
                        ?.querySelector('.text-xs.text-gray-500.mt-1');
                    
                    if (priorityText) {
                        priorityText.textContent = numericRating > 0 ? `Priority Level: ${getPriorityLevel(numericRating)}` : 'No priority set';
                    }
                    
                    // Show success notification
                    showNotification(`Priority updated to ${numericRating} star${numericRating !== 1 ? 's' : ''}`, 'success');
                    
                    // Refresh the table to update the rating column
                    if (typeof loadInquiries === 'function') {
                        await loadInquiries();
                    }
                } else {
                    throw new Error(data.message || 'Failed to update rating');
                }
            } catch (error) {
                console.error('Error updating rating:', error);
                showNotification(error.message || 'Failed to update priority', 'error');
                
                // Reset stars to original rating on error
                const currentRating = await getCurrentRating(inquiryId);
                resetStars(inquiryId, currentRating);
            } finally {
                // Remove loading state
                const container = document.querySelector(`.star-rating-container[data-inquiry-id="${inquiryId}"]`);
                if (container) {
                    container.style.opacity = '1';
                    container.style.pointerEvents = 'auto';
                }
            }
        }

        // Helper function to get current rating (you can implement this based on your data)
        async function getCurrentRating(inquiryId) {
            try {
                const response = await fetch(`/api/inquiries/${inquiryId}`);
                const data = await response.json();
                return data.data.rating || 0;
            } catch (error) {
                console.error('Error getting current rating:', error);
                return 0;
            }
        }

        // ==================== EDIT INQUIRY ====================
        async function openEditModal(inquiryId) {
            currentInquiryId = inquiryId;
            openModal('editModal');
            
            try {
                const response = await fetch(`/api/inquiries/${inquiryId}`);
                const data = await response.json();
                
                if (data.success) {
                    populateEditForm(data.data);
                } else {
                    throw new Error('Failed to load inquiry');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error loading inquiry for edit', 'error');
                closeModal('editModal');
            }
        }

        function populateEditForm(inquiry) {
            document.getElementById('editInquiryId').value = inquiry._id;
            document.getElementById('editOverallStatus').value = inquiry.overallStatus;
            document.getElementById('editAssignedChina').value = inquiry.assignedChinaPerson?._id || '';
            document.getElementById('editAssignedSales').value = inquiry.assignedSalesPerson?._id || '';

            // Products list
            const productsHtml = inquiry.products.map(p => `
                <div class="flex justify-between items-center py-2 border-b last:border-0">
                    <div>
                        <span class="font-medium">${escapeHtml(p.productName)}</span>
                        <span class="text-sm text-gray-500 ml-2">Qty: ${p.quantity}</span>
                    </div>
                    ${p.chinaPrice ? `<span class="text-sm text-green-600">¥${p.chinaPrice}</span>` : ''}
                </div>
            `).join('');
            document.getElementById('editProductsList').innerHTML = productsHtml || '<p class="text-gray-500">No products</p>';

            // Recent notes
            const notesHtml = inquiry.notes && inquiry.notes.length > 0 ? 
                inquiry.notes.slice(-3).map(note => `
                    <div class="mb-2 pb-2 border-b last:border-0">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium text-gray-500">${note.role || 'system'}</span>
                            <span class="text-xs text-gray-400">${formatDateTime(note.createdAt)}</span>
                        </div>
                        <p class="text-sm mt-1">${escapeHtml(note.message.substring(0, 100))}${note.message.length > 100 ? '...' : ''}</p>
                    </div>
                `).join('') : 
                '<p class="text-gray-500 text-sm">No previous notes</p>';
            
            document.getElementById('editNotesPreview').innerHTML = notesHtml;
            document.getElementById('editNote').value = '';
        }

        async function updateInquiry(event) {
            event.preventDefault();
            
            const inquiryId = document.getElementById('editInquiryId').value;
            const note = document.getElementById('editNote').value.trim();
            
            const data = {
                overallStatus: document.getElementById('editOverallStatus').value,
                assignedChinaPerson: document.getElementById('editAssignedChina').value || null,
                assignedSalesPerson: document.getElementById('editAssignedSales').value || null
            };

            try {
                // First update the main inquiry data
                const response = await fetch(`/api/inquiries/${inquiryId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (!response.ok) {
                    throw new Error('Failed to update inquiry');
                }

                // Then add note separately if provided
                if (note) {
                    const noteResponse = await fetch(`/api/inquiries/${inquiryId}/notes`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            message: note,
                            role: userRole === 'china' ? 'china' : 'sales'
                        })
                    });

                    if (!noteResponse.ok) {
                        console.warn('Note added but failed to save note');
                    }
                }

                showNotification('Inquiry updated successfully!', 'success');
                closeModal('editModal');
                loadInquiries(currentPage);
                
                // If view modal is open, refresh it
                if (document.getElementById('viewModal').classList.contains('active')) {
                    viewInquiry(inquiryId);
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error updating inquiry', 'error');
            }
        }
                
        // ==================== REPLY / ADD NOTE ====================
        function openReplyModal(inquiryId) {
            currentInquiryId = inquiryId;
            
            // Set inquiry info
            document.getElementById('replyInquiryId').value = inquiryId;
            document.getElementById('replyInquiryInfo').textContent = `Adding reply to Inquiry #${inquiryId.slice(-8)}`;
            
            // Clear form
            document.getElementById('replyForm').reset();
            
            // Set default role based on user
            document.getElementById('replyRole').value = userRole === 'china' ? 'china' : 'sales';
            
            openModal('replyModal');
        }

        async function submitReply(event) {
            event.preventDefault();
            
            const inquiryId = document.getElementById('replyInquiryId').value;
            const message = document.getElementById('replyMessage').value.trim();
            const role = document.getElementById('replyRole').value;
            const updateStatus = document.getElementById('replyUpdateStatus').value;

            if (!message) {
                showNotification('Please enter a message', 'error');
                return;
            }

            try {
                // If we need to update status as well
                if (updateStatus) {
                    // Use the dedicated notes endpoint first to add the note
                    const noteResponse = await fetch(`/api/inquiries/${inquiryId}/notes`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            message: message,
                            role: role
                        })
                    });

                    if (!noteResponse.ok) {
                        const error = await noteResponse.json();
                        throw new Error(error.message || 'Failed to add note');
                    }

                    // Then update the status separately
                    const updateResponse = await fetch(`/api/inquiries/${inquiryId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            overallStatus: updateStatus
                            // Don't include notes here!
                        })
                    });

                    const result = await updateResponse.json();

                    if (updateResponse.ok) {
                        showNotification('Reply added and status updated!', 'success');
                        closeModal('replyModal');
                        loadInquiries(currentPage);
                        
                        if (document.getElementById('viewModal').classList.contains('active')) {
                            viewInquiry(inquiryId);
                        }
                    } else {
                        showNotification('Error: ' + result.message, 'error');
                    }
                } else {
                    // Just add note using the dedicated notes endpoint
                    const response = await fetch(`/api/inquiries/${inquiryId}/notes`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            message: message,
                            role: role
                        })
                    });

                    const result = await response.json();

                    if (response.ok) {
                        showNotification('Reply added successfully!', 'success');
                        closeModal('replyModal');
                        loadInquiries(currentPage);
                        
                        if (document.getElementById('viewModal').classList.contains('active')) {
                            viewInquiry(inquiryId);
                        }
                    } else {
                        showNotification('Error: ' + result.message, 'error');
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error adding reply: ' + error.message, 'error');
            }
        }
                
        // ==================== DELETE INQUIRY ====================
        function showDeleteModal(inquiryId) {
            currentInquiryToDelete = inquiryId;
            openModal('deleteModal');
        }

        async function confirmDelete() {
            if (!currentInquiryToDelete) return;

            try {
                const response = await fetch(`/api/inquiries/${currentInquiryToDelete}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok) {
                    showNotification('Inquiry deleted successfully', 'success');
                    closeModal('deleteModal');
                    loadInquiries(currentPage);
                } else {
                    const error = await response.json();
                    showNotification('Error: ' + error.message, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error deleting inquiry', 'error');
            } finally {
                currentInquiryToDelete = null;
            }
        }

        // ==================== TABLE FUNCTIONS ====================
        async function loadInquiries(page = 1) {
            currentPage = page;
            
            try {
                showLoading();
                
                const params = new URLSearchParams();
                params.append('page', page);
                params.append('limit', document.getElementById('perPageFilter').value);
                
                // Get filter values
                const status = document.getElementById('statusFilter').value;
                const assignedChina = document.getElementById('assignedChinaFilter').value;
                const assignedSales = document.getElementById('assignedSalesFilter').value;
                const searchQuery = document.getElementById('searchQuery').value;
                const dateFrom = document.getElementById('dateFrom').value;
                const dateTo = document.getElementById('dateTo').value;
                
                if (status && status !== 'all') params.append('status', status);
                if (assignedChina) params.append('assignedChina', assignedChina);
                if (assignedSales) params.append('assignedSales', assignedSales);
                if (searchQuery) params.append('search', searchQuery);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);

                const response = await fetch(`/api/inquiries?${params}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                updateInquiriesTable(data.inquiries);
                updatePagination(data.total, data.page, data.pages, parseInt(params.get('limit')));
                updateStats(data.statistics);
                
            } catch (error) {
                console.error('Error loading inquiries:', error);
                showError('Error loading inquiries. Please try again.');
            }
        }

        function updateInquiriesTable(inquiries) {
            const tbody = document.getElementById('inquiriesTableBody');
            
            if (!inquiries || inquiries.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                            <i class="fas fa-inbox text-4xl mb-3 block text-gray-300"></i>
