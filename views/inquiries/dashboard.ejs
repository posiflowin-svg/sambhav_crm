                        </select>
                    </div>

                    <!-- Message - Improved Textarea with better UX -->
                    <div class="form-group">
                        <div class="flex items-center justify-between">
                            <label class="form-label">
                                <i class="fas fa-pen mr-1 text-gray-400"></i> Your Message *
                            </label>
                            <!-- Formatting helper buttons -->
                            <div class="flex items-center space-x-2 text-xs text-gray-500">
                                <span class="flex items-center cursor-help" title="Use for product lists">
                                    <i class="fas fa-list-ul mr-1"></i> One per line
                                </span>
                                <span class="text-gray-300">|</span>
                                <span class="flex items-center cursor-help" title="Format: Product Name - Quantity - Price">
                                    <i class="fas fa-dollar-sign mr-1"></i> Use - to separate
                                </span>
                            </div>
                        </div>
                        
                        <div class="relative">
                            <textarea 
                                id="replyMessage" 
                                rows="8" 
                                class="form-input font-mono text-sm resize-y min-h-[200px] w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                                required
                                placeholder="Product A - 100 units - $25.50&#10;Product B - 50 units - $12.75&#10;Product C - 200 units - $8.99&#10;&#10;Additional notes: ..."
                                style="white-space: pre; overflow-x: auto;"
                            ></textarea>
                            
                            <!-- Character and line count (optional) -->
                            <div class="absolute bottom-2 right-3 text-xs text-gray-400 bg-white bg-opacity-90 px-2 py-1 rounded">
                                <span id="lineCount">0</span> lines · 
                                <span id="charCount">0</span> chars
                            </div>
                        </div>

                        <!-- Quick formatting templates -->
                        <div class="mt-3 flex flex-wrap gap-2">
                            <button 
                                type="button" 
                                onclick="insertTemplate('productList')"
                                class="text-xs px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition-colors duration-150 flex items-center"
                            >
                                <i class="fas fa-cube mr-1"></i> Insert Product List Template
                            </button>
                            <button 
                                type="button" 
                                onclick="insertTemplate('priceQuote')"
                                class="text-xs px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-full transition-colors duration-150 flex items-center"
                            >
                                <i class="fas fa-file-invoice-dollar mr-1"></i> Insert Price Quote Template
                            </button>
                        </div>
                    </div>

                    <!-- Optional: Update Status -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-sync-alt mr-1 text-gray-400"></i> Also Update Status (Optional)
                        </label>
                        <select id="replyUpdateStatus" class="form-input">
                            <option value="">Don't change status</option>
                            <option value="new">New</option>
                            <option value="china-processing">China Processing</option>
                            <option value="pricing-ready">Pricing Ready</option>
                            <option value="sales-processing">Sales Processing</option>
                            <option value="completed">Completed (Won)</option>
                            <option value="cancelled">Cancelled (Lost)</option>
                        </select>
                    </div>
                </form>
            </div>

            <div class="modal-footer flex justify-between items-center">
                <div class="text-xs text-gray-400">
                    <i class="fas fa-info-circle mr-1"></i>
                    Tip: Use line breaks to separate products
                </div>
                <div class="flex space-x-3">
                    <button onclick="closeModal('replyModal')" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors duration-150">
                        Cancel
                    </button>
                    <button type="submit" form="replyForm" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-150 flex items-center shadow-sm">
                        <i class="fas fa-paper-plane mr-2"></i>Send Reply
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Delete Confirmation Modal -->
    <div id="deleteModal" class="modal-overlay">
        <div class="modal-container max-w-md">
            <div class="modal-header">
                <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                    <i class="fas fa-trash text-red-600 mr-2"></i>
                    Delete Inquiry
                </h3>
                <button onclick="closeModal('deleteModal')" class="text-gray-400 hover:text-gray-600">
