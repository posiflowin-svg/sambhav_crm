                                <option value="">Not Assigned</option>
                                <% chinaUsers.forEach(user => { %>
                                    <option value="<%= user._id %>"><%= user.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-user-headset mr-1 text-gray-400"></i> Assign Sales Person
                            </label>
                            <select id="editAssignedSales" class="form-input">
                                <option value="">Not Assigned</option>
                                <% salesUsers.forEach(user => { %>
                                    <option value="<%= user._id %>"><%= user.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <!-- Products Summary (Read-only) -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-box mr-1 text-gray-400"></i> Products
                        </label>
                        <div id="editProductsList" class="bg-gray-50 rounded-lg p-3 text-sm max-h-40 overflow-y-auto">
                            <!-- Loaded dynamically -->
                        </div>
                    </div>

                    <!-- Add Note -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-sticky-note mr-1 text-gray-400"></i> Add Note (Optional)
                        </label>
                        <textarea id="editNote" rows="3" class="form-input" 
                                  placeholder="Add a note about this update..."></textarea>
                    </div>

                    <!-- Recent Notes Preview -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-history mr-1 text-gray-400"></i> Recent Notes
                        </label>
                        <div id="editNotesPreview" class="max-h-40 overflow-y-auto bg-gray-50 rounded-lg p-3 text-sm">
                            <!-- Loaded dynamically -->
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="closeModal('editModal')" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                    Cancel
                </button>
                <button type="submit" form="editInquiryForm" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    <i class="fas fa-save mr-2"></i>Update Inquiry
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Reply Modal (Add Note) - Uses POST /api/inquiries/:inquiryId/notes -->
    <div id="replyModal" class="modal-overlay">
        <div class="modal-container max-w-3xl"> <!-- Increased width -->
            <div class="modal-header">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-reply text-green-600 mr-2"></i>
                        Add Reply / Note
                    </h3>
                    <p class="text-sm text-gray-500 mt-1" id="replyInquiryInfo">Add your response or note</p>
                </div>
                <button onclick="closeModal('replyModal')" class="text-gray-400 hover:text-gray-600">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <div class="modal-body">
                <form id="replyForm" onsubmit="submitReply(event)">
                    <input type="hidden" id="replyInquiryId">
                    
                    <!-- Message Type -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-comment mr-1 text-gray-400"></i> Message Type
                        </label>
                        <select id="replyRole" class="form-input" required>
