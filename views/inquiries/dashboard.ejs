                                                            <span class="text-xs px-1.5 py-0.5 rounded-full ${note.role === 'sales' ? 'bg-green-100 text-green-800' : note.role === 'china' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800'}">
                                                                ${note.role || 'note'}
                                                            </span>
                                                            <span class="text-xs text-gray-400">${formatDate(note.createdAt)}</span>
                                                        </div>
                                                        <p class="text-xs text-gray-700">${escapeHtml(notePreview)}</p>
                                                    </div>
                                                </div>
                                            </div>
                                        `}).join('')}
                                        ${inquiry.notes.length > 3 ? `
                                        <div class="p-2 text-center">
                                            <button onclick="viewInquiry('${inquiry._id}')" class="text-xs text-blue-600 hover:text-blue-800">
                                                View all ${inquiry.notes.length} notes
                                            </button>
                                        </div>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                            ` : `
                            <!-- No notes yet indicator -->
                            <div class="relative inline-block">
                                <button onclick="openReplyModal('${inquiry._id}')" class="text-gray-400 hover:text-purple-600 transition p-1.5 rounded-full hover:bg-purple-50" title="Add First Note">
                                    <i class="fas fa-comment-dots"></i>
                                </button>
                            </div>
                            `}
                            
                            <!-- Delete button -->
                            <button onclick="showDeleteModal('${inquiry._id}')" class="text-red-600 hover:text-red-800 transition p-1.5 rounded-full hover:bg-red-50" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `}).join('');
        }

        // Update statistics
        function updateStats(stats) {
            if (stats) {
                document.getElementById('totalCount').textContent = stats.totalInquiries?.toLocaleString() || '0';
                document.getElementById('newCount').textContent = stats.newInquiries?.toLocaleString() || '0';
                document.getElementById('chinaProcessingCount').textContent = stats.chinaProcessing?.toLocaleString() || '0';
                document.getElementById('pricingReadyCount').textContent = stats.pricingReady?.toLocaleString() || '0';
                document.getElementById('salesProcessingCount').textContent = stats.salesProcessing?.toLocaleString() || '0';
                document.getElementById('completedCount').textContent = stats.completed?.toLocaleString() || '0';
                document.getElementById('cancelledCount').textContent = stats.cancelled?.toLocaleString() || '0';
            }
        }

        // Update pagination
        function updatePagination(total, page, pages, perPage) {
            const pagination = document.getElementById('pagination');
            const info = document.getElementById('paginationInfo');
            
            if (!total || total === 0) {
                pagination.innerHTML = '';
                info.textContent = 'No inquiries found';
                return;
            }

            const start = ((page - 1) * perPage) + 1;
            const end = Math.min(page * perPage, total);
            info.textContent = `Showing ${start} to ${end} of ${total} inquiries`;

            let html = '';
            
            // Previous button
            html += `<button onclick="loadInquiries(${page - 1})" ${page === 1 ? 'disabled' : ''} 
                    class="px-3 py-1 rounded border ${page === 1 ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}">
                    <i class="fas fa-chevron-left"></i>
                </button>`;

            // Page numbers
            for (let i = 1; i <= pages; i++) {
                if (i === page) {
                    html += `<button class="px-3 py-1 rounded bg-blue-600 text-white font-medium">${i}</button>`;
                } else if (i === 1 || i === pages || (i >= page - 2 && i <= page + 2)) {
                    html += `<button onclick="loadInquiries(${i})" class="px-3 py-1 rounded border bg-white text-gray-700 hover:bg-gray-50">${i}</button>`;
                } else if (i === page - 3 || i === page + 3) {
                    html += `<span class="px-3 py-1">...</span>`;
                }
            }

            // Next button
            html += `<button onclick="loadInquiries(${page + 1})" ${page === pages ? 'disabled' : ''} 
                    class="px-3 py-1 rounded border ${page === pages ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}">
                    <i class="fas fa-chevron-right"></i>
                </button>`;

            pagination.innerHTML = html;
        }

        // Update line and character count
        document.getElementById('replyMessage').addEventListener('input', function() {
            const lines = this.value.split('\n').length;
            const chars = this.value.length;
            document.getElementById('lineCount').textContent = lines;
            document.getElementById('charCount').textContent = chars;
        });

        // Template insertion functions
        function insertTemplate(type) {
            const textarea = document.getElementById('replyMessage');
            const templates = {
                productList: 'Product List:\n- Item 1 - Qty 100 - $XX.XX\n- Item 2 - Qty 50 - $XX.XX\n- Item 3 - Qty 200 - $XX.XX\n\nAdditional Notes:',
                priceQuote: 'PRICE QUOTE\n' +
                        '='.repeat(40) + '\n' +
                        'Item                    Qty     Price   Total\n' +
                        '-'.repeat(40) + '\n' +
                        'Product A               100     $25.50  $2,550.00\n' +
                        'Product B               50      $12.75  $637.50\n' +
                        'Product C               200     $8.99   $1,798.00\n' +
                        '-'.repeat(40) + '\n' +
                        'SUBTOTAL                         $4,985.50\n' +
                        'SHIPPING                         $150.00\n' +
                        'TOTAL                            $5,135.50\n' +
                        '='.repeat(40)
            };
            
            textarea.value = templates[type];
            // Trigger the input event to update counts
            textarea.dispatchEvent(new Event('input'));
