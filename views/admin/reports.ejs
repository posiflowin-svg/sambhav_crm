      </div>
      <div class="header-actions">
        <button class="btn btn-light" id="stockManagement">
          <i class="bi bi-box-seam"></i> Stock Management
        </button>
        <button class="btn btn-light" id="inquiryManagement">
          <i class="bi bi-chat-dots"></i> Inquiry
        </button>
      </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
      <div class="filters-title">
        <i class="bi bi-funnel"></i>
        Filter Reports
