      <!-- Quick Period Filters -->
      <div class="quick-filters">
        <div class="quick-filter-btn active" data-period="today">Today</div>
        <div class="quick-filter-btn" data-period="week">This Week</div>
        <div class="quick-filter-btn" data-period="month">This Month</div>
