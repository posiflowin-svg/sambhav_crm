<script>
  class SalesDashboard {
    constructor() {
      this.currentFilters = {
        period: 'today',
        year: new Date().getFullYear()
      };
      this.currentUserId = null;
      this.currentUserName = null;
      
      this.init();
    }

    init() {
      this.bindEvents();
      this.loadReportsData();
    }

    bindEvents() {
      // Quick filter buttons
      document.querySelectorAll('.quick-filter-btn').forEach(btn => {
        btn.addEventListener('click', (e) => this.handleQuickFilter(e));
      });

      // Apply filters button
      document.getElementById('applyFilters').addEventListener('click', () => this.applyFilters());

      // Period filter change
      document.getElementById('periodFilter').addEventListener('change', (e) => this.handlePeriodChange(e));

      // Refresh data
      // document.getElementById('refreshData').addEventListener('click', () => this.refreshData());

      document.getElementById('stockManagement').addEventListener('click', () => {
          window.location.href = '/products';
      });

      document.getElementById('inquiryManagement').addEventListener('click', () => {
          window.location.href = '/inquiries';
      });
    }

    handleQuickFilter(event) {
      const period = event.currentTarget.dataset.period;
      
      // Update active state
      document.querySelectorAll('.quick-filter-btn').forEach(b => b.classList.remove('active'));
      event.currentTarget.classList.add('active');
      
      // Update period filter
      document.getElementById('periodFilter').value = period;
      
      // Apply filters
      this.currentFilters.period = period;
      this.loadReportsData();
    }

    handlePeriodChange(event) {
      const isCustom = event.target.value === 'custom';
      document.getElementById('customDateRange').style.display = isCustom ? 'block' : 'none';
      document.getElementById('customDateRangeEnd').style.display = isCustom ? 'block' : 'none';
    }

    applyFilters() {
      const period = document.getElementById('periodFilter').value;
      const year = document.getElementById('yearFilter').value;
      
      this.currentFilters = { period, year };
      
      if (period === 'custom') {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        
        if (!startDate || !endDate) {
          this.showError('Please select both start and end dates');
          return;
        }
        
        this.currentFilters.startDate = startDate;
        this.currentFilters.endDate = endDate;
      }
      
      // Update quick filter active state
      document.querySelectorAll('.quick-filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.period === period);
      });
      
      this.loadReportsData();
    }

    async loadReportsData() {
      try {
        this.showLoading();
        
        const queryParams = new URLSearchParams(this.currentFilters).toString();
        const response = await fetch(`/api/admin/reports/sales-overview?${queryParams}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        
        this.updateOverallStats(data.overallStats);
        this.updateUserSalesTable(data.userSales);
        this.updateReportSummary(this.currentFilters.period);
        this.hideLoading();
        
      } catch (error) {
        console.error('Error loading reports:', error);
        this.hideLoading();
        this.showError('Failed to load reports data');
      }
    }

    updateOverallStats(stats) {
      const container = document.getElementById('overallStats');
      
      container.innerHTML = `
        <div class="stat-card">
          <h3>Total Orders</h3>
          <div class="value">${stats.totalOrders.toLocaleString()}</div>
          <div class="comparison">All users combined</div>
        </div>
        <div class="stat-card">
          <h3>Total Revenue</h3>
          <div class="value">₹${stats.totalRevenue.toLocaleString()}</div>
          <div class="comparison">Gross revenue</div>
        </div>
        <div class="stat-card">
          <h3>Total Tax</h3>
          <div class="value">₹${stats.totalTax.toLocaleString()}</div>
          <div class="comparison">GST collected</div>
        </div>
      `;
    }

    updateUserSalesTable(userSales) {
      const tbody = document.getElementById('userSalesBody');
      
      if (!userSales || userSales.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-5">
              <div class="empty-state">
                <i class="bi bi-inbox display-4 text-muted"></i>
                <h4 class="mt-3">No Data Available</h4>
                <p class="text-muted">No sales data found for the selected period</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = userSales.map(user => `
        <tr>
          <td>
            <div class="user-info">
              <strong>${this.escapeHtml(user.userName || 'Unknown User')}</strong>
              <small class="text-muted">${this.escapeHtml(user.userEmail || 'N/A')}</small>
            </div>
          </td>
          <td>
            <span class="fw-bold">${user.totalOrders.toLocaleString()}</span>
          </td>
          <td>
            <strong class="text-success">₹${user.totalRevenue.toLocaleString()}</strong>
          </td>
          <td>₹${user.totalTax.toLocaleString()}</td>
          <td>
            <button class="btn btn-sm btn-outline-primary view-user-orders" 
                    data-user-id="${user.userId}"
                    data-user-name="${this.escapeHtml(user.userName)}">
              <i class="bi bi-list-ul"></i> View Orders
            </button>
          </td>
        </tr>
      `).join('');

      // Add event listeners to view buttons
      document.querySelectorAll('.view-user-orders').forEach(button => {
        button.addEventListener('click', (e) => {
          const userId = e.currentTarget.dataset.userId;
          const userName = e.currentTarget.dataset.userName;
          this.viewUserOrders(userId, userName);
        });
      });
    }

    async viewUserOrders(userId, userName) {
      try {
        this.showLoading();
        
        this.currentUserId = userId;
        this.currentUserName = userName;
        
        // Include current filters in the request
        const queryParams = new URLSearchParams({
          ...this.currentFilters,
          page: 1,
          limit: 10
        }).toString();
        
        const response = await fetch(`/api/admin/reports/user/${userId}?${queryParams}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        this.updateUserModal(data, userName);
        
        const modal = new bootstrap.Modal(document.getElementById('userDetailsModal'));
        modal.show();
        this.hideLoading();
        
      } catch (error) {
        console.error('Error loading user orders:', error);
        this.hideLoading();
        this.showError('Failed to load user orders');
      }
    }

    updateUserModal(data, userName) {
      // Update modal title
      document.getElementById('userModalTitle').innerHTML = `
        <i class="bi bi-person-badge me-2"></i>
        Order History - ${this.escapeHtml(userName)}
        <span class="badge bg-primary ms-2">${data.user.role}</span>
      `;

      // Update period info
      document.getElementById('modalPeriodInfo').textContent = 
        `Showing orders for: ${this.getPeriodDisplay(this.currentFilters.period)}`;

      // Update user stats
      document.getElementById('userStats').innerHTML = this.getUserStatsHTML(data.userStats);
      
      // Update orders table
      this.updateUserOrdersTable(data.orders);
      
      // Update customer type filters
      this.updateCustomerTypeFilters();
      
      // Update pagination
      this.updatePagination(data.pagination);
    }

    getUserStatsHTML(userStats) {
      const adminPercentage = userStats.lifetimeRevenue > 0
        ? Math.round((userStats.adminCustomerRevenue / userStats.lifetimeRevenue) * 100) : 0;
      const salesRepeatPercentage = userStats.lifetimeRevenue > 0
        ? Math.round((userStats.salesPersonRepeatRevenue / userStats.lifetimeRevenue) * 100) : 0;
      const salesNewPercentage = userStats.lifetimeRevenue > 0
        ? Math.round((userStats.salesPersonNewRevenue / userStats.lifetimeRevenue) * 100) : 0;

      return `
        <div class="user-performance-grid">
          <!-- Orders Card -->
          <div class="performance-card overall">
            <div class="performance-icon">
              <i class="bi bi-cart-check"></i>
            </div>
            <div class="performance-content">
              <div class="performance-value">${userStats.lifetimeOrders}</div>
              <div class="performance-label">Total Orders</div>
              <div class="performance-breakdown">
                <span class="breakdown-item admin">
                  <i class="bi bi-person-gear"></i> ${userStats.adminCustomerOrders} Admin
                </span>
                <span class="breakdown-item repeat">
                  <i class="bi bi-arrow-repeat"></i> ${userStats.salesPersonRepeatOrders} Repeat
                </span>
                <span class="breakdown-item new-order">
                  <i class="bi bi-cart-plus"></i> ${userStats.salesPersonNewOrders} New
                </span>
              </div>
            </div>
          </div>

          <!-- Revenue Card -->
          <div class="performance-card overall">
            <div class="performance-icon revenue">
              <i class="bi bi-currency-rupee"></i>
            </div>
            <div class="performance-content">
              <div class="performance-value">₹${userStats.lifetimeRevenue.toLocaleString()}</div>
              <div class="performance-label">Total Revenue</div>
              <div class="performance-breakdown">
                <span class="breakdown-item admin">
                  <i class="bi bi-person-gear"></i> ₹${userStats.adminCustomerRevenue.toLocaleString()}
                </span>
                <span class="breakdown-item repeat">
                  <i class="bi bi-arrow-repeat"></i> ₹${userStats.salesPersonRepeatRevenue.toLocaleString()}
                </span>
                <span class="breakdown-item new-order">
                  <i class="bi bi-cart-plus"></i> ₹${userStats.salesPersonNewRevenue.toLocaleString()}
                </span>
              </div>
            </div>
          </div>

          <!-- Tax Card -->
          <div class="performance-card">
            <div class="performance-icon tax">
              <i class="bi bi-receipt"></i>
            </div>
            <div class="performance-content">
              <div class="performance-value">₹${userStats.lifetimeTax.toLocaleString()}</div>
              <div class="performance-label">Total Tax</div>
            </div>
          </div>
        </div>

        <!-- Revenue Distribution with 3-way split -->
        <div class="revenue-distribution">
          <h6 class="distribution-title">
            <i class="bi bi-pie-chart me-2"></i>
            Revenue Distribution
          </h6>

          <div class="distribution-container">
            <div class="chart-container">
              <div class="circular-chart">
                <svg viewBox="0 0 36 36">
                  <defs>
                    <linearGradient id="adminGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#667eea" />
                      <stop offset="100%" stop-color="#764ba2" />
                    </linearGradient>
                    <linearGradient id="repeatGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#f59e0b" />
                      <stop offset="100%" stop-color="#d97706" />
                    </linearGradient>
                    <linearGradient id="newGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#10b981" />
                      <stop offset="100%" stop-color="#059669" />
                    </linearGradient>
                  </defs>
                  <path class="circle-bg"
                    d="M18 2.0845
                    a 15.9155 15.9155 0 0 1 0 31.831
                    a 15.9155 15.9155 0 0 1 0 -31.831"
                  />
                  ${adminPercentage > 0 ? `
                  <path class="circle progress-circle"
                    d="M18 2.0845
                    a 15.9155 15.9155 0 0 1 0 31.831
                    a 15.9155 15.9155 0 0 1 0 -31.831"
                    stroke-dasharray="${adminPercentage} ${100 - adminPercentage}"
                    stroke="url(#adminGradient)"
                  />` : ''}
                  ${salesRepeatPercentage > 0 ? `
                  <path class="circle progress-circle"
                    d="M18 2.0845
                    a 15.9155 15.9155 0 0 1 0 31.831
                    a 15.9155 15.9155 0 0 1 0 -31.831"
                    stroke-dasharray="${salesRepeatPercentage} ${100 - salesRepeatPercentage}"
                    stroke-dashoffset="-${adminPercentage}"
                    stroke="url(#repeatGradient)"
                  />` : ''}
                  ${salesNewPercentage > 0 ? `
                  <path class="circle progress-circle"
                    d="M18 2.0845
                    a 15.9155 15.9155 0 0 1 0 31.831
                    a 15.9155 15.9155 0 0 1 0 -31.831"
                    stroke-dasharray="${salesNewPercentage} ${100 - salesNewPercentage}"
                    stroke-dashoffset="-${adminPercentage + salesRepeatPercentage}"
                    stroke="url(#newGradient)"
                  />` : ''}
                </svg>
                <div class="chart-center">
                  <div class="total-revenue">₹${userStats.lifetimeRevenue.toLocaleString()}</div>
                  <div class="total-label">Total Revenue</div>
                </div>
              </div>
              <div class="chart-legend">
                <div class="legend-item">
                  <div class="legend-color admin-color"></div>
                  <span>Admin</span>
                </div>
                <div class="legend-item">
                  <div class="legend-color repeat-color"></div>
                  <span>Repeat</span>
                </div>
                <div class="legend-item">
                  <div class="legend-color new-color"></div>
                  <span>New</span>
                </div>
              </div>
            </div>

            <div class="distribution-chart">
              <!-- Admin Bar -->
              <div class="distribution-item admin-distribution">
                <div class="distribution-bar-container">
                  <div class="distribution-bar" style="width: ${adminPercentage}%"></div>
                </div>
                <div class="distribution-info">
                  <span class="distribution-label">
                    <i class="bi bi-person-gear"></i> Admin
                  </span>
                  <span class="distribution-value">
                    ₹${userStats.adminCustomerRevenue.toLocaleString()} (${adminPercentage}%)
                  </span>
                </div>
              </div>
              <!-- Repeat Bar -->
              <div class="distribution-item repeat-distribution">
                <div class="distribution-bar-container">
                  <div class="distribution-bar" style="width: ${salesRepeatPercentage}%"></div>
                </div>
                <div class="distribution-info">
                  <span class="distribution-label">
                    <i class="bi bi-arrow-repeat"></i> Repeat
                  </span>
                  <span class="distribution-value">
                    ₹${userStats.salesPersonRepeatRevenue.toLocaleString()} (${salesRepeatPercentage}%)
                  </span>
                </div>
              </div>
              <!-- New Bar -->
              <div class="distribution-item new-distribution">
                <div class="distribution-bar-container">
                  <div class="distribution-bar" style="width: ${salesNewPercentage}%"></div>
                </div>
                <div class="distribution-info">
                  <span class="distribution-label">
                    <i class="bi bi-cart-plus"></i> New
                  </span>
                  <span class="distribution-value">
                    ₹${userStats.salesPersonNewRevenue.toLocaleString()} (${salesNewPercentage}%)
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    updateUserOrdersTable(orders) {
      const tbody = document.getElementById('userOrdersBody');
      
      if (!orders || orders.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="text-center py-5">
              <div class="empty-state">
                <i class="bi bi-cart-x display-4 text-muted"></i>
                <h4 class="mt-3">No Orders Found</h4>
                <p class="text-muted">No orders found for the selected period and filters</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = orders.map(order => `
        <tr>
          <td>
            <div class="order-id-container">
              <strong>${this.escapeHtml(order.invoiceNo)}</strong>
              <small class="text-muted d-block">${order.orderId}</small>
            </div>
          </td>
          <td>
            <div class="customer-info">
              <strong>${this.escapeHtml(order.customerName)}</strong>
              <div class="customer-type-badge ${order.customerType === 'Admin Customer' ? 'admin-customer' : 'sales-customer'}">
                <i class="bi ${order.customerType === 'Admin Customer' ? 'bi-person-gear' : 'bi-person-badge'} me-1"></i>
                ${order.customerType}
              </div>
            </div>
          </td>
          <td>
            <strong class="text-success">₹${order.totalAmount.toLocaleString()}</strong>
          </td>
          <td>₹${order.gstAmount.toLocaleString()}</td>
          <td>
            <span class="badge type-${order.orderType}">
              ${order.orderType.toUpperCase()}
            </span>
          </td>
          <td>
            <span class="badge status-${order.status}">
              ${order.status.charAt(0).toUpperCase() + order.status.slice(1)}
            </span>
          </td>
          <td>
            <div class="date-container">
              <div class="order-date">${new Date(order.orderDate).toLocaleDateString()}</div>
              <small class="text-muted">Due: ${new Date(order.dueDate).toLocaleDateString()}</small>
            </div>
          </td>
          <td>
            <div class="action-buttons">
              <a href="/admin/orders/${order.orderId}" class="btn btn-sm btn-outline-primary" title="View Order">
                <i class="bi bi-eye"></i>
              </a>
            </div>
          </td>
        </tr>
      `).join('');
    }

    updateCustomerTypeFilters() {
      document.getElementById('customerTypeFilters').innerHTML = `
        <div class="btn-group btn-group-sm" role="group">
          <input type="radio" class="btn-check" name="customerTypeFilter" id="filterAll" autocomplete="off" checked>
          <label class="btn btn-outline-primary" for="filterAll">
            <i class="bi bi-collection"></i> All Orders
          </label>

          <input type="radio" class="btn-check" name="customerTypeFilter" id="filterAdmin" autocomplete="off">
          <label class="btn btn-outline-admin" for="filterAdmin">
            <i class="bi bi-person-gear"></i> Admin Customers
          </label>

          <input type="radio" class="btn-check" name="customerTypeFilter" id="filterSales" autocomplete="off">
          <label class="btn btn-outline-sales" for="filterSales">
            <i class="bi bi-person-badge"></i> Sales Customers
          </label>
        </div>
      `;

      // Add event listeners
      document.getElementById('filterAll').addEventListener('change', () => this.loadFilteredUserOrders('all'));
      document.getElementById('filterAdmin').addEventListener('change', () => this.loadFilteredUserOrders('admin'));
      document.getElementById('filterSales').addEventListener('change', () => this.loadFilteredUserOrders('sales'));
    }

    async loadFilteredUserOrders(customerType = 'all') {
      if (!this.currentUserId) return;

      try {
        this.showLoading();
        
        const queryParams = new URLSearchParams({
          ...this.currentFilters,
          customerType,
          page: 1,
          limit: 10
        }).toString();
        
        const response = await fetch(`/api/admin/reports/user/${this.currentUserId}?${queryParams}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        this.updateUserOrdersTable(data.orders);
        this.updatePagination(data.pagination);
        this.hideLoading();
        
      } catch (error) {
        console.error('Error loading filtered orders:', error);
        this.hideLoading();
        this.showError('Failed to load filtered orders');
      }
    }

    updatePagination(pagination) {
      const container = document.getElementById('userPagination');
      
      if (!pagination || pagination.totalPages <= 1) {
        container.innerHTML = '';
        return;
      }

      container.innerHTML = `
        <div class="pagination-info">
          Showing page ${pagination.currentPage} of ${pagination.totalPages}
        </div>
        <nav>
          <ul class="pagination pagination-sm">
            <li class="page-item ${pagination.hasPrev ? '' : 'disabled'}">
              <a class="page-link" href="#" data-page="${pagination.currentPage - 1}">Previous</a>
            </li>
            ${Array.from({length: pagination.totalPages}, (_, i) => i + 1).map(page => `
              <li class="page-item ${page === pagination.currentPage ? 'active' : ''}">
                <a class="page-link" href="#" data-page="${page}">${page}</a>
              </li>
            `).join('')}
            <li class="page-item ${pagination.hasNext ? '' : 'disabled'}">
              <a class="page-link" href="#" data-page="${pagination.currentPage + 1}">Next</a>
            </li>
          </ul>
        </nav>
      `;

      // Add pagination event listeners
      container.querySelectorAll('.page-link').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const page = e.target.dataset.page;
          if (page) this.loadUserOrdersPage(parseInt(page));
        });
      });
    }

    async loadUserOrdersPage(page) {
      if (!this.currentUserId) return;

      try {
        this.showLoading();
        
        const queryParams = new URLSearchParams({
          ...this.currentFilters,
          page,
          limit: 10
        }).toString();
        
        const response = await fetch(`/api/admin/reports/user/${this.currentUserId}?${queryParams}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        this.updateUserOrdersTable(data.orders);
        this.updatePagination(data.pagination);
        this.hideLoading();
        
      } catch (error) {
        console.error('Error loading orders page:', error);
        this.hideLoading();
        this.showError('Failed to load orders');
      }
    }

    refreshData() {
      const refreshBtn = document.getElementById('refreshData');
      const originalHTML = refreshBtn.innerHTML;
      
      refreshBtn.innerHTML = '<div class="loading-spinner"></div> Refreshing...';
      refreshBtn.disabled = true;
      
      this.loadReportsData().finally(() => {
        refreshBtn.innerHTML = originalHTML;
        refreshBtn.disabled = false;
      });
    }

    updateReportSummary(period) {
      document.getElementById('reportSummary').textContent = 
        `Showing data for ${this.getPeriodDisplay(period)}`;
    }

    getPeriodDisplay(period) {
      const periods = {
        'today': 'Today',
        'yesterday': 'Yesterday',
        'week': 'This Week',
        'month': 'This Month',
        'year': 'This Year',
        'custom': 'Custom Range'
      };
      return periods[period] || period;
    }

    escapeHtml(unsafe) {
      if (!unsafe) return '';
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    showLoading() {
      document.body.classList.add('loading');
    }

    hideLoading() {
      document.body.classList.remove('loading');
    }

    showError(message) {
      // You can replace this with a better notification system
      const alertDiv = document.createElement('div');
      alertDiv.className = 'alert alert-danger alert-dismissible fade show';
      alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      `;
      
      document.querySelector('.reports-container').prepend(alertDiv);
      
      // Auto remove after 5 seconds
      setTimeout(() => {
        if (alertDiv.parentNode) {
          alertDiv.remove();
        }
      }, 5000);
    }
  }

  // Initialize dashboard when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    // Set default dates for custom range
    const today = new Date().toISOString().split('T')[0];
    const lastMonth = new Date();
    lastMonth.setMonth(lastMonth.getMonth() - 1);
    const lastMonthStr = lastMonth.toISOString().split('T')[0];
    
    document.getElementById('startDate').value = lastMonthStr;
    document.getElementById('endDate').value = today;
    
    // Initialize dashboard
    new SalesDashboard();
  });
</script>