<!-- views/admin/layout.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Admin Dashboard' %> - Order Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: calc(100vh - 56px);
            background: #2c3e50;
        }
        .sidebar .nav-link {
            color: #ecf0f1;
            border-radius: 0.375rem;
            margin: 0.125rem 0.5rem;
            transition: all 0.3s;
        }
        .sidebar .nav-link:hover {
            background: #34495e;
            color: #3498db;
        }
        .sidebar .nav-link.active {
            background: #3498db;
            color: white;
        }
        .sidebar .nav-link i {
            width: 20px;
            margin-right: 10px;
        }
        .stat-card {
            border-radius: 10px;
            transition: transform 0.3s;
            border: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .stat-card:hover {
            transform: translateY(-5px);
        }
        .bg-gradient-primary { background: linear-gradient(45deg, #3498db, #2980b9); }
        .bg-gradient-success { background: linear-gradient(45deg, #27ae60, #229954); }
        .bg-gradient-warning { background: linear-gradient(45deg, #f39c12, #e67e22); }
        .bg-gradient-info { background: linear-gradient(45deg, #17a2b8, #138496); }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin/dashboard">
                <i class="fas fa-tachometer-alt me-2"></i>
                Order Management System
            </a>
            <div class="d-flex">
                <span class="navbar-text me-3">
                    <i class="fas fa-user me-1"></i> <%= user.name %> (Admin)
                </span>
                <a class="btn btn-outline-light btn-sm" href="/auth/logout">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar p-3">
                <nav class="nav flex-column">
                    <a class="nav-link <%= activeTab === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a class="nav-link <%= activeTab === 'users' ? 'active' : '' %>" href="/admin/users">
                        <i class="fas fa-users"></i> Users
                    </a>
                    <a class="nav-link <%= activeTab === 'orders' ? 'active' : '' %>" href="/admin/orders">
                        <i class="fas fa-shopping-cart"></i> Orders
                    </a>
                    <a class="nav-link <%= activeTab === 'reports' ? 'active' : '' %>" href="/admin/reports">
                        <i class="fas fa-chart-bar"></i> Reports
                    </a>
                    <a class="nav-link <%= activeTab === 'customers' ? 'active' : '' %>" href="/customers">
                        <i class="fas fa-user-friends"></i> Customers
                    </a>
                </nav>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 ms-sm-auto px-4 py-4">
                <%- body %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>
</html>