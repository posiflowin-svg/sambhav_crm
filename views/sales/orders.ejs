  <div class="page-header">
    <div>
      <h1 class="page-title">Order Management</h1>
      <p class="page-subtitle">Manage and track all your customer orders</p>
    </div>
    <div class="header-actions">
      <a href="/sales/orders/create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i> Create New Order
      </a>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon primary">
        <i class="bi bi-cart-check"></i>
      </div>
      <div class="stat-content">
        <div class="stat-value" id="totalOrders">0</div>
        <div class="stat-label">Total Orders</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon warning">
        <i class="bi bi-clock-history"></i>
      </div>
      <div class="stat-content">
        <div class="stat-value" id="pendingOrders">0</div>
        <div class="stat-label">Pending Approval</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon info">
        <i class="bi bi-calendar-month"></i>
      </div>
      <div class="stat-content">
        <div class="stat-value" id="monthlyOrders">0</div>
        <div class="stat-label">This Month</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon success">
        <i class="bi bi-currency-rupee"></i>
      </div>
      <div class="stat-content">
        <div class="stat-value">₹<span id="totalRevenue">0</span></div>
        <div class="stat-label">Total Revenue</div>
      </div>
    </div>
  </div>

  <!-- Search and Filters Section -->
  <div class="filters-section">
    <div class="filters-header">
      <h5 class="mb-0">
        <i class="bi bi-funnel me-2"></i>Search & Filters
      </h5>
      <div class="filters-actions">
        <button class="btn btn-sm btn-outline-secondary" id="toggleFilters">
          <i class="bi bi-chevron-down"></i> Toggle Filters
        </button>
      </div>
    </div>
    
    <div class="filters-content" id="filtersContent">
      <!-- Search Form -->
      <form id="searchForm" class="search-form mb-4">
        <div class="search-group">
          <label class="form-label">Search Orders</label>
          <div class="search-input-container">
            <input 
              type="text" 
              id="searchQuery"
              class="form-control"
              placeholder="Search by customer name, invoice number, product..." 
            >
            <i class="bi bi-search search-icon"></i>
          </div>
        </div>
        <div class="search-actions">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-search me-2"></i> Search
          </button>
          <button type="button" class="btn btn-outline-secondary" id="resetFilters">
            <i class="bi bi-arrow-clockwise me-2"></i> Reset
          </button>
        </div>
      </form>

      <!-- Advanced Filters -->
      <form id="filterForm" class="filter-grid">
        <div class="filter-group">
          <label class="form-label">Order Status</label>
          <select name="status" class="form-select">
            <option value="">All Status</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="dispatched">Dispatched</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label class="form-label">Order Type</label>
          <select name="orderType" class="form-select">
            <option value="">All Types</option>
            <option value="cod">COD</option>
            <option value="prepaid">Prepaid</option>
            <option value="credit">Credit</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label class="form-label">Date Range</label>
          <select name="dateRange" class="form-select" id="dateRangeSelect">
            <option value="">Select Range</option>
            <option value="today">Today</option>
            <option value="yesterday">Yesterday</option>
            <option value="this_week">This Week</option>
            <option value="last_week">Last Week</option>
            <option value="this_month">This Month</option>
            <option value="last_month">Last Month</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label class="form-label">From Date</label>
          <input type="date" name="dateFrom" class="form-control" id="dateFrom">
        </div>
        
        <div class="filter-group">
          <label class="form-label">To Date</label>
          <input type="date" name="dateTo" class="form-control" id="dateTo">
        </div>
        
        <div class="filter-group">
          <label class="form-label">Sort By</label>
          <select name="sortBy" class="form-select">
            <option value="createdAt">Order Date</option>
            <option value="dueDate">Due Date</option>
            <option value="totalAmount">Order Amount</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label class="form-label">Sort Order</label>
          <select name="sortOrder" class="form-select">
            <option value="desc">Newest First</option>
            <option value="asc">Oldest First</option>
          </select>
        </div>
      </form>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="table-section">
    <div class="table-header">
      <h5 class="mb-0">Order List</h5>
      <div class="table-actions">
        <span class="text-muted" id="tableSummary">Showing all orders</span>
      </div>
    </div>
    
    <div class="table-container">
      <div class="table-responsive">
        <table class="table table-hover" id="ordersTable">
          <thead>
            <tr>
              <th>Order Details</th>
              <th>Customer</th>
              <th>Products</th>
              <th>Amount</th>
              <th>Type</th>
              <th>Status</th>
              <th>Dates</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="ordersTableBody">
            <tr>
              <td colspan="8" class="text-center py-4">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Loading orders...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div id="pagination" class="d-flex justify-content-between align-items-center mt-4">
        <!-- Pagination will be loaded here -->
      </div>
    </div>
  </div>
</div>

<script>
class SalesOrdersManager {
  constructor() {
    this.currentPage = 1;
    this.ordersPerPage = 10;
    this.currentFilters = {};
    this.isLoading = false;
    
    this.init();
  }

  init() {
    this.bindEvents();
    this.loadOrders();
    this.setDefaultDates();
  }

  bindEvents() {
    // Search form
    document.getElementById('searchForm').addEventListener('submit', (e) => {
      e.preventDefault();
      this.loadOrders(1);
    });

    // Reset filters
    document.getElementById('resetFilters').addEventListener('click', () => this.resetFilters());

    // Toggle filters
    document.getElementById('toggleFilters').addEventListener('click', () => this.toggleFilters());

    // Filter change events with debouncing
    const filterElements = document.querySelectorAll('#filterForm select, #filterForm input');
    filterElements.forEach(element => {
      element.addEventListener('change', () => {
        this.debouncedLoadOrders();
      });
    });

    // Date range change
    document.getElementById('dateRangeSelect').addEventListener('change', (e) => {
      this.handleDateRangeChange(e.target.value);
    });
  }

  debouncedLoadOrders() {
    if (this.debounceTimer) clearTimeout(this.debounceTimer);
    this.debounceTimer = setTimeout(() => this.loadOrders(1), 300);
  }

  setDefaultDates() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('dateTo').value = today;
    
    // Set default from date to 30 days ago
    const thirtyDaysAgo = new Date();
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
    document.getElementById('dateFrom').value = thirtyDaysAgo.toISOString().split('T')[0];
  }

  async loadOrders(page = 1) {
    if (this.isLoading) return;
    
    this.currentPage = page;
    this.isLoading = true;
    
    try {
      this.showLoading();
      
      const params = this.buildQueryParams();
      params.append('page', page);
      params.append('limit', this.ordersPerPage);

      const response = await fetch(`/api/sales/orders?${params}`);
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const data = await response.json();
      
      if (!data.success && data.message) {
        throw new Error(data.message);
      }
      
      this.updateOrdersTable(data.orders || []);
      this.updatePagination(data.total || 0, data.pages || 1);
      this.updateStats(data.stats || {});
      this.updateTableSummary(data.total || 0);
      
    } catch (error) {
      console.error('Error loading orders:', error);
      this.showError('Failed to load orders. Please try again.');
    } finally {
      this.isLoading = false;
    }
  }

  buildQueryParams() {
    const params = new URLSearchParams();
    const formData = new FormData(document.getElementById('filterForm'));
    
    // Add filter parameters
    for (let [key, value] of formData.entries()) {
      if (value) {
        params.append(key, value);
      }
    }
    
    // Add search query
    const searchQuery = document.getElementById('searchQuery').value.trim();
    if (searchQuery) {
      params.append('search', searchQuery);
    }

    return params;
  }

  updateOrdersTable(orders) {
    const tbody = document.getElementById('ordersTableBody');
    
    if (!orders || orders.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-5">
            <div class="empty-state">
              <i class="bi bi-inbox display-4 text-muted mb-3"></i>
              <h4 class="text-muted">No orders found</h4>
              <p class="text-muted">No orders match your current search criteria</p>
              <button class="btn btn-primary mt-2" onclick="salesOrdersManager.resetFilters()">
                <i class="bi bi-arrow-clockwise me-2"></i> Clear Filters
              </button>
            </div>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = orders.map(order => `
      <tr>
        <td>
          <div class="order-info">
            <div class="order-id">#${this.escapeHtml(order.invoiceNo || order.orderId || order._id?.slice(-6).toUpperCase() || 'N/A')}</div>
            <div class="order-meta">
              <small class="text-muted">Created: ${new Date(order.createdAt).toLocaleDateString()}</small>
            </div>
          </div>
        </td>
        <td>
          <div class="customer-info">
            <strong class="customer-name">${this.escapeHtml(order.customer?.name || 'N/A')}</strong>
            ${order.customer?.mobileNumber ? `
              <div class="customer-contact text-muted">
                <small>${this.escapeHtml(order.customer.mobileNumber)}</small>
              </div>
            ` : ''}
          </div>
        </td>
        <td>
          <div class="products-info">
            <span class="products-count">${order.products?.length || 0} items</span>
            ${order.products && order.products.length > 0 ? `
              <div class="product-preview text-muted">
                <small>${this.escapeHtml(order.products[0].name)}${order.products.length > 1 ? ' +' + (order.products.length - 1) + ' more' : ''}</small>
              </div>
            ` : ''}
          </div>
        </td>
        <td>
          <div class="amount-info">
            <strong class="text-success">₹${(order.totalAmount || 0).toLocaleString()}</strong>
            ${order.gstAmount ? `
              <div class="tax-amount text-muted">
                <small>incl. ₹${order.gstAmount.toLocaleString()} GST</small>
              </div>
            ` : ''}
          </div>
        </td>
        <td>
          <span class="badge type-${order.orderType}">
            ${(order.orderType || 'N/A').toUpperCase()}
          </span>
        </td>
        <td>
          <span class="badge status-${order.status}">
            ${this.getStatusDisplay(order.status)}
          </span>
        </td>
        <td>
          <div class="dates-info">
            <div class="order-date">
              <small class="text-muted">Ordered:</small>
              <div>${new Date(order.orderDate || order.createdAt).toLocaleDateString()}</div>
            </div>
            <div class="due-date">
              <small class="text-muted">Due:</small>
              <div class="${this.isDueSoon(order.dueDate) ? 'due-soon' : ''}">
                ${new Date(order.dueDate).toLocaleDateString()}
              </div>
            </div>
          </div>
        </td>
        <td>
          <div class="action-buttons">
            <a href="/sales/orders/${order._id || order.orderId}" class="btn btn-outline-primary btn-sm" title="View Order Details">
              <i class="bi bi-eye"></i>
            </a>
            
            <!-- Edit Button - Only show for pending orders -->
            ${order.status === 'pending' ? `
              <a href="/sales/orders/${order._id || order.orderId}/edit" class="btn btn-outline-warning btn-sm" title="Edit Order">
                <i class="bi bi-pencil"></i>
              </a>
            ` : ''}
            
            ${!order.piDocument?.original ? `
              <a href="/sales/orders/${order._id || order.orderId}?uploadPI=true" class="btn btn-outline-info btn-sm" title="Upload Documents">
                <i class="bi bi-cloud-upload"></i>
              </a>
            ` : ''}
          </div>
        </td>
      </tr>
    `).join('');
  }

  getStatusDisplay(status) {
    const statusMap = {
      'pending': 'Pending',
      'approved': 'Approved',
      'dispatched': 'Dispatched',
      'delivered': 'Delivered',
      'cancelled': 'Cancelled'
    };
    return statusMap[status] || 'Pending';
  }

  isDueSoon(dueDate) {
    if (!dueDate) return false;
    const due = new Date(dueDate);
    const today = new Date();
    const daysDiff = Math.ceil((due - today) / (1000 * 60 * 60 * 24));
    return daysDiff <= 3 && daysDiff >= 0; // Due within 3 days
  }

  updatePagination(total, totalPages) {
    const pagination = document.getElementById('pagination');
    
    if (total === 0) {
      pagination.innerHTML = '';
      return;
    }

    const startItem = ((this.currentPage - 1) * this.ordersPerPage) + 1;
    const endItem = Math.min(this.currentPage * this.ordersPerPage, total);

    let paginationHTML = `
      <div class="pagination-info">
        <span class="text-muted">Showing ${startItem}-${endItem} of ${total} orders</span>
      </div>
      <nav>
        <ul class="pagination pagination-sm mb-0">
    `;

    // Previous button
    paginationHTML += `
      <li class="page-item ${this.currentPage === 1 ? 'disabled' : ''}">
        <a class="page-link" href="#" onclick="salesOrdersManager.loadOrders(${this.currentPage - 1}); return false;">
          <i class="bi bi-chevron-left"></i>
        </a>
      </li>
    `;

    // Page numbers
    const maxVisiblePages = 5;
    let startPage = Math.max(1, this.currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
    
    if (endPage - startPage + 1 < maxVisiblePages) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }

    // First page and ellipsis
    if (startPage > 1) {
      paginationHTML += `
        <li class="page-item">
          <a class="page-link" href="#" onclick="salesOrdersManager.loadOrders(1); return false;">1</a>
        </li>
        ${startPage > 2 ? '<li class="page-item disabled"><span class="page-link">...</span></li>' : ''}
      `;
    }

    // Page numbers
    for (let i = startPage; i <= endPage; i++) {
      paginationHTML += `
        <li class="page-item ${i === this.currentPage ? 'active' : ''}">
          <a class="page-link" href="#" onclick="salesOrdersManager.loadOrders(${i}); return false;">${i}</a>
        </li>
      `;
    }

    // Last page and ellipsis
    if (endPage < totalPages) {
      paginationHTML += `
        ${endPage < totalPages - 1 ? '<li class="page-item disabled"><span class="page-link">...</span></li>' : ''}
        <li class="page-item">
          <a class="page-link" href="#" onclick="salesOrdersManager.loadOrders(${totalPages}); return false;">${totalPages}</a>
        </li>
      `;
    }

    // Next button
    paginationHTML += `
      <li class="page-item ${this.currentPage === totalPages ? 'disabled' : ''}">
        <a class="page-link" href="#" onclick="salesOrdersManager.loadOrders(${this.currentPage + 1}); return false;">
          <i class="bi bi-chevron-right"></i>
        </a>
      </li>
    `;

    paginationHTML += '</ul></nav>';
    pagination.innerHTML = paginationHTML;
  }

  updateStats(stats) {
    // Helper to format currency safely
    const formatNumber = (num) => {
      const value = parseFloat(num) || 0;
      // Show up to 2 decimal places
      return value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    // Update stats with current filter results
    document.getElementById('totalOrders').textContent = (stats.totalOrders || stats.total || 0).toLocaleString();
    document.getElementById('pendingOrders').textContent = (stats.pendingOrders || stats.pending || 0).toLocaleString();
    document.getElementById('monthlyOrders').textContent = (stats.monthlyOrders || stats.thisMonth || 0).toLocaleString();
    
    // Properly format total revenue
    document.getElementById('totalRevenue').textContent = (stats.totalRevenue || stats.revenue || 0).toLocaleString();
  }


  updateTableSummary(total) {
    const summary = document.getElementById('tableSummary');
    if (total === 0) {
      summary.textContent = 'No orders found';
    } else {
      summary.textContent = `Showing ${total} order${total !== 1 ? 's' : ''}`;
    }
  }

  handleDateRangeChange(range) {
    const dateFrom = document.getElementById('dateFrom');
    const dateTo = document.getElementById('dateTo');
    
    const today = new Date();
    let fromDate, toDate;

    switch (range) {
      case 'today':
        fromDate = new Date(today);
        toDate = new Date(today);
        break;
      case 'yesterday':
        fromDate = new Date(today);
        fromDate.setDate(today.getDate() - 1);
        toDate = new Date(fromDate);
        break;
      case 'this_week':
        fromDate = new Date(today);
        fromDate.setDate(today.getDate() - today.getDay());
        toDate = new Date(fromDate);
        toDate.setDate(fromDate.getDate() + 6);
        break;
      case 'last_week':
        fromDate = new Date(today);
        fromDate.setDate(today.getDate() - today.getDay() - 7);
        toDate = new Date(fromDate);
        toDate.setDate(fromDate.getDate() + 6);
        break;
      case 'this_month':
        fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
        toDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
        break;
      case 'last_month':
        fromDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
        toDate = new Date(today.getFullYear(), today.getMonth(), 0);
        break;
      default:
        return;
    }

    dateFrom.value = fromDate.toISOString().split('T')[0];
    dateTo.value = toDate.toISOString().split('T')[0];
    
    this.loadOrders(1);
  }

  resetFilters() {
    document.getElementById('searchQuery').value = '';
    document.getElementById('filterForm').reset();
    this.setDefaultDates();
    this.loadOrders(1);
    this.showAlert('Filters have been reset', 'info');
  }

  toggleFilters() {
    const filtersContent = document.getElementById('filtersContent');
    const toggleBtn = document.getElementById('toggleFilters');
    
    if (filtersContent.style.display === 'none') {
      filtersContent.style.display = 'block';
      toggleBtn.innerHTML = '<i class="bi bi-chevron-up me-2"></i> Hide Filters';
    } else {
      filtersContent.style.display = 'none';
      toggleBtn.innerHTML = '<i class="bi bi-chevron-down me-2"></i> Show Filters';
    }
  }

  showLoading() {
    document.getElementById('ordersTableBody').innerHTML = `
      <tr>
        <td colspan="8" class="text-center py-4">
          <div class="spinner-border spinner-border-sm me-2" role="status"></div>
          Loading orders...
        </td>
      </tr>
    `;
  }

  showError(message) {
    document.getElementById('ordersTableBody').innerHTML = `
      <tr>
        <td colspan="8" class="text-center py-4 text-muted">
          <i class="bi bi-exclamation-circle me-2"></i>
          ${message}
        </td>
      </tr>
    `;
  }

  showAlert(message, type) {
    const alertContainer = document.getElementById('alertContainer');
    const alertId = 'alert-' + Date.now();
    
    const alert = document.createElement('div');
    alert.className = `alert alert-${type} alert-dismissible fade show`;
    alert.innerHTML = `
      <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : type === 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill'} me-2"></i>
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    alertContainer.appendChild(alert);
    
    // Auto remove after 5 seconds
    setTimeout(() => {
      if (alert.parentNode) {
        alert.remove();
      }
    }, 5000);
  }

  escapeHtml(unsafe) {
    if (!unsafe) return '';
    return unsafe
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
}

// Initialize sales orders manager when DOM is loaded
let salesOrdersManager;
document.addEventListener('DOMContentLoaded', function() {
  salesOrdersManager = new SalesOrdersManager();
  
  // Auto-hide existing alerts after 5 seconds
  const alerts = document.querySelectorAll('.alert');
  alerts.forEach(alert => {
    setTimeout(() => {
      if (alert.parentNode) {
        const bsAlert = new bootstrap.Alert(alert);
        bsAlert.close();
      }
    }, 5000);
  });
});
</script>

