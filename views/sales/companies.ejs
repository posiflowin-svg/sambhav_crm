<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
  let currentPage = 1;
  let currentSearch = '';
  let debounceTimer;
  
  // Filter variables
  let currentDateFilter = '';
  let customDateFrom = '';
  let customDateTo = '';
  let selectedStatuses = [];
  
  // Initialize date pickers
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize flatpickr for date range
    flatpickr("#dateFrom", {
      dateFormat: "Y-m-d",
      onChange: function(selectedDates, dateStr, instance) {
        document.getElementById('dateTo')._flatpickr.set('minDate', dateStr);
      }
    });
    
    flatpickr("#dateTo", {
      dateFormat: "Y-m-d"
    });
    
    // Load initial data
    loadCompanies();
    loadStats();
  });

  // Load companies with filters
  async function loadCompanies(page = 1) {
    // Show loading skeleton
    const container = document.getElementById('companiesContainer');
    container.innerHTML = Array(5).fill().map(() => `
      <div class="company-card skeleton" style="height: 120px;"></div>
    `).join('');

    currentPage = page;
    
    const params = new URLSearchParams({
      page,
      limit: 20
    });
    
    // Add search
    if (currentSearch) {
      params.append('search', currentSearch);
    }
    
    // Add date filter
    if (currentDateFilter) {
      params.append('dateFilter', currentDateFilter);
    }
    
    // Add custom date range
    if (customDateFrom && customDateTo) {
      params.append('dateFrom', customDateFrom);
      params.append('dateTo', customDateTo);
    }
    
    // Add status filters
    if (selectedStatuses.length > 0) {
      params.append('statuses', selectedStatuses.join(','));
    }

    try {
      const response = await fetch(`/api/companies?${params}`);
      const data = await response.json();
      
      if (data.success) {
        updateCompaniesList(data.data);
        updatePagination(data.pagination);
        updateActiveFiltersDisplay();
      }
    } catch (error) {
      console.error('Error loading companies:', error);
      showNotification('Error loading companies', 'error');
    }
  }

  // Update companies list
  function updateCompaniesList(companies) {
      const container = document.getElementById('companiesContainer');
      
      if (companies.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="bi bi-building"></i>
            <h3>No companies found</h3>
            <p>Get started by adding your first company</p>
            <button onclick="openCompanyModal()" class="empty-state-btn">
              <i class="bi bi-plus-lg"></i>
              Add New Company
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = companies.map(company => {
        // Format date safely
        const addedDate = company.createdAt ? new Date(company.createdAt).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }) : 'N/A';
        
        return `
        <div class="company-card" onclick="viewCompany('${company._id}')">
          <div class="company-header">
            <div class="company-title">
              <h3 class="company-name">${escapeHtml(company.companyName)}</h3>
              <span class="status-badge status-${company.status}">${company.status.replace('-', ' ')}</span>
            </div>
            <div class="company-actions">
              <!-- View Button -->
              <a href="/sales/companies/${company._id}" class="action-btn view" title="View Company Details">
                <i class="bi bi-eye"></i>
              </a>
              <button onclick="event.stopPropagation(); editCompany('${company._id}')" 
                      class="action-btn edit" title="Edit">
                <i class="bi bi-pencil"></i>
              </button>

              <button onclick="event.stopPropagation(); deleteCompany('${company._id}')" 
                      class="action-btn delete" title="Delete">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </div>
          
          <div class="company-details">
            <div class="detail-item">
              <i class="bi bi-telephone"></i>
              <span>${escapeHtml(company.phoneNumber)}</span>
            </div>
            ${company.location ? `
              <div class="detail-item">
                <i class="bi bi-geo-alt"></i>
                <span>${escapeHtml(company.location)}</span>
              </div>
            ` : ''}
            <div class="detail-item">
              <i class="bi bi-calendar"></i>
              <span>Added: ${addedDate}</span>
            </div>
          </div>
          
          ${company.notes ? `
            <div class="company-notes">
              <i class="bi bi-chat"></i>
              <span>${escapeHtml(company.notes)}</span>
            </div>
          ` : ''}
          
          <!-- Quick Stats for Inquiries (Optional) -->
          <div class="company-footer">
            <div class="inquiry-stats">
              <span class="stat-item" title="Total Inquiries">
                <i class="bi bi-chat"></i>
                <span>${company.inquiryCount || 0} inquiries</span>
              </span>
            </div>
          </div>
        </div>
      `}).join('');
  }

  function viewCompany(id) {
    window.location.href = `/sales/companies/${id}`;
  }
  // Date Filter Functions
  function setDateFilter(filter) {
    // Remove active class from all date buttons
    document.querySelectorAll('.date-filter-btn').forEach(btn => {
      btn.classList.remove('active');
    });
    
    // Add active class to clicked button
    const btnId = `date${filter.charAt(0).toUpperCase() + filter.slice(1)}`;
    const btn = document.getElementById(btnId);
    if (btn) btn.classList.add('active');
    
    // Hide custom date range
    document.getElementById('customDateRange').style.display = 'none';
    
    // Set current date filter
    currentDateFilter = filter;
    customDateFrom = '';
    customDateTo = '';
    
    // Apply filters
    applyFilters();
  }

  function toggleCustomDateRange() {
    const customRange = document.getElementById('customDateRange');
    customRange.style.display = customRange.style.display === 'none' ? 'grid' : 'none';
    
    // Remove active class from other date buttons
    document.querySelectorAll('.date-filter-btn').forEach(btn => {
      btn.classList.remove('active');
    });
    
    // Add active class to custom button
    document.getElementById('customDateBtn').classList.add('active');
    
    // Clear current date filter
    currentDateFilter = '';
  }

  function applyCustomDateRange() {
    const fromDate = document.getElementById('dateFrom').value;
    const toDate = document.getElementById('dateTo').value;
    
    if (!fromDate || !toDate) {
      showNotification('Please select both from and to dates', 'error');
      return;
    }
    
    customDateFrom = fromDate;
    customDateTo = toDate;
    currentDateFilter = '';
    
    document.getElementById('customDateRange').style.display = 'none';
    applyFilters();
  }

  function cancelCustomDateRange() {
    document.getElementById('customDateRange').style.display = 'none';
    document.getElementById('dateFrom').value = '';
    document.getElementById('dateTo').value = '';
    
    // Remove active class from custom button
    document.getElementById('customDateBtn').classList.remove('active');
    
    // Clear custom dates
    customDateFrom = '';
    customDateTo = '';
    
    // If no other date filter is active, clear date filter
    if (!currentDateFilter) {
      currentDateFilter = '';
    }
  }

  // Status Filter Functions
  function toggleStatusFilter(status, element) {
    const checkbox = document.getElementById(`status${status.charAt(0).toUpperCase() + status.slice(1).replace('-', '')}`);
    checkbox.checked = !checkbox.checked;
    
    // Update selected statuses
    updateSelectedStatuses();
    
    // Update checkbox style
    if (checkbox.checked) {
      element.classList.add(`active-${status}`);
    } else {
      element.classList.remove(`active-${status}`);
    }
  }

  function updateSelectedStatuses() {
    selectedStatuses = [];
    
    if (document.getElementById('statusNew')?.checked) selectedStatuses.push('new');
    if (document.getElementById('statusContacted')?.checked) selectedStatuses.push('contacted');
    if (document.getElementById('statusInterested')?.checked) selectedStatuses.push('interested');
    if (document.getElementById('statusNotInterested')?.checked) selectedStatuses.push('not-interested');
    if (document.getElementById('statusFollowUp')?.checked) selectedStatuses.push('follow-up');
  }

  function filterByStatus(status) {
    // Clear all status checkboxes
    document.querySelectorAll('.status-filter').forEach(cb => {
      cb.checked = false;
    });
    document.querySelectorAll('.status-checkbox').forEach(el => {
      el.classList.remove('active-new', 'active-contacted', 'active-interested', 'active-not-interested', 'active-follow-up');
    });
    
    if (status !== 'all') {
      // Check the specific status
      const statusId = `status${status.charAt(0).toUpperCase() + status.slice(1).replace('-', '')}`;
      const checkbox = document.getElementById(statusId);
      if (checkbox) {
        checkbox.checked = true;
        const parent = checkbox.closest('.status-checkbox');
        parent.classList.add(`active-${status}`);
      }
    }
    
    updateSelectedStatuses();
    applyFilters();
  }

  // Apply all filters
  function applyFilters() {
    loadCompanies(1);
  }

  // Clear all filters
  function clearAllFilters() {
    // Clear search
    document.getElementById('searchInput').value = '';
    currentSearch = '';
    
    // Clear date filters
    document.querySelectorAll('.date-filter-btn').forEach(btn => {
      btn.classList.remove('active');
    });
    document.getElementById('customDateRange').style.display = 'none';
    document.getElementById('dateFrom').value = '';
    document.getElementById('dateTo').value = '';
    currentDateFilter = '';
    customDateFrom = '';
    customDateTo = '';
    
    // Clear status filters
    document.querySelectorAll('.status-filter').forEach(cb => {
      cb.checked = false;
    });
    document.querySelectorAll('.status-checkbox').forEach(el => {
      el.classList.remove('active-new', 'active-contacted', 'active-interested', 'active-not-interested', 'active-follow-up');
    });
    selectedStatuses = [];
    
    // Apply changes
    applyFilters();
    
    showNotification('All filters cleared', 'success');
  }

  // Update active filters display
  function updateActiveFiltersDisplay() {
    const container = document.getElementById('activeFiltersContainer');
    let filters = [];
    
    // Add date filter
    if (currentDateFilter) {
      let filterText = '';
      switch(currentDateFilter) {
        case 'today': filterText = 'Today'; break;
        case 'yesterday': filterText = 'Yesterday'; break;
        case 'thisWeek': filterText = 'This Week'; break;
        case 'thisMonth': filterText = 'This Month'; break;
        case 'thisYear': filterText = 'This Year'; break;
      }
      filters.push(`<span class="filter-tag"><i class="bi bi-calendar"></i> ${filterText}</span>`);
    }
    
    // Add custom date range
    if (customDateFrom && customDateTo) {
      filters.push(`<span class="filter-tag"><i class="bi bi-calendar-range"></i> ${customDateFrom} to ${customDateTo}</span>`);
    }
    
    // Add status filters
    selectedStatuses.forEach(status => {
      filters.push(`<span class="filter-tag"><i class="bi bi-tag"></i> ${status.replace('-', ' ')}</span>`);
    });
    
    if (filters.length > 0) {
      container.innerHTML = filters.join(' ');
    } else {
      container.innerHTML = '<span class="filter-tag" style="background: transparent; border: none;">No active filters</span>';
    }
  }

  // Helper function to escape HTML
  function escapeHtml(unsafe) {
    if (!unsafe) return '';
    return unsafe
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // Update pagination
  function updatePagination(pagination) {
    const container = document.getElementById('pagination');
    
    if (!pagination || pagination.pages <= 1) {
      container.innerHTML = '';
      return;
    }

    const start = ((pagination.page - 1) * pagination.limit) + 1;
    const end = Math.min(pagination.page * pagination.limit, pagination.total);

    let html = `
      <div class="pagination-info">
        Showing ${start} to ${end} of ${pagination.total} companies
      </div>
      <div class="pagination-controls">
    `;

    // Previous button
    html += `<button onclick="loadCompanies(${pagination.page - 1})" class="page-btn" ${pagination.page <= 1 ? 'disabled' : ''}>
      <i class="bi bi-chevron-left"></i>
    </button>`;

    // Page numbers
    for (let i = 1; i <= pagination.pages; i++) {
      if (i === pagination.page) {
        html += `<button class="page-btn active">${i}</button>`;
      } else if (i === 1 || i === pagination.pages || (i >= pagination.page - 2 && i <= pagination.page + 2)) {
        html += `<button onclick="loadCompanies(${i})" class="page-btn">${i}</button>`;
      } else if (i === pagination.page - 3 || i === pagination.page + 3) {
        html += `<span class="page-btn" style="border: none; background: transparent;">...</span>`;
      }
    }

    // Next button
    html += `<button onclick="loadCompanies(${pagination.page + 1})" class="page-btn" ${pagination.page >= pagination.pages ? 'disabled' : ''}>
      <i class="bi bi-chevron-right"></i>
    </button>`;

    html += '</div>';
    container.innerHTML = html;
  }

  // Load stats
  async function loadStats() {
    try {
      const response = await fetch('/api/companies/stats');
      const data = await response.json();
      
      if (data.success && data.data) {
        document.getElementById('totalCompanies').textContent = data.data.totalCompanies || 0;
        document.getElementById('newCompanies').textContent = data.data.newCompanies || 0;
        document.getElementById('contactedCompanies').textContent = data.data.contacted || 0;
        document.getElementById('interestedCompanies').textContent = data.data.interested || 0;
        document.getElementById('notInterestedCompanies').textContent = data.data.notInterested || 0;
        document.getElementById('followUpCompanies').textContent = data.data.followUp || 0;
      }
    } catch (error) {
      console.error('Error loading stats:', error);
    }
  }

  // Check for duplicates
  async function checkDuplicate() {
    const companyName = document.getElementById('companyName').value.trim();
    const phoneNumber = document.getElementById('phoneNumber').value.trim();
    const companyId = document.getElementById('companyId').value;
    
    if (!companyName && !phoneNumber) return true;

    document.getElementById('companyNameError').classList.add('hidden');
    document.getElementById('phoneError').classList.add('hidden');

    try {
      const params = new URLSearchParams();
      if (companyName) params.append('name', companyName);
      if (phoneNumber) params.append('phone', phoneNumber);
      
      const response = await fetch(`/api/companies/check?${params}`);
      const data = await response.json();
      
      if (data.success && data.exists && data.company._id !== companyId) {
        if (companyName && data.company.companyName.toLowerCase() === companyName.toLowerCase()) {
          document.getElementById('companyNameError').textContent = 'Company name already exists';
          document.getElementById('companyNameError').classList.remove('hidden');
        }
        if (phoneNumber && data.company.phoneNumber === phoneNumber) {
          document.getElementById('phoneError').textContent = 'Phone number already exists';
          document.getElementById('phoneError').classList.remove('hidden');
        }
        return false;
      }
      return true;
    } catch (error) {
      console.error('Error checking duplicate:', error);
      return true;
    }
  }

  // Open modal for new company
  function openCompanyModal() {
    document.getElementById('modalTitle').textContent = 'Add New Company';
    document.getElementById('companyForm').reset();
    document.getElementById('companyId').value = '';
    document.getElementById('statusField').style.display = 'none';
    document.getElementById('notesField').style.display = 'none';
    document.getElementById('companyNameError').classList.add('hidden');
    document.getElementById('phoneError').classList.add('hidden');
    document.getElementById('companyModal').style.display = 'flex';
  }

  // Open modal for edit
  async function editCompany(id) {
    try {
      const response = await fetch(`/api/companies/${id}`);
      const data = await response.json();
      
      if (data.success) {
        document.getElementById('modalTitle').textContent = 'Edit Company';
        document.getElementById('companyId').value = data.data._id;
        document.getElementById('companyName').value = data.data.companyName || '';
        document.getElementById('phoneNumber').value = data.data.phoneNumber || '';
        document.getElementById('location').value = data.data.location || '';
        document.getElementById('status').value = data.data.status || 'new';
        document.getElementById('notes').value = data.data.notes || '';
        document.getElementById('statusField').style.display = 'block';
        document.getElementById('notesField').style.display = 'block';
        document.getElementById('companyNameError').classList.add('hidden');
        document.getElementById('phoneError').classList.add('hidden');
        document.getElementById('companyModal').style.display = 'flex';
      }
    } catch (error) {
      console.error('Error loading company:', error);
      showNotification('Error loading company details', 'error');
    }
  }

  // Close modal
  function closeCompanyModal() {
    document.getElementById('companyModal').style.display = 'none';
  }

  // Save company
  async function saveCompany(event) {
    event.preventDefault();
    
    const isUnique = await checkDuplicate();
    if (!isUnique) {
      showNotification('Please fix the duplicate entries', 'error');
      return;
    }

    const companyId = document.getElementById('companyId').value;
    const formData = {
      companyName: document.getElementById('companyName').value.trim(),
      phoneNumber: document.getElementById('phoneNumber').value.trim(),
      location: document.getElementById('location').value.trim()
    };

    if (companyId) {
      formData.status = document.getElementById('status').value;
      formData.notes = document.getElementById('notes').value.trim();
    }

    const url = companyId ? `/api/companies/${companyId}` : '/api/companies';
    const method = companyId ? 'PUT' : 'POST';

    try {
      const response = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
      });

      const data = await response.json();
      
      if (data.success) {
        closeCompanyModal();
        await loadCompanies(currentPage);
        await loadStats();
        showNotification(companyId ? 'Company updated successfully' : 'Company added successfully', 'success');
      } else {
        showNotification(data.message || 'Error saving company', 'error');
      }
    } catch (error) {
      console.error('Error saving company:', error);
      showNotification('Error saving company', 'error');
    }
  }

  // Delete company
  async function deleteCompany(id) {
    if (!confirm('Are you sure you want to delete this company?')) return;

    try {
      const response = await fetch(`/api/companies/${id}`, {
        method: 'DELETE'
      });

      const data = await response.json();
      
      if (data.success) {
        await loadCompanies(currentPage);
        await loadStats();
        showNotification('Company deleted successfully', 'success');
      } else {
        showNotification(data.message || 'Error deleting company', 'error');
      }
    } catch (error) {
      console.error('Error deleting company:', error);
      showNotification('Error deleting company', 'error');
    }
  }

  // Show notification
  function showNotification(message, type = 'success') {
    const notification = document.createElement('div');
    notification.className = `notification ${type}`;
    notification.innerHTML = `
      <i class="bi ${type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle'}"></i>
      <span>${message}</span>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
      notification.style.animation = 'slideIn 0.3s ease reverse';
      setTimeout(() => {
        notification.remove();
      }, 300);
    }, 3000);
  }

  // Search with debounce
  document.getElementById('searchInput').addEventListener('input', function(e) {
    clearTimeout(debounceTimer);
    currentSearch = e.target.value;
    
    debounceTimer = setTimeout(() => {
      loadCompanies(1);
    }, 500);
  });

  // Close modal when clicking outside
  window.onclick = function(event) {
    const modal = document.getElementById('companyModal');
    if (event.target === modal) {
      closeCompanyModal();
    }
  };

  // Add hidden class style
  const style = document.createElement('style');
  style.textContent = `
    .hidden {
      display: none !important;
    }
  `;
  document.head.appendChild(style);
</script>