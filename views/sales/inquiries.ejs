<%- include('../partials/header') %>
<style>
.si-wrap{max-width:1480px;margin:24px auto;padding:0 22px;font-family:inherit;color:#172b4d}.si-nav{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:20px}.si-nav a{padding:10px 15px;border-radius:9px;text-decoration:none;color:#475569;background:#fff;border:1px solid #e2e8f0;font-weight:600}.si-nav .on{background:#4f46e5;color:white}.si-card{background:white;border:1px solid #e7edf5;border-radius:17px;padding:24px;box-shadow:0 5px 22px #13223a0c}.si-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}.si-head h2{margin:0;font-size:25px;font-weight:750}.si-muted{color:#64748b;font-size:13px}.si-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:20px 0}.si-stat{padding:16px 19px;border:1px solid #e2e8f0;border-radius:12px;background:#fbfdff;font-size:13px;color:#64748b}.si-stat strong{display:block;font-size:28px;color:#142b4a;margin-bottom:3px}.si-tools{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0 17px}.si-input,.si-filter{padding:11px 12px;border:1px solid #cbd5e1;border-radius:9px;background:white;color:#334155;font-size:14px}.si-input{flex:1;min-width:210px}.si-tablewrap{overflow-x:auto;border:1px solid #e2e8f0;border-radius:12px}.si-table{width:100%;min-width:900px;border-collapse:collapse;table-layout:fixed}.si-table th,.si-table td{text-align:left;padding:14px 13px;border-bottom:1px solid #e8edf4;vertical-align:middle;overflow-wrap:anywhere;font-size:14px}.si-table th{background:#f3f6fa;color:#475569;font-size:12px;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap}.si-table tbody tr:last-child td{border-bottom:0}.si-table tbody tr:hover{background:#f8fafc}.si-table tbody tr.si-ready{background:#f0fdf4}.si-table tbody tr.si-ready:hover{background:#e8f9ed}.si-table th:nth-child(1){width:19%}.si-table th:nth-child(2){width:25%}.si-table th:nth-child(3){width:16%}.si-table th:nth-child(4){width:16%}.si-table th:nth-child(5){width:14%}.si-table th:nth-child(6){width:10%}.si-badge{display:inline-flex;align-items:center;max-width:100%;white-space:nowrap;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700;background:#e9eef5;color:#475569}.si-badge.ready{background:#d1fae5;color:#047857}.si-badge.cancelled{background:#fee2e2;color:#b91c1c}.si-btn{background:#2563eb;color:white;border:0;border-radius:8px;padding:8px 12px;cursor:pointer;font-size:13px;font-weight:650;white-space:nowrap}.si-btn:hover{background:#1d4ed8}.si-price{font-weight:700;color:#0f766e}.si-warning{color:#a16207;font-size:12px;margin-top:4px}.si-overlay{position:fixed;inset:0;background:#0f172a99;display:none;align-items:center;justify-content:center;z-index:9999;padding:15px}.si-modal{background:white;border-radius:15px;width:min(680px,100%);max-height:85vh;overflow:auto;padding:24px;box-shadow:0 15px 60px #0002}.si-close{float:right;border:0;background:#e2e8f0;padding:7px 12px;border-radius:8px;cursor:pointer}.si-products{padding:14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px;margin:9px 0}.si-empty{text-align:center;padding:28px!important;color:#64748b}@media(max-width:680px){.si-wrap{padding:0 10px}.si-card{padding:14px}.si-stats{gap:7px}.si-stat{padding:11px}.si-stat strong{font-size:22px}.si-head h2{font-size:21px}}
</style>
<div class="si-wrap"><nav class="si-nav"><a href="/sales/orders">Orders</a><a href="/sales/orders/create">Create Order</a><a href="/sales/customers">Customers</a><a class="on" href="/sales/inquiries">My Inquiries</a><a href="/sales/companies">Companies</a></nav><section class="si-card"><div class="si-head"><div><h2>My Inquiries</h2><p class="si-muted">Track your customer inquiries and quotations. Price Ready rows are highlighted in light green.</p></div><button type="button" class="si-btn" id="siRefresh">↻ Refresh</button></div><div class="si-stats"><div class="si-stat"><strong id="siTotal">—</strong>Total inquiries</div><div class="si-stat"><strong id="siReady">—</strong>Price ready</div><div class="si-stat"><strong id="siPending">—</strong>Awaiting price</div></div><div class="si-tools"><input id="siSearch" class="si-input" placeholder="Search customer or product…" aria-label="Search inquiries"><select class="si-filter" id="siFilter" aria-label="Filter by status"><option value="all">All statuses</option><option value="new">New</option><option value="pending">Pending price</option><option value="pricing-ready">Price Ready</option><option value="sales-processing">Sales Processing</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select></div><div class="si-tablewrap"><table class="si-table"><thead><tr><th>Customer</th><th>Products</th><th>Price</th><th>Status</th><th>Updated</th><th>Action</th></tr></thead><tbody id="siRows"><tr><td class="si-empty" colspan="6">Loading inquiries…</td></tr></tbody></table></div><p class="si-muted" id="siCount" aria-live="polite"></p></section></div>
<div id="siOverlay" class="si-overlay" role="dialog" aria-modal="true" aria-label="Inquiry details"><div class="si-modal"><button class="si-close" id="siClose" type="button">Close ✕</button><div id="siDetails"></div></div></div>
<script>
let siItems=[];
const siEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const siMoney=n=>n===null||n===undefined||n===''||!Number.isFinite(Number(n))?'Not set':'₹'+Number(n).toLocaleString('en-IN',{maximumFractionDigits:2});
const siReady=x=>x.overallStatus==='pricing-ready';
const siPrice=p=>p.finalSellingPrice;
const siName=x=>x.companyId?.companyName||x.companyId?.name||'Unknown';
const siStatus=s=>({'pricing-ready':'Price Ready','china-processing':'Pending Price','sales-processing':'Sales Processing','new':'New','completed':'Completed','cancelled':'Cancelled'}[s]||String(s||'Unknown').replace(/-/g,' '));
const siDate=d=>d&&!isNaN(new Date(d))?new Date(d).toLocaleString('en-IN',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}):'—';
function siRender(){let list=siItems;const f=document.getElementById('siFilter').value;const q=document.getElementById('siSearch').value.trim().toLowerCase();if(f==='pending')list=list.filter(x=>['new','china-processing'].includes(x.overallStatus));else if(f!=='all')list=list.filter(x=>x.overallStatus===f);if(q)list=list.filter(x=>(siName(x)+' '+(x.products||[]).map(p=>p.productName).join(' ')).toLowerCase().includes(q));document.getElementById('siCount').textContent=`Showing ${list.length} of ${siItems.length} inquiries`;document.getElementById('siRows').innerHTML=list.map(x=>{const products=x.products||[];const prices=products.map(siPrice);const missing=siReady(x)&&prices.some(p=>p===null||p===undefined||p==='');const priceText=prices.length?prices.map(siMoney).join(' / '):'Not set';return `<tr class="${siReady(x)?'si-ready':''}"><td><strong>${siEsc(siName(x))}</strong></td><td>${products.map(p=>siEsc(p.productName||'Unnamed product')).join(', ')||'—'}</td><td><span class="${missing?'':'si-price'}">${siEsc(priceText)}</span>${missing?'<div class="si-warning">Price not entered in inquiry</div>':''}</td><td><span class="si-badge ${siReady(x)?'ready':x.overallStatus==='cancelled'?'cancelled':''}">${siEsc(siStatus(x.overallStatus))}</span></td><td>${siEsc(siDate(x.updatedAt))}</td><td><button class="si-btn" type="button" data-inquiry-id="${siEsc(x._id)}">View</button></td></tr>`}).join('')||'<tr><td class="si-empty" colspan="6">No matching inquiries found</td></tr>'}
async function siOpen(id){try{const r=await fetch('/sales/inquiries/'+encodeURIComponent(id)+'/detail',{credentials:'same-origin'});if(!r.ok)throw Error('Unable to open inquiry');const j=await r.json();const x=j.data;if(!x)throw Error('Inquiry details unavailable');document.getElementById('siDetails').innerHTML=`<h2 style="margin-top:0">Inquiry Details</h2><p><b>Customer:</b> ${siEsc(siName(x))}</p><p><b>Status:</b> ${siEsc(siStatus(x.overallStatus))}</p><p><b>Price ready:</b> ${siEsc(x.priceReadyAt?siDate(x.priceReadyAt):'Not yet recorded')}</p><h3>Products and Prices</h3>${(x.products||[]).map(p=>`<div class="si-products"><b>${siEsc(p.productName)}</b><div>Quantity: ${siEsc(p.quantity)}</div><div>Target: ${siEsc(siMoney(p.targetPrice))}</div><div>China Price: ${siEsc(siMoney(p.chinaPrice))}</div><div><b>Final Selling Price: ${siEsc(siMoney(p.finalSellingPrice))}</b></div><div>Status: ${siEsc(siStatus(p.status))}</div></div>`).join('')||'<p>No products</p>'}<h3>Notes</h3>${(x.notes||[]).map(n=>`<p>${siEsc(n.message)} <small class="si-muted">— ${siEsc(n.addedBy?.name||n.role||'')}</small></p>`).join('')||'No notes'}<p><a href="/sales/companies/${encodeURIComponent(x.companyId?._id||x.companyId||'')}">Open Customer Company</a></p>`;document.getElementById('siOverlay').style.display='flex'}catch(e){alert(e.message)}}
async function siLoad(){try{const r=await fetch('/sales/inquiries/data',{credentials:'same-origin',cache:'no-store'});if(!r.ok)throw Error('Unable to load');const j=await r.json();siItems=j.data||[];document.getElementById('siTotal').textContent=siItems.length;document.getElementById('siReady').textContent=siItems.filter(siReady).length;document.getElementById('siPending').textContent=siItems.filter(x=>['new','china-processing'].includes(x.overallStatus)).length;siRender()}catch(e){document.getElementById('siRows').innerHTML='<tr><td class="si-empty" colspan="6">Unable to load inquiries. Please refresh.</td></tr>'}}
document.getElementById('siFilter').addEventListener('change',siRender);document.getElementById('siSearch').addEventListener('input',siRender);document.getElementById('siRefresh').addEventListener('click',siLoad);document.getElementById('siRows').addEventListener('click',e=>{const b=e.target.closest('[data-inquiry-id]');if(b)siOpen(b.dataset.inquiryId)});document.getElementById('siClose').addEventListener('click',()=>document.getElementById('siOverlay').style.display='none');document.getElementById('siOverlay').addEventListener('click',e=>{if(e.target.id==='siOverlay')e.target.style.display='none'});document.addEventListener('keydown',e=>{if(e.key==='Escape')document.getElementById('siOverlay').style.display='none'});siLoad();setInterval(siLoad,30000);
</script>
<%- include('../partials/footer') %>
