<%- include('../partials/header') %>
<style>
.si-wrap{max-width:1450px;margin:28px auto;padding:0 22px;font-family:Arial,sans-serif;color:#15243c}.si-nav{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}.si-nav a{padding:12px 17px;border-radius:9px;text-decoration:none;color:#334155;background:#fff;border:1px solid #e2e8f0}.si-nav .on{background:#4f46e5;color:#fff}.si-card{background:#fff;border-radius:18px;padding:25px;box-shadow:0 5px 25px #13223a12}.si-stats{display:flex;gap:15px;flex-wrap:wrap;margin:20px 0}.si-stat{padding:18px 24px;border:1px solid #e2e8f0;border-radius:12px;min-width:170px}.si-stat strong{display:block;font-size:28px}.si-table{width:100%;border-collapse:collapse}.si-table th,.si-table td{text-align:left;padding:15px;border-bottom:1px solid #e2e8f0}.si-table th{background:#f1f5f9}.si-ready{background:#dcfce7!important}.si-ready:hover{background:#bbf7d0!important}.si-badge{padding:6px 10px;border-radius:20px;background:#e2e8f0}.si-ready .si-badge{background:#16a34a;color:white}.si-btn{background:#2563eb;color:white;border:0;border-radius:8px;padding:9px 14px;cursor:pointer}.si-overlay{position:fixed;inset:0;background:#0f172a88;display:none;align-items:center;justify-content:center;z-index:9999}.si-modal{background:#fff;border-radius:15px;width:min(660px,94vw);max-height:85vh;overflow:auto;padding:25px}.si-close{float:right;border:0;background:#e2e8f0;padding:7px 12px;border-radius:8px;cursor:pointer}.si-products{padding:12px;background:#f8fafc;border-radius:9px;margin:9px 0}.si-muted{color:#64748b}.si-filter{padding:10px;border:1px solid #cbd5e1;border-radius:8px;margin:10px 0 15px}
</style>
<div class="si-wrap"><nav class="si-nav"><a href="/sales/orders">Orders</a><a href="/sales/orders/create">Create Order</a><a href="/sales/customers">Customers</a><a href="/sales/companies">Companies</a><a class="on" href="/sales/inquiries">My Inquiries</a></nav><div class="si-card"><h2>My Inquiries</h2><p class="si-muted">Only inquiries assigned to your Sales account are shown. Green rows indicate prices are ready.</p><div class="si-stats"><div class="si-stat"><strong id="siTotal">—</strong>Total inquiries</div><div class="si-stat"><strong id="siReady">—</strong>Price ready</div><div class="si-stat"><strong id="siPending">—</strong>Awaiting price</div></div><select class="si-filter" id="siFilter"><option value="all">All statuses</option><option value="pricing-ready">Price Ready</option><option value="other">Other statuses</option></select><div style="overflow-x:auto"><table class="si-table"><thead><tr><th>Customer</th><th>Products</th><th>Price</th><th>Status</th><th>Updated</th><th>Action</th></tr></thead><tbody id="siRows"><tr><td colspan="6">Loading inquiries...</td></tr></tbody></table></div></div></div>
<div id="siOverlay" class="si-overlay"><div class="si-modal"><button class="si-close" onclick="document.getElementById('siOverlay').style.display='none'">Close</button><div id="siDetails"></div></div></div>
<script>
let siItems=[];
const siEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const siMoney=n=>n==null||n===''?'Not set':'₹'+Number(n).toLocaleString('en-IN');
function siRender(){let list=siItems;const f=document.getElementById('siFilter').value;if(f==='pricing-ready')list=list.filter(x=>x.overallStatus==='pricing-ready');if(f==='other')list=list.filter(x=>x.overallStatus!=='pricing-ready');document.getElementById('siRows').innerHTML=list.map(x=>`<tr class="${x.overallStatus==='pricing-ready'?'si-ready':''}"><td>${siEsc(x.companyId?.companyName||x.companyId?.name||'Unknown')}</td><td>${(x.products||[]).map(p=>siEsc(p.productName)).join(', ')}</td><td>${(x.products||[]).map(p=>siMoney(p.finalSellingPrice)).join(' / ')}</td><td><span class="si-badge">${siEsc(x.overallStatus)}</span></td><td>${new Date(x.updatedAt).toLocaleString('en-IN')}</td><td><button class="si-btn" onclick="siOpen('${x._id}')">View Details</button></td></tr>`).join('')||'<tr><td colspan="6">No inquiries found</td></tr>';}
async function siOpen(id){try{const r=await fetch('/sales/inquiries/'+encodeURIComponent(id)+'/detail',{credentials:'same-origin'});if(!r.ok)throw Error('Unable to open inquiry');const j=await r.json();const x=j.data;document.getElementById('siDetails').innerHTML=`<h2>Inquiry Details</h2><p><b>Customer:</b> ${siEsc(x.companyId?.companyName||x.companyId?.name||'Unknown')}</p><p><b>Status:</b> ${siEsc(x.overallStatus)}</p><p><b>Price ready:</b> ${x.priceReadyAt?new Date(x.priceReadyAt).toLocaleString('en-IN'):'Not yet'}</p><h3>Products and Prices</h3>${(x.products||[]).map(p=>`<div class="si-products"><b>${siEsc(p.productName)}</b><div>Quantity: ${siEsc(p.quantity)}</div><div>Target: ${siMoney(p.targetPrice)}</div><div>China Price: ${siMoney(p.chinaPrice)}</div><div><b>Final Selling Price: ${siMoney(p.finalSellingPrice)}</b></div><div>Status: ${siEsc(p.status)}</div></div>`).join('')}<h3>Notes</h3>${(x.notes||[]).map(n=>`<p>${siEsc(n.message)} <small class="si-muted">— ${siEsc(n.addedBy?.name||n.role||'')}</small></p>`).join('')||'No notes'}<p><a href="/sales/companies/${encodeURIComponent(x.companyId?._id||x.companyId)}">Open Customer Company</a></p>`;document.getElementById('siOverlay').style.display='flex';}catch(e){alert(e.message)}}
async function siLoad(){try{const r=await fetch('/sales/inquiries/data',{credentials:'same-origin',cache:'no-store'});if(!r.ok)throw Error('Unable to load');const j=await r.json();siItems=j.data||[];document.getElementById('siTotal').textContent=siItems.length;document.getElementById('siReady').textContent=siItems.filter(x=>x.overallStatus==='pricing-ready').length;document.getElementById('siPending').textContent=siItems.filter(x=>!['pricing-ready','completed','cancelled'].includes(x.overallStatus)).length;siRender()}catch(e){document.getElementById('siRows').innerHTML='<tr><td colspan="6">Unable to load inquiries. Please refresh.</td></tr>'}}
document.getElementById('siFilter').addEventListener('change',siRender);siLoad();setInterval(siLoad,30000);
</script>
<%- include('../partials/footer') %>
