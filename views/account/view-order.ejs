<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Account Team</title>
    
    <!-- Tailwind CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Custom styles */
        .badge {
            @apply px-3 py-1.5 text-xs font-medium rounded-full inline-flex items-center;
        }
        
        .info-card {
            @apply bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all duration-300;
        }
        
        .info-header {
            @apply bg-gradient-to-r from-green-50 to-emerald-50 px-6 py-4 border-b border-gray-100;
        }
        
        .info-label {
            @apply text-xs font-medium text-gray-500 uppercase tracking-wider;
        }
        
        .info-value {
            @apply text-sm font-medium text-gray-900 mt-1;
        }
        
        .timeline::before {
            content: '';
            position: absolute;
            left: 1.25rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #e5e7eb;
        }
        
        .timeline-item:last-child .timeline-content {
            margin-bottom: 0;
        }
        
        .document-card {
            @apply flex flex-col items-center p-4 border-2 border-dashed border-gray-200 rounded-xl hover:border-green-400 hover:bg-green-50 transition-all cursor-pointer;
        }
        
        .bill-punched-badge {
            @apply bg-green-100 text-green-800 border border-green-200;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans antialiased">
    <!-- Header -->
    <header class="bg-gradient-to-r from-green-600 to-green-800 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-3">
                    <i class="fas fa-file-invoice-dollar text-2xl"></i>
                    <div>
                        <h1 class="text-xl font-bold">Account Dashboard</h1>
                        <p class="text-xs text-green-100">Order Billing & Tracking</p>
                    </div>
                </div>
                
                <div class="flex items-center space-x-4">
                    <div class="text-right">
                        <div class="text-sm font-medium"><%= user.name %></div>
                        <div class="text-xs text-green-200">Account Team</div>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-bold text-lg">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                    <a href="/auth/logout" class="text-sm text-white/90 hover:text-white underline">
                        <i class="fas fa-sign-out-alt mr-1"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
            <div>
                <div class="flex items-center space-x-3">
                    <h2 class="text-2xl font-bold text-gray-900">Order #<%= order.invoiceNo %></h2>
                    <% if (order.billPunch) { %>
                        <span class="badge bg-green-100 text-green-800">
                            <i class="fas fa-check-circle mr-1"></i> Bill Punched
                        </span>
                    <% } else { %>
                        <span class="badge bg-yellow-100 text-yellow-800">
                            <i class="fas fa-clock mr-1"></i> Bill Pending
                        </span>
                    <% } %>
                </div>
                <p class="text-sm text-gray-600 mt-1">
                    <i class="far fa-calendar-alt mr-1"></i>
                    Created on <%= new Date(order.createdAt).toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    }) %>
                </p>
                <div class="flex items-center space-x-3 mt-2">
                    <span class="badge <%= 
                        order.status === 'delivered' ? 'bg-green-100 text-green-800' :
                        order.status === 'cancelled' ? 'bg-red-100 text-red-800' :
                        'bg-yellow-100 text-yellow-800'
                    %>">
                        <i class="fas <%= 
                            order.status === 'delivered' ? 'fa-check-circle' :
                            order.status === 'cancelled' ? 'fa-times-circle' :
                            'fa-truck'
                        %> mr-1"></i>
                        <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                    </span>
                    <% if (order.trackingId) { %>
                        <span class="text-sm text-gray-600">
                            <i class="fas fa-box mr-1"></i> Tracking: <strong><%= order.trackingId %></strong>
                        </span>
                    <% } %>
                </div>
            </div>
            <div class="flex space-x-2">
                <a href="/account/orders" class="bg-white hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition border border-gray-300 shadow-sm flex items-center">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Orders
                </a>
                <button onclick="window.print()" class="bg-white hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition border border-gray-300 shadow-sm flex items-center">
                    <i class="fas fa-print mr-2"></i> Print
                </button>
            </div>
        </div>

        <!-- Main Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column (2/3 width) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Customer & Order Information -->
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-user-circle text-green-600 mr-2"></i>
                            Customer & Order Information
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <div class="info-label">Customer Name</div>
                                <div class="info-value"><%= order.customer.name %></div>
                            </div>
                            <div>
                                <div class="info-label">Mobile Number</div>
                                <div class="info-value">
                                    <i class="fas fa-phone-alt mr-1 text-gray-400"></i>
                                    <%= order.customer.mobileNumber %>
                                </div>
                            </div>
                            <div>
                                <div class="info-label">Order Type</div>
                                <div class="info-value">
                                    <span class="badge <%= 
                                        order.orderType === 'cod' ? 'bg-yellow-100 text-yellow-800' :
                                        order.orderType === 'prepaid' ? 'bg-green-100 text-green-800' :
                                        'bg-gray-100 text-gray-800'
                                    %>">
                                        <%= order.orderType.toUpperCase() %>
                                    </span>
                                </div>
                            </div>
                            <div>
                                <div class="info-label">Sales Person</div>
                                <div class="info-value"><%= order.salesPerson.name %></div>
                            </div>
                            <div>
                                <div class="info-label">Order Date</div>
                                <div class="info-value"><%= new Date(order.orderDate).toLocaleDateString('en-IN') %></div>
                            </div>
                            <div>
                                <div class="info-label">Due Date</div>
                                <div class="info-value <%= new Date(order.dueDate) < new Date() ? 'text-red-600 font-semibold' : '' %>">
                                    <%= new Date(order.dueDate).toLocaleDateString('en-IN') %>
                                    <% if (new Date(order.dueDate) < new Date()) { %>
                                        <i class="fas fa-exclamation-circle ml-1 text-red-500" title="Overdue"></i>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- PO Information -->
                        <% if (order.poNumber) { %>
                        <div class="mt-4 pt-4 border-t border-gray-100">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <div class="info-label">PO Number</div>
                                    <div class="info-value"><%= order.poNumber %></div>
                                </div>
                                <% if (order.poDate) { %>
                                <div>
                                    <div class="info-label">PO Date</div>
                                    <div class="info-value"><%= new Date(order.poDate).toLocaleDateString('en-IN') %></div>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <% } %>

                        <!-- Credit Information -->
                        <% if (order.orderType === 'credit' && order.creditAmount) { %>
                        <div class="mt-4 p-3 bg-blue-50 rounded-lg">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-medium text-blue-700">Credit Amount:</span>
                                <span class="text-lg font-bold text-blue-700">₹<%= order.creditAmount.toLocaleString() %></span>
                            </div>
                        </div>
                        <% } %>

                        <!-- Addresses -->
                        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% if (order.customer.billingAddress) { %>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <div class="info-label mb-2">
                                    <i class="fas fa-home mr-1"></i> Billing Address
                                </div>
                                <p class="text-sm text-gray-700">
                                    <%= order.customer.billingAddress.street %><br>
                                    <%= order.customer.billingAddress.city %>, 
                                    <%= order.customer.billingAddress.state %> - 
                                    <%= order.customer.billingAddress.pincode %>
                                </p>
                            </div>
                            <% } %>
                            
                            <% if (order.customer.shippingAddress) { %>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <div class="info-label mb-2">
                                    <i class="fas fa-truck mr-1"></i> Shipping Address
                                </div>
                                <p class="text-sm text-gray-700">
                                    <%= order.customer.shippingAddress.street %><br>
                                    <%= order.customer.shippingAddress.city %>, 
                                    <%= order.customer.shippingAddress.state %> - 
                                    <%= order.customer.shippingAddress.pincode %>
                                </p>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Products -->
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-boxes text-green-600 mr-2"></i>
                            Products
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Qty</th>
                                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Rate (₹)</th>
                                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total (₹)</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% order.products.forEach((product) => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= product.name %></td>
                                        <td class="px-4 py-3 text-sm text-center text-gray-600"><%= product.quantity %></td>
                                        <td class="px-4 py-3 text-sm text-right text-gray-600">₹<%= product.rate.toLocaleString() %></td>
                                        <td class="px-4 py-3 text-sm text-right font-semibold text-gray-900">₹<%= product.total.toLocaleString() %></td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Amount Summary -->
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-calculator text-green-600 mr-2"></i>
                            Amount Summary
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="bg-gray-50 rounded-lg p-4 space-y-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">Subtotal:</span>
                                <span class="font-medium text-gray-900">₹<%= order.subtotal.toLocaleString() %></span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">GST (18%):</span>
                                <span class="font-medium text-gray-900">₹<%= order.gstAmount.toLocaleString() %></span>
                            </div>
                            <div class="flex justify-between text-base font-bold pt-2 border-t border-gray-200">
                                <span class="text-gray-900">Total Amount:</span>
                                <span class="text-green-600">₹<%= order.totalAmount.toLocaleString() %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column (1/3 width) -->
            <div class="space-y-6">
                <!-- Bill Punch Status Card -->
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-receipt text-green-600 mr-2"></i>
                            Bill Status
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="flex flex-col items-center text-center">
                            <% if (order.billPunch) { %>
                                <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mb-4">
                                    <i class="fas fa-check-circle text-4xl text-green-600"></i>
                                </div>
                                <h4 class="text-lg font-semibold text-green-700 mb-2">Bill Punched</h4>
                                <p class="text-sm text-gray-600 mb-4">
                                    This order has been marked as bill punched.
                                </p>
                                <div class="w-full bg-green-50 p-3 rounded-lg">
                                    <p class="text-xs text-gray-600">
                                        <i class="far fa-clock mr-1"></i>
                                        <%= order.billPunchedAt ? new Date(order.billPunchedAt).toLocaleString() : 'Recently' %>
                                    </p>
                                </div>
                            <% } else { %>
                                <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mb-4">
                                    <i class="fas fa-clock text-4xl text-yellow-600"></i>
                                </div>
                                <h4 class="text-lg font-semibold text-yellow-700 mb-2">Bill Pending</h4>
                                <p class="text-sm text-gray-600 mb-4">
                                    This order hasn't been marked for billing yet.
                                </p>
                                <button onclick="markBillPunch()" 
                                    class="w-full bg-green-600 hover:bg-green-700 text-white py-3 px-4 rounded-lg font-medium transition flex items-center justify-center">
                                    <i class="fas fa-receipt mr-2"></i>
                                    Mark Bill Punch
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Order Timeline -->
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-history text-green-600 mr-2"></i>
                            Order Timeline
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="timeline relative pl-8">
                            <!-- Created -->
                            <div class="timeline-item relative mb-6">
                                <div class="absolute -left-7 top-1 w-3 h-3 bg-green-500 rounded-full border-2 border-white shadow"></div>
                                <div class="timeline-content">
                                    <p class="text-xs text-gray-500">
                                        <%= new Date(order.createdAt).toLocaleString('en-IN', { 
                                            day: '2-digit', month: 'short', year: 'numeric',
                                            hour: '2-digit', minute: '2-digit'
                                        }) %>
                                    </p>
                                    <p class="text-sm font-medium text-gray-900">Order Created</p>
                                    <p class="text-xs text-gray-600">by <%= order.salesPerson.name %></p>
                                </div>
                            </div>

                            <!-- Approved -->
                            <% if (order.approvedAt) { %>
                            <div class="timeline-item relative mb-6">
                                <div class="absolute -left-7 top-1 w-3 h-3 bg-blue-500 rounded-full border-2 border-white shadow"></div>
                                <div class="timeline-content">
                                    <p class="text-xs text-gray-500">
                                        <%= new Date(order.approvedAt).toLocaleString('en-IN', { 
                                            day: '2-digit', month: 'short', year: 'numeric',
                                            hour: '2-digit', minute: '2-digit'
                                        }) %>
                                    </p>
                                    <p class="text-sm font-medium text-gray-900">Order Approved</p>
                                </div>
                            </div>
                            <% } %>

                            <!-- Dispatched -->
                            <% if (order.dispatchedAt) { %>
                            <div class="timeline-item relative mb-6">
                                <div class="absolute -left-7 top-1 w-3 h-3 bg-yellow-500 rounded-full border-2 border-white shadow"></div>
                                <div class="timeline-content">
                                    <p class="text-xs text-gray-500">
                                        <%= new Date(order.dispatchedAt).toLocaleString('en-IN', { 
                                            day: '2-digit', month: 'short', year: 'numeric',
                                            hour: '2-digit', minute: '2-digit'
                                        }) %>
                                    </p>
                                    <p class="text-sm font-medium text-gray-900">Order Dispatched</p>
                                    <% if (order.trackingId) { %>
                                        <p class="text-xs text-gray-600 mt-1">
                                            <i class="fas fa-box mr-1"></i> <%= order.trackingId %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                            <% } %>

                            <!-- Delivered -->
                            <% if (order.deliveredAt) { %>
                            <div class="timeline-item relative mb-6">
                                <div class="absolute -left-7 top-1 w-3 h-3 bg-green-600 rounded-full border-2 border-white shadow"></div>
                                <div class="timeline-content">
                                    <p class="text-xs text-gray-500">
                                        <%= new Date(order.deliveredAt).toLocaleString('en-IN', { 
                                            day: '2-digit', month: 'short', year: 'numeric',
                                            hour: '2-digit', minute: '2-digit'
                                        }) %>
                                    </p>
                                    <p class="text-sm font-medium text-gray-900">Order Delivered</p>
                                </div>
                            </div>
                            <% } %>

                            <!-- Bill Punched -->
                            <% if (order.billPunchedAt) { %>
                            <div class="timeline-item relative">
                                <div class="absolute -left-7 top-1 w-3 h-3 bg-purple-500 rounded-full border-2 border-white shadow"></div>
                                <div class="timeline-content">
                                    <p class="text-xs text-gray-500">
                                        <%= new Date(order.billPunchedAt).toLocaleString('en-IN', { 
                                            day: '2-digit', month: 'short', year: 'numeric',
                                            hour: '2-digit', minute: '2-digit'
                                        }) %>
                                    </p>
                                    <p class="text-sm font-medium text-gray-900">Bill Punched</p>
                                    <p class="text-xs text-gray-600">by Account Team</p>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Documents -->
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-file-alt text-green-600 mr-2"></i>
                            Documents
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-2 gap-3">
                            <!-- PI Document -->
                            <% if (order.piDocument?.original) { %>
                            <a href="/api/file/files/<%= order.piDocument.original %>?bucket=piDocuments" 
                               target="_blank" 
                               class="document-card">
                                <i class="fas fa-file-pdf text-red-500 text-2xl mb-2"></i>
                                <span class="text-xs font-medium text-gray-700">PI Document</span>
                                <span class="text-xs text-gray-500 mt-1">Click to view</span>
                            </a>
                            <% } else { %>
                            <div class="document-card opacity-50 cursor-not-allowed">
                                <i class="fas fa-file text-gray-400 text-2xl mb-2"></i>
                                <span class="text-xs font-medium text-gray-500">PI Document</span>
                                <span class="text-xs text-gray-400">Not uploaded</span>
                            </div>
                            <% } %>

                            <!-- Invoice Document (if available) -->
                            <% if (order.invoiceDocument) { %>
                            <a href="/api/file/files/<%= order.invoiceDocument %>" 
                               target="_blank" 
                               class="document-card">
                                <i class="fas fa-file-invoice text-green-500 text-2xl mb-2"></i>
                                <span class="text-xs font-medium text-gray-700">Invoice</span>
                                <span class="text-xs text-gray-500 mt-1">Click to view</span>
                            </a>
                            <% } else { %>
                            <div class="document-card opacity-50 cursor-not-allowed">
                                <i class="fas fa-file-invoice text-gray-400 text-2xl mb-2"></i>
                                <span class="text-xs font-medium text-gray-500">Invoice</span>
                                <span class="text-xs text-gray-400">Not generated</span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Tracking Information -->
                <% if (order.trackingId) { %>
                <div class="info-card">
                    <div class="info-header">
                        <h3 class="font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-map-marker-alt text-green-600 mr-2"></i>
                            Tracking Information
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="bg-blue-50 rounded-lg p-4">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-sm text-gray-600">Tracking ID:</span>
                                <span class="text-sm font-mono font-semibold text-blue-700"><%= order.trackingId %></span>
                            </div>
                            <% if (order.dispatchedAt) { %>
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-gray-600">Dispatched on:</span>
                                <span class="font-medium"><%= new Date(order.dispatchedAt).toLocaleDateString('en-IN') %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Bill Punch Confirmation Modal -->
    <div id="billPunchModal" class="fixed inset-0 bg-gray-900/50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-xl max-w-md w-full mx-4 shadow-2xl transform transition-all">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-receipt text-green-600 mr-2"></i>
                        Confirm Bill Punch
                    </h3>
                    <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <p class="text-sm text-gray-600 mb-4">
                    Are you sure you want to mark order <strong class="text-gray-900">#<%= order.invoiceNo %></strong> as bill punched?
                </p>

                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-4">
                    <div class="flex items-start">
                        <i class="fas fa-info-circle text-yellow-600 mt-0.5 mr-2"></i>
                        <p class="text-xs text-yellow-700">
                            This action will mark the order as billed. This cannot be undone without admin approval.
                        </p>
                    </div>
                </div>

                <div class="flex space-x-3">
                    <button onclick="closeModal()" 
                        class="flex-1 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium transition">
                        Cancel
                    </button>
                    <button onclick="confirmBillPunch()" 
                        class="flex-1 px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium transition flex items-center justify-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        Confirm Bill Punch
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Mark bill punch function
        function markBillPunch() {
            document.getElementById('billPunchModal').classList.remove('hidden');
            document.getElementById('billPunchModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('billPunchModal').classList.add('hidden');
            document.getElementById('billPunchModal').classList.remove('flex');
        }

        // Confirm bill punch
        async function confirmBillPunch() {
            try {
                const response = await fetch(`/api/account/orders/<%= order._id %>/billpunch`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ 
                        billPunch: true,
                        billPunchedAt: new Date()
                    })
                });

                if (response.ok) {
                    closeModal();
                    // Show success message
                    alert('Bill punch marked successfully!');
                    // Reload to show updated status
                    location.reload();
                } else {
                    const error = await response.json();
                    alert('Error: ' + (error.error || 'Failed to mark bill punch'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error marking bill punch. Please try again.');
            }
        }

        // Close modal when clicking outside
        document.getElementById('billPunchModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Handle ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });
    </script>
</body>
</html>